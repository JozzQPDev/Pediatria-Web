---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import { blogPosts, getPostBySlug, getRelatedPosts } from "../../data/blogPosts";

// Generate static paths for all blog posts
export function getStaticPaths() {
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

// Handle case when post is not found
if (!post) {
  return Astro.redirect('/blogs');
}

// Get related posts
const relatedPosts = getRelatedPosts(post.slug, 3);
---

<Layout 
  title={`${post.title} | Blog`}
  description={post.excerpt}
>

  <Hero
    title={post.title}
    subtitle={post.excerpt}
    backgroundImage={post.image}
    sideImage={post.image}
  />

  <!-- Article Content -->
  <article class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4">
      <!-- Article Meta -->
      <div class="flex flex-wrap items-center gap-6 mb-8 pb-8 border-b border-gray-100 reveal">
        <div class="flex items-center gap-3">
          <img 
            src={post.authorImage} 
            alt={post.author}
            class="w-14 h-14 rounded-full object-cover ring-4 ring-pink-100"
          />
          <div>
            <p class="font-bold text-gray-900">{post.author}</p>
            <p class="text-sm text-gray-500">Especialista Médico</p>
          </div>
        </div>
        
        <div class="flex items-center gap-4 text-sm text-gray-500 ml-auto">
          <span class="flex items-center gap-2 bg-gray-100 px-3 py-1 rounded-full">
            <i data-lucide="calendar" class="w-4 h-4"></i>
            {new Date(post.date).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
          </span>
          <span class="flex items-center gap-2 bg-gray-100 px-3 py-1 rounded-full">
            <i data-lucide="clock" class="w-4 h-4"></i>
            {post.readTime} de lectura
          </span>
        </div>
      </div>

      <!-- Category Badge -->
      <div class="mb-8 reveal">
        <span class="inline-block bg-pink-500 text-white px-4 py-2 rounded-full text-sm font-bold uppercase tracking-wider">
          {post.category}
        </span>
      </div>

      <!-- Article Image -->
      <div class="relative overflow-hidden rounded-3xl shadow-2xl mb-12 reveal hover-lift">
        <img 
          src={post.image} 
          alt={post.title}
          class="w-full h-96 object-cover"
        />
      </div>

      <!-- Article Body -->
      <div class="prose prose-lg max-w-none reveal" set:html={post.content} />

      <!-- Tags -->
      <div class="mt-12 pt-8 border-t border-gray-100 reveal">
        <h4 class="text-lg font-bold text-gray-900 mb-4">Etiquetas:</h4>
        <div class="flex flex-wrap gap-2">
          {post.tags.map(tag => (
            <a 
              href={`/blogs?tag=${tag}`}
              class="px-4 py-2 bg-gray-100 text-gray-600 rounded-full text-sm font-medium hover:bg-pink-500 hover:text-white transition-all"
            >
              #{tag}
            </a>
          ))}
        </div>
      </div>

      <!-- Share Buttons -->
      <div class="mt-8 pt-8 border-t border-gray-100 reveal">
        <h4 class="text-lg font-bold text-gray-900 mb-4">Compartir:</h4>
        <div class="flex gap-4">
          <a 
            href={`https://www.facebook.com/sharer/sharer.php?u=${Astro.url}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-12 h-12 bg-blue-600 text-white rounded-full flex items-center justify-center hover:bg-blue-700 hover:scale-110 transition-all"
            aria-label="Compartir en Facebook"
          >
            <i data-lucide="facebook" class="w-5 h-5"></i>
          </a>
          <a 
            href={`https://twitter.com/intent/tweet?url=${Astro.url}&text=${post.title}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-12 h-12 bg-sky-500 text-white rounded-full flex items-center justify-center hover:bg-sky-600 hover:scale-110 transition-all"
            aria-label="Compartir en Twitter"
          >
            <i data-lucide="twitter" class="w-5 h-5"></i>
          </a>
          <a 
            href={`https://wa.me/?text=${encodeURIComponent(post.title + ' ' + Astro.url)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-12 h-12 bg-green-500 text-white rounded-full flex items-center justify-center hover:bg-green-600 hover:scale-110 transition-all"
            aria-label="Compartir en WhatsApp"
          >
             <i class="bi bi-whatsapp text-lg" aria-hidden="true"></i>
          </a>
          <button 
            onclick="navigator.clipboard.writeText(window.location.href); alert('¡Enlace copiado al portapapeles!');"
            class="w-12 h-12 bg-gray-600 text-white rounded-full flex items-center justify-center hover:bg-gray-700 hover:scale-110 transition-all"
            aria-label="Copiar enlace"
          >
            <i data-lucide="link" class="w-5 h-5"></i>
          </button>
        </div>
      </div>
    </div>
  </article>

  <!-- Author Box -->
  <section class="py-12 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4">
      <div class="bg-white rounded-3xl shadow-lg p-8 reveal hover-lift">
        <div class="flex flex-col md:flex-row items-center gap-6">
          <img 
            src={post.authorImage} 
            alt={post.author}
            class="w-24 h-24 rounded-full object-cover ring-4 ring-pink-100"
          />
          <div class="text-center md:text-left">
            <h3 class="text-xl font-bold text-gray-900 mb-2">Escrito por {post.author}</h3>
            <p class="text-gray-600 mb-4">
              Especialista médico con amplia experiencia en pediatría. Comprometido con brindar información de calidad para el cuidado de la salud infantil.
            </p>
            <a 
              href="/equipo"
              class="inline-flex items-center gap-2 text-pink-500 font-bold hover:text-pink-600 transition-colors"
            >
              Conoce a nuestro equipo
              <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Posts -->
  {relatedPosts.length > 0 && (
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12 reveal">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Artículos Relacionados</h2>
          <p class="text-gray-600">Descubre más contenido que podría interesarte</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {relatedPosts.map((relatedPost, index) => (
            <article class="group bg-white rounded-3xl shadow-lg hover:shadow-2xl transition-all duration-500 overflow-hidden reveal hover-lift stagger-${index + 1}">
              <div class="relative overflow-hidden h-48">
                <img 
                  src={relatedPost.image} 
                  alt={relatedPost.title}
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                />
                <div class="absolute top-4 left-4">
                  <span class="bg-white/90 backdrop-blur-sm text-pink-600 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">
                    {relatedPost.category}
                  </span>
                </div>
              </div>
              
              <div class="p-6">
                <div class="flex items-center gap-3 text-xs text-gray-500 mb-3">
                  <span class="flex items-center gap-1">
                    <i data-lucide="calendar" class="w-3 h-3"></i>
                    {new Date(relatedPost.date).toLocaleDateString('es-ES', { month: 'short', day: 'numeric' })}
                  </span>
                  <span class="flex items-center gap-1">
                    <i data-lucide="clock" class="w-3 h-3"></i>
                    {relatedPost.readTime}
                  </span>
                </div>
                
                <h3 class="text-lg font-bold text-gray-900 mb-3 line-clamp-2 group-hover:text-pink-500 transition-colors">
                  {relatedPost.title}
                </h3>
                
                <a 
                  href={`/blog/${relatedPost.slug}`}
                  class="text-pink-500 font-bold text-sm hover:text-pink-600 transition-colors flex items-center gap-1 group/link"
                >
                  Leer más
                  <i data-lucide="arrow-right" class="w-4 h-4 group-hover/link:translate-x-1 transition-transform"></i>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA Section -->
  <section class="py-16 bg-linear-to-br from-pink-500 to-purple-600 text-white">

    <div class="max-w-4xl mx-auto px-4 text-center reveal">
      <h2 class="text-3xl lg:text-4xl font-bold mb-4">
        ¿Necesitas más información?
      </h2>
      <p class="text-white/90 text-lg mb-8 max-w-2xl mx-auto">
        Nuestros especialistas están disponibles para resolver todas tus dudas sobre la salud de tus hijos.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="/contacto"
          class="px-8 py-4 bg-white text-pink-600 font-bold rounded-2xl hover:bg-gray-100 hover:scale-105 transition-all shadow-lg"
        >
          Contactar Especialista
        </a>
        <a 
          href="/blog"
          class="px-8 py-4 bg-white/20 backdrop-blur-md text-white font-bold rounded-2xl hover:bg-white/30 transition-all border border-white/30"
        >
          Ver más artículos
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Intersection Observer for scroll-triggered animations
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.1
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('active');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  // Observe all elements with reveal classes
  document.addEventListener('DOMContentLoaded', () => {
    const revealElements = document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale');
    revealElements.forEach(el => observer.observe(el));
  });
</script>

<style is:global>
  @reference "tailwindcss";

  .prose h2 {
    @apply text-2xl font-bold text-gray-900 mt-8 mb-4;
  }
  
  .prose h3 {
    @apply text-xl font-bold text-gray-900 mt-6 mb-3;
  }
  
  .prose p {
    @apply text-gray-600 leading-relaxed mb-4;
  }
  
  .prose ul {
    @apply list-disc list-inside space-y-2 mb-6 text-gray-600;
  }
  
  .prose li {
    @apply ml-4;
  }
  
  .prose strong {
    @apply text-gray-900 font-bold;
  }
</style>
