---
// Página de búsqueda mejorada - Muestra resultados de búsqueda del sitio
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import SearchFilters from "../components/SearchFilters.jsx";
import VoiceSearch from "../components/VoiceSearch.jsx";


import { searchContent, getSearchCategories, searchData, advancedSearch } from "../data/searchData.js";

// Obtener parámetros de la URL
const url = new URL(Astro.request.url);
const query = url.searchParams.get('q') || '';
const typeFilter = url.searchParams.get('type') || '';
const categoryFilter = url.searchParams.get('category') || '';
const sortBy = url.searchParams.get('sort') || 'relevance';
const dateFrom = url.searchParams.get('dateFrom') || '';
const dateTo = url.searchParams.get('dateTo') || '';
const isAdvanced = url.searchParams.get('advanced') === 'true';
const currentPage = parseInt(url.searchParams.get('page') || '1', 10);
const viewMode = url.searchParams.get('view') || 'list'; // 'list' or 'grid'
const itemsPerPage = 12;

// Realizar búsqueda con filtros
const searchOptions = {
  limit: 100, // Get more for pagination
  fuzzy: true,
  sortBy: sortBy,
  filters: {
    ...(typeFilter && { type: typeFilter }),
    ...(categoryFilter && { category: categoryFilter }),
    ...(dateFrom && { dateFrom }),
    ...(dateTo && { dateTo })
  }
};

// Use advanced search if requested
let allResults = [];
try {
  if (isAdvanced && query) {
    allResults = advancedSearch(query, searchOptions);
  } else if (query) {
    allResults = searchContent(query, searchOptions);
  }
} catch (error) {
  console.error('Search error:', error);
  allResults = [];
}

const totalResults = allResults.length;
const totalPages = Math.ceil(totalResults / itemsPerPage);

// Paginate results
const startIndex = (currentPage - 1) * itemsPerPage;
const results = allResults.slice(startIndex, startIndex + itemsPerPage);

// Generate pagination URLs
const buildPageUrl = (page: number) => {
  const params = new URLSearchParams(url.searchParams);
  params.set('page', page.toString());
  return `?${params.toString()}`;
};

// Obtener categorías disponibles para filtros
const allCategories: string[] = getSearchCategories().filter((cat: string) => 
  !['page', 'service', 'blog'].includes(cat)
);

// Iconos temáticos FA6 Pro
const typeIcons: Record<string, string> = {
  page: 'fa-file-lines',
  service: 'fa-stethoscope',
  blog: 'fa-book-medical'
};

const typeLabels: Record<string, string> = {
  page: 'Página',
  service: 'Especialidad',
  blog: 'Artículo de Salud'
};

// Colores para cada tipo
const typeColors: Record<string, { bg: string; text: string; border: string; badge: string; gradient: string }> = {
  page: { 
    bg: 'bg-blue-50', 
    text: 'text-blue-600', 
    border: 'border-blue-200', 
    badge: 'bg-blue-100 text-blue-700',
    gradient: 'from-blue-500 to-blue-600'
  },
  service: { 
    bg: 'bg-green-50', 
    text: 'text-green-600', 
    border: 'border-green-200', 
    badge: 'bg-green-100 text-green-700',
    gradient: 'from-green-500 to-green-600'
  },
  blog: { 
    bg: 'bg-purple-50', 
    text: 'text-purple-600', 
    border: 'border-purple-200', 
    badge: 'bg-purple-100 text-purple-700',
    gradient: 'from-purple-500 to-purple-600'
  }
};

// Función para obtener imagen según el tipo y slug
function getResultImage(result: any): string {
  if (result.type === 'service') {
    const serviceImages: Record<string, string> = {
      'control-crecimiento': '/images/service-growth.jpg',
      'vacunacion-integral': '/images/service-vaccine.jpg',
      'nutricion-infantil': '/images/service-nutrition.jpg',
      'atencion-recien-nacidos': '/images/service-newborn.jpg',
      'psicologia-infantil': '/images/service-psychology.jpg',
      'nebulizaciones': '/images/service-nebulization.jpg'
    };
    return serviceImages[result.slug] || '/images/clinic-1.jpg';
  }
  
  if (result.type === 'blog') {
    const blogImages: Record<string, string> = {
      'importancia-vacunacion-infantil': '/images/service-vaccine.jpg',
      'alimentacion-complementaria': '/images/service-nutrition.jpg',
      'desarrollo-psicomotor': '/images/service-growth.jpg',
      'cuidado-recien-nacido': '/images/service-newborn.jpg',
      'salud-emocional-infantil': '/images/service-psychology.jpg',
      'prevencion-respiratoria': '/images/service-nebulization.jpg',
      'alergias-infantiles': '/images/service-vaccine.jpg'
    };
    return blogImages[result.slug] || '/images/clinic-1.jpg';
  }
  
  return '/images/clinica-home.jpg';
}

// Sugerencias de búsqueda populares
const popularSearches = ['vacunación', 'nutrición', 'desarrollo', 'recién nacido', 'control', 'psicología'];

// Pagination helper functions
const getVisiblePages = (current: number, total: number) => {

  const delta = 2;
  const range = [];
  const rangeWithDots = [];
  let l;

  for (let i = 1; i <= total; i++) {
    if (i === 1 || i === total || (i >= current - delta && i <= current + delta)) {
      range.push(i);
    }
  }

  for (let i of range) {
    if (l) {
      if (i - l === 2) {
        rangeWithDots.push(l + 1);
      } else if (i - l !== 1) {
        rangeWithDots.push('...');
      }
    }
    rangeWithDots.push(i);
    l = i;
  }

  return rangeWithDots;
};

const visiblePages = getVisiblePages(currentPage, totalPages);

---

<Layout title={query ? `Resultados para "${query}" | Clínica Pediátrica` : "Búsqueda | Clínica Pediátrica"}>
  <main class="main-section min-h-screen from-gray-50 via-white to-pink-50/30 py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <!-- Decorative elements -->
  <span class="cloud cloud--1" aria-hidden="true"></span>
  <span class="cloud cloud--2" aria-hidden="true"></span>
  <span class="cloud cloud--3" aria-hidden="true"></span>
  <span class="cloud cloud--4" aria-hidden="true"></span>
  <span class="cloud cloud--5" aria-hidden="true"></span>
  <span class="cloud cloud--6" aria-hidden="true"></span>
  <span class="cloud cloud--7" aria-hidden="true"></span>
  <span class="cloud cloud--8" aria-hidden="true"></span>
  <span class="cloud cloud--9" aria-hidden="true"></span>
  <span class="cloud cloud--10" aria-hidden="true"></span>
  <span class="cloud cloud--11" aria-hidden="true"></span>
  <span class="cloud cloud--12" aria-hidden="true"></span>

    <div class="max-w-400 mx-auto relative z-10">
      <!-- Header de Búsqueda -->
      <div class="text-center mb-10">
        <div data-aos="fade-down">
          <span class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-white text-slate-500 font-bold uppercase tracking-[0.2em] text-[10px] border border-slate-100 shadow-sm mb-6">
            <span class="flex gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-pink-400"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
            </span>
              Búsqueda inteligente
            </span>
        </div>
        
        <h2 
          class="text-5xl lg:text-7xl font-black text-slate-900 leading-[1.1] tracking-tight" 
          data-aos="fade-up"
        >
          {query ? (
            <>
              Resultados para <br/>
              <span class="text-transparent bg-clip-text bg-linear-to-r from-pink-500 via-orange-400 to-blue-600 italic font-serif">
                "{query}"
              </span>
            </>
          ) : (
            <>
              ¿Qué estás <br/>
              <span class="text-transparent bg-clip-text bg-linear-to-r from-pink-500 via-orange-400 to-blue-600 italic font-serif">
                buscando hoy?
              </span>
            </>
          )}
        </h2>

        <p class="text-lg text-gray-600 my-8 max-w-2xl mx-auto">
          {query 
            ? `Encontramos ${totalResults} resultado${totalResults !== 1 ? 's' : ''} para tu búsqueda` 
            : 'Encuentra servicios, artículos y información sobre la salud de tus hijos'}
        </p>
       </div>
       
       <div class="text-center mb-10 md:mb-16 px-4">
        <form id="busqueda-form" action="/busqueda" method="GET" class="max-w-2xl mx-auto relative group">

          <div class="relative flex items-center p-1 bg-white rounded-3xl md:rounded-4xl shadow-[0_20px_50px_rgba(0,0,0,0.04)] border border-slate-100 group-focus-within:ring-2 group-focus-within:ring-pink-100 group-focus-within:border-pink-200 transition-all duration-500">
  
            <div class="absolute left-4 md:left-6 text-slate-400 group-focus-within:text-pink-500 group-focus-within:scale-110 transition-all duration-300">
              <i class="fa-solid fa-magnifying-glass text-lg md:text-xl"></i>
            </div>

            <input 
              type="text" 
              name="q" 
              placeholder="Buscar..."
              class="w-full pl-12 md:pl-16 pr-24 md:pr-44 py-3.5 md:py-5 rounded-2xl md:rounded-[1.75rem] border-none focus:ring-0 text-slate-700 text-base md:text-lg placeholder:text-slate-400 bg-transparent font-medium"
              autocomplete="off"
              id="main-search-input"
            />

            <VoiceSearch 
              client:load 
              inputId="main-search-input" 
              formId="busqueda-form" 
              className="absolute right-14 md:right-40 z-10" 
              onResult={() => {}} 
              onError={() => {}} 
              alwaysVisible={true} 
            />

            <button 
              type="submit"
              class="absolute right-1.5 md:right-2.5 bg-linear-to-r from-pink-500 via-pink-600 to-orange-400 text-white p-3 md:px-8 md:py-3.5 rounded-xl md:rounded-[1.25rem] font-bold tracking-wide transition-all duration-300 shadow-lg shadow-pink-500/20 hover:shadow-pink-500/40 hover:-translate-y-0.5 active:scale-95 cursor-pointer flex items-center justify-center gap-2"
            >
              <span class="hidden md:inline">Buscar</span>
              <i class="fa-solid fa-arrow-right text-xs md:opacity-70 group-hover:translate-x-1 transition-transform"></i>
            </button>
          </div>
          
          {!query && (
            <div class="mt-6 md:mt-8 flex flex-wrap justify-center items-center gap-2 md:gap-3" data-aos="fade-up" data-aos-delay="100">
              <span class="flex items-center gap-2 text-[9px] md:text-[10px] font-black uppercase tracking-[0.15em] text-slate-400 bg-slate-50 px-2.5 py-1 rounded-md">
                <i class="fa-solid fa-fire text-orange-400"></i> Tendencias
              </span>
              {popularSearches.map((term) => (
                <a 
                  href={`/busqueda?q=${encodeURIComponent(term)}`}
                  class="group/tag relative text-xs md:text-sm px-4 py-1.5 md:px-5 md:py-2 bg-white text-slate-600 hover:text-pink-600 rounded-full border border-slate-200 hover:border-pink-200 transition-all duration-300 hover:shadow-[0_10px_20px_rgba(236,72,153,0.06)] font-medium overflow-hidden"
                >
                  <span class="relative z-10">{term}</span>
                  <div class="absolute inset-0 bg-linear-to-r from-pink-50/0 to-orange-50/50 opacity-0 group-hover/tag:opacity-100 transition-opacity"></div>
                </a>
              ))}
            </div>
          )}
        </form>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-2 mt-10">
        <aside class="lg:col-span-3 sticky top-24 space-y-6 order-2 lg:order-1">

        {query && (
          <div class="bg-white rounded-4xl border border-slate-100 shadow-[0_10px_40px_rgba(0,0,0,0.02)] p-2">
            <div class="px-6 pt-6 pb-2 flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-pink-50 flex items-center justify-center">
                <i class="fa-solid fa-filter text-pink-500 text-xs"></i>
              </div>
              <h2 class="font-black text-slate-800 text-sm uppercase tracking-widest">Filtros</h2>
            </div>

            <SearchFilters 
              currentType={typeFilter}
              currentCategory={categoryFilter}
              currentSort={sortBy}
              currentDateFrom={dateFrom}
              currentDateTo={dateTo}
              availableCategories={allCategories as any}
              totalResults={totalResults}
              isLoading={false}
              client:load
            />
          </div>
        )}

        <div class="bg-linear-to-br from-slate-900 to-slate-800 rounded-4xl p-8 text-white relative overflow-hidden group shadow-xl shadow-slate-200">
          <div class="relative z-10">
            <h4 class="font-bold mb-2">¿Necesitas ayuda?</h4>
            <p class="text-slate-400 text-[11px] mb-4 leading-relaxed">
              Si no encuentras lo que buscas, nuestro equipo de soporte puede guiarte.
            </p>
            <a href="/contacto" class="text-xs font-black uppercase tracking-widest text-pink-400 hover:text-pink-300 flex items-center gap-2 transition-all group-hover:gap-3">
              Contactar <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </a>
          </div>
          <i class="fa-solid fa-circle-question absolute -bottom-4 -right-4 text-7xl text-white/5 opacity-20 group-hover:rotate-12 transition-transform duration-700"></i>
        </div>

      </aside>

      
      <!-- Resultados -->
     <section class="lg:col-span-9 order-1 lg:order-2 lg:ml-10 my-10 lg:my-1">
     {query && totalResults > 0 && (
        <div class="flex flex-col sm:flex-row items-center justify-between mb-8 px-2 gap-4">
          
          <div class="flex items-center gap-3">
            <div class="h-8 w-1 bg-linear-to-b from-pink-500 to-orange-400 rounded-full hidden sm:block"></div>
            <p class="text-slate-600 font-medium">
              Mostrando 
              <span class="text-slate-900 font-bold">{startIndex + 1}</span>
              <span class="text-slate-400 mx-1">-</span>
              <span class="text-slate-900 font-bold">{Math.min(startIndex + itemsPerPage, totalResults)}</span> 
              <span class="text-slate-500 font-normal ml-1">de {totalResults} resultados</span>
              
              {isAdvanced && (
                <span class="ml-3 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-600 border border-blue-100">
                  <i class="fa-solid fa-microchip mr-1.5"></i> Búsqueda Avanzada
                </span>
              )}
            </p>
          </div>
          
          <div class="flex items-center gap-4 bg-white/50 backdrop-blur-sm p-1.5 rounded-2xl border border-slate-100 shadow-sm">
            <span class="text-xs font-bold uppercase tracking-widest text-slate-400 ml-2">Vista</span>
            
            <div class="flex gap-1">
              <a 
                href={`?${new URLSearchParams({...Object.fromEntries(url.searchParams), view: 'list'})}`}
                class={`flex items-center justify-center w-10 h-10 rounded-xl transition-all duration-300 ${
                  viewMode === 'list' 
                  ? 'bg-linear-to-tr from-pink-500 to-pink-600 text-white shadow-md shadow-pink-200' 
                  : 'text-slate-400 hover:bg-slate-100 hover:text-slate-600'
                }`}
                aria-label="Vista de lista"
              >
                <i class="fa-solid fa-list-ul text-lg"></i>
              </a>

              <a 
                href={`?${new URLSearchParams({...Object.fromEntries(url.searchParams), view: 'grid'})}`}
                class={`flex items-center justify-center w-10 h-10 rounded-xl transition-all duration-300 ${
                  viewMode === 'grid' 
                  ? 'bg-linear-to-tr from-pink-500 to-pink-600 text-white shadow-md shadow-pink-200' 
                  : 'text-slate-400 hover:bg-slate-100 hover:text-slate-600'
                }`}
                aria-label="Vista de grid"
              >
                <i class="fa-solid fa-table-cells-large text-lg"></i>
              </a>
            </div>
          </div>
        </div>
      )}

      <!-- Resultados - List View -->
     {query && totalResults > 0 && viewMode === 'list' && (
        <div class="space-y-6">
          {results.map((result: any, index: number) => {
            const colors = typeColors[result.type];
            const image = getResultImage(result);
            const actualIndex = startIndex + index;
            
            return (
              <a 
                href={result.url}
                class="group block bg-white rounded-4xl p-5 sm:p-6 shadow-[0_10px_30px_rgba(0,0,0,0.03)] border border-slate-100 hover:shadow-[0_20px_40px_rgba(236,72,153,0.1)] hover:border-pink-100 transition-all duration-500 transform hover:-translate-y-1.5"
                style={`animation-delay: ${index * 50}ms`}
                data-result-index={actualIndex}
              >
                <div class="flex flex-col sm:flex-row gap-6">
                  <div class="sm:w-56 shrink-0">
                    <div class="relative aspect-16/10 sm:aspect-square rounded-3xl overflow-hidden bg-slate-50">
                      <img 
                        src={image} 
                        alt={result.title}
                        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                        loading="lazy"
                        decoding="async"
                      />
                      <div class={`absolute top-3 left-3 px-3 py-1.5 rounded-xl text-[10px] font-black uppercase tracking-wider ${colors.badge} backdrop-blur-md bg-opacity-80 shadow-sm flex items-center gap-2`}>
                        <i class={`fa-solid ${typeIcons[result.type]} text-[11px]`}></i>
                        {typeLabels[result.type]}
                      </div>
                    </div>
                  </div>

                  <div class="flex-1 min-w-0 flex flex-col py-1">
                    <div class="flex justify-between items-start gap-4 mb-3">
                      <h3 class="text-xl sm:text-2xl font-bold text-slate-800 group-hover:text-pink-600 transition-colors duration-300 leading-snug">
                        {(result as any).highlightedTitle ? (
                          <Fragment set:html={(result as any).highlightedTitle} />
                        ) : (
                          result.title
                        )}
                      </h3>
                      <div class={`shrink-0 w-12 h-12 rounded-2xl ${colors.bg} ${colors.text} flex items-center justify-center group-hover:rotate-12 transition-transform duration-500 shadow-sm`}>
                        <i class={`fa-solid ${typeIcons[result.type]} text-xl`}></i>
                      </div>
                    </div>
                    
                    <p class="text-slate-500 text-sm sm:text-base line-clamp-2 mb-4 leading-relaxed">
                      {(result as any).highlightedDescription ? (
                        <Fragment set:html={(result as any).highlightedDescription} />
                      ) : (
                        result.description
                      )}
                    </p>
                    
                    <div class="flex items-center justify-between mt-auto pt-4 border-t border-slate-50">
                      <div class="flex items-center gap-4">
                        {(result as any).category && (
                          <span class="flex items-center gap-2 text-xs font-semibold text-slate-400 bg-slate-50 px-3 py-1.5 rounded-lg border border-slate-100">
                            <i class="fa-solid fa-folder-open text-pink-400/70"></i>
                            {(result as any).category}
                          </span>
                        )}
                        {(result as any).relevanceScore && sortBy === 'relevance' && (
                          <span class="flex items-center gap-2 text-xs font-bold text-emerald-500">
                            <i class="fa-solid fa-circle-check"></i>
                            {Math.min(100, Math.round((result as any).relevanceScore / 2))}% coincidencia
                          </span>
                        )}
                      </div>
                      
                      <span class="flex items-center gap-2 text-pink-500 font-bold text-sm group-hover:gap-3 transition-all duration-300">
                        Leer más
                        <i class="fa-solid fa-chevron-right text-xs"></i>
                      </span>
                    </div>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )}

      <!-- Resultados - Grid View -->
     {query && totalResults > 0 && viewMode === 'grid' && (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {results.map((result: any, index: number) => {
            const colors = typeColors[result.type];
            const image = getResultImage(result);
            const actualIndex = startIndex + index;
            
            return (
              <a 
                href={result.url}
                class="group block bg-white rounded-[2.5rem] overflow-hidden shadow-[0_10px_30px_rgba(0,0,0,0.03)] border border-slate-100 hover:shadow-[0_20px_50px_rgba(236,72,153,0.12)] hover:border-pink-100 transition-all duration-500 transform hover:-translate-y-2"
                style={`animation-delay: ${index * 30}ms`}
                data-result-index={actualIndex}
              >
                <div class="relative aspect-4/3 overflow-hidden bg-slate-100">
                  <img 
                    src={image} 
                    alt={result.title}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                    loading="lazy"
                    decoding="async"
                  />
                  
                  <div class={`absolute top-4 left-4 px-3 py-1.5 rounded-xl text-[10px] font-black uppercase tracking-wider ${colors.badge} backdrop-blur-md bg-opacity-80 shadow-sm flex items-center gap-2`}>
                    <i class={`fa-solid ${typeIcons[result.type]} text-[11px]`}></i>
                    {typeLabels[result.type]}
                  </div>

                  <div class="absolute inset-0 bg-linear-to-t from-slate-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                </div>

                <div class="p-6 sm:p-8">
                  <h3 class="text-xl font-bold text-slate-800 group-hover:text-pink-600 transition-colors duration-300 line-clamp-2 mb-3 leading-tight">
                    {(result as any).highlightedTitle ? (
                      <Fragment set:html={(result as any).highlightedTitle} />
                    ) : (
                      result.title
                    )}
                  </h3>
                  
                  <p class="text-slate-500 text-sm line-clamp-3 mb-6 leading-relaxed">
                    {(result as any).highlightedDescription ? (
                      <Fragment set:html={(result as any).highlightedDescription} />
                    ) : (
                      result.description
                    )}
                  </p>
                  
                  <div class="flex items-center justify-between pt-5 border-t border-slate-50">
                    { (result as any).category && (
                      <span class="flex items-center gap-1.5 text-[11px] font-bold text-slate-400 uppercase tracking-tight">
                        <i class="fa-solid fa-tag text-pink-400/60"></i>
                        {(result as any).category}
                      </span>
                    )}
                    
                    <div class="flex items-center gap-2 text-pink-500 font-bold text-sm ml-auto group-hover:translate-x-1 transition-transform duration-300">
                      <span>Explorar</span>
                      <div class="w-7 h-7 rounded-full bg-pink-50 flex items-center justify-center group-hover:bg-pink-500 group-hover:text-white transition-colors duration-300">
                        <i class="fa-solid fa-chevron-right text-[10px]"></i>
                      </div>
                    </div>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )}

      <!-- Pagination -->
      {query && totalPages > 1 && (
        <nav class="mt-8 flex items-center justify-center gap-2" aria-label="Paginación de resultados">
          <!-- Previous Page -->
          {currentPage > 1 ? (
            <a 
              href={buildPageUrl(currentPage - 1)}
              class="group w-11 h-11 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-500 hover:bg-pink-50 hover:text-pink-600 hover:border-pink-200 transition-all duration-300 shadow-sm hover:shadow-md active:scale-90"
              aria-label="Página anterior"
            >
              <i class="fa-solid fa-chevron-left text-sm group-hover:-translate-x-0.5 transition-transform"></i>
            </a>
          ) : (
            <span class="w-11 h-11 flex items-center justify-center rounded-xl bg-slate-50 border border-slate-100 text-slate-300 cursor-not-allowed" aria-disabled="true">
              <i class="fa-solid fa-chevron-left text-sm"></i>
            </span>
          )}

          <!-- Page Numbers -->
          <div class="flex items-center gap-2 bg-white p-1.5 rounded-2xl border border-slate-100 shadow-sm">
            {visiblePages.map((page: number | string) => (
              page === '...' ? (
                <span class="px-3 py-2 text-slate-400 font-bold select-none">
                  <i class="fa-solid fa-ellipsis text-xs"></i>
                </span>
              ) : (
                <a
                  href={buildPageUrl(page as number)}
                  class={`min-w-11 h-10 flex items-center justify-center px-3 py-2 rounded-xl text-sm font-bold transition-all duration-300 ${
                    currentPage === page
                      ? 'bg-linear-to-tr from-pink-500 to-orange-400 text-white shadow-md shadow-pink-200 scale-105'
                      : 'bg-transparent text-slate-600 hover:bg-pink-50 hover:text-pink-600'
                  }`}
                  aria-label={`Página ${page}`}
                  aria-current={currentPage === page ? 'page' : undefined}
                >
                  {page}
                </a>
              )
            ))}
          </div>

          <!-- Next Page -->
         {currentPage < totalPages ? (
            <a 
              href={buildPageUrl(currentPage + 1)}
              class="group w-11 h-11 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-500 hover:bg-pink-50 hover:text-pink-600 hover:border-pink-200 transition-all duration-300 shadow-sm hover:shadow-md active:scale-90"
              aria-label="Página siguiente"
            >
              <i class="fa-solid fa-chevron-right text-sm group-hover:translate-x-0.5 transition-transform"></i>
            </a>
          ) : (
            <span class="w-11 h-11 flex items-center justify-center rounded-xl bg-slate-50 border border-slate-100 text-slate-300 cursor-not-allowed" aria-disabled="true">
              <i class="fa-solid fa-chevron-right text-sm"></i>
            </span>
          )}
        </nav>
      )}

      <!-- Pagination Info -->
      {query && totalPages > 1 && (
        <p class="text-center text-sm text-gray-500 mt-4">
          Página {currentPage} de {totalPages}
        </p>
      )}


      <!-- Estado vacío - Sin resultados -->
      {query && totalResults === 0 && (
        <div class="text-center py-20 px-4" data-aos="fade-up">
          <div class="w-40 h-40 mx-auto mb-10 relative">
            <div class="absolute inset-0 bg-linear-to-br from-slate-100 to-pink-50 rounded-full animate-pulse opacity-70"></div>
            <div class="absolute inset-4 bg-white rounded-full shadow-sm"></div>
            
            <div class="relative w-full h-full flex items-center justify-center">
              <i class="fa-solid fa-magnifying-glass-chart text-slate-300 text-6xl"></i>
            </div>
          </div>
          
          <h2 class="text-3xl font-black text-slate-800 mb-4 tracking-tight">
            ¿No encuentras lo que buscas?
          </h2>
          <p class="text-slate-500 max-w-md mx-auto mb-10 text-lg leading-relaxed">
            Lo sentimos, no encontramos resultados para 
            <span class="inline-block font-bold text-pink-600 bg-pink-50 px-3 py-0.5 rounded-lg">"{query}"</span>.
            <br/>
            {isAdvanced && <span class="block mt-3 text-sm font-medium text-slate-400 italic">Prueba simplificando los filtros de tu búsqueda avanzada.</span>}
          </p>
          
          {isAdvanced && (
            <div class="bg-indigo-50/50 rounded-4xl p-6 mb-10 max-w-lg mx-auto border border-indigo-100 backdrop-blur-sm">
              <h4 class="font-bold text-indigo-900 mb-4 text-sm flex items-center justify-center gap-2">
                <i class="fa-solid fa-code text-indigo-400"></i>
                Guía de Búsqueda Especializada
              </h4>
              <ul class="grid grid-cols-1 gap-2 text-xs text-indigo-700 text-left px-2">
                <li class="flex items-center gap-2 bg-white/60 p-2 rounded-xl">
                  <code class="bg-indigo-600 text-white px-2 py-0.5 rounded font-black tracking-tighter">AND</code> 
                  <span>Ambos términos deben aparecer</span>
                </li>
                <li class="flex items-center gap-2 bg-white/60 p-2 rounded-xl">
                  <code class="bg-indigo-600 text-white px-2 py-0.5 rounded font-black tracking-tighter">OR</code> 
                  <span>Al menos uno de los términos</span>
                </li>
                <li class="flex items-center gap-2 bg-white/60 p-2 rounded-xl">
                  <code class="bg-indigo-600 text-white px-2 py-0.5 rounded font-black tracking-tighter">NOT</code> 
                  <span>Excluye este término específico</span>
                </li>
                <li class="flex items-center gap-2 bg-white/60 p-2 rounded-xl">
                  <code class="bg-indigo-600 text-white px-2 py-0.5 rounded font-black tracking-tighter">" "</code> 
                  <span>Busca la frase exacta (ej: "medicina regenerativa")</span>
                </li>
              </ul>
            </div>
          )}
          
          <div class="bg-white rounded-[2.5rem] p-8 shadow-[0_15px_40px_rgba(0,0,0,0.03)] border border-slate-100 max-w-lg mx-auto">
            <h3 class="font-bold text-slate-800 mb-6 flex items-center justify-center gap-2">
              <i class="fa-solid fa-wand-magic-sparkles text-orange-400"></i>
              Temas recomendados para ti:
            </h3>
            <div class="flex flex-wrap justify-center gap-3">
              {popularSearches.map((suggestion) => (
                <a 
                  href={`/busqueda?q=${encodeURIComponent(suggestion)}`}
                  class="px-5 py-2.5 bg-slate-50 hover:bg-linear-to-r hover:from-pink-500 hover:to-orange-400 text-slate-600 hover:text-white rounded-2xl transition-all duration-300 border border-slate-100 hover:border-transparent font-semibold text-sm hover:shadow-lg hover:shadow-pink-500/25"
                >
                  {suggestion}
                </a>
              ))}
            </div>
          </div>
          
          <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-6">
            <a 
              href="/busqueda"
              class="group flex items-center gap-2 text-slate-400 hover:text-pink-600 font-bold transition-colors"
            >
              <i class="fa-solid fa-arrow-left-long group-hover:-translate-x-1 transition-transform"></i>
              Limpiar búsqueda
            </a>
            
            {!isAdvanced && (
              <a 
                href={`/busqueda?q=${encodeURIComponent(query)}&advanced=true`}
                class="flex items-center gap-2 bg-slate-900 text-white px-6 py-3 rounded-2xl hover:bg-pink-600 transition-all duration-300 shadow-xl shadow-slate-900/10 hover:shadow-pink-500/20 active:scale-95"
              >
                <i class="fa-solid fa-gears text-sm opacity-70"></i>
                Usar Búsqueda Avanzada
              </a>
            )}
          </div>
        </div>
      )}

      <!-- Error State -->
        {query && !results && (
        <div class="text-center py-24 px-4" data-aos="zoom-in">
          <div class="w-28 h-28 mx-auto mb-8 relative">
            <div class="absolute inset-0 bg-indigo-50 rounded-[2.5rem] rotate-6 animate-pulse"></div>
            <div class="absolute inset-0 bg-white rounded-[2.5rem] border-2 border-indigo-100 shadow-sm flex items-center justify-center">
              <i class="fa-solid fa-triangle-exclamation text-indigo-400 text-4xl"></i>
            </div>
          </div>

          <h2 class="text-2xl sm:text-3xl font-black text-slate-800 mb-4 tracking-tight">
            Algo no salió como esperábamos
          </h2>
          <p class="text-slate-500 max-w-md mx-auto mb-10 text-lg leading-relaxed">
            Hubo un inconveniente técnico al procesar tu búsqueda de 
            <span class="text-pink-500 font-bold">"{query}"</span>. 
            No te preocupes, el equipo de soporte ha sido notificado.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <button 
              onclick="window.location.reload()"
              class="group flex items-center gap-3 px-8 py-4 bg-linear-to-r from-pink-500 via-pink-600 to-orange-400 text-white 3xl font-bold shadow-xl shadow-pink-500/25 hover:shadow-pink-500/40 hover:-translate-y-1 transition-all duration-300 active:scale-95"
            >
              <i class="fa-solid fa-rotate-right group-hover:rotate-180 transition-transform duration-700"></i>
              <span>Intentar de nuevo</span>
            </button>

            <a 
              href="/contacto"
              class="px-8 py-4 bg-white text-slate-600 border border-slate-200 rounded-3xl font-bold hover:bg-slate-50 hover:text-slate-800 transition-all duration-300 shadow-sm"
            >
              Contactar soporte
            </a>
          </div>

          <p class="mt-12 text-xs text-slate-400 font-medium uppercase tracking-[0.2em] flex items-center justify-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            Dharma Bio - Estado de los servicios: Operativo
          </p>
        </div>
      )}

      </section> 
    </div>

      <!-- Estado inicial - Sin búsqueda -->
      {!query && (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12" data-aos="fade-up">
          
          <a 
            href="/servicios"
            class="group p-8 bg-white rounded-[2.5rem] border border-slate-100 hover:border-emerald-200 hover:shadow-[0_20px_50px_rgba(16,185,129,0.08)] transition-all duration-500 text-center relative overflow-hidden"
          >
            <div class="absolute inset-0 bg-linear-to-br from-emerald-50/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

            <div class="relative z-10">
              <div class="w-20 h-20 mx-auto mb-6 bg-linear-to-br from-emerald-400/10 to-emerald-400/20 rounded-3xl flex items-center justify-center text-emerald-600 group-hover:scale-110 group-hover:rotate-3 transition-transform duration-500 shadow-sm">
                <i class="fa-solid fa-stethoscope text-3xl"></i>
              </div>
              
              <h3 class="text-xl font-black text-slate-800 mb-3">Servicios Médicos</h3>
              <p class="text-sm text-slate-500 leading-relaxed px-2">
                Especialidades pediátricas y medicina regenerativa para el crecimiento sano de tus hijos.
              </p>
              
              <div class="mt-6 flex items-center justify-center gap-2 text-emerald-600 font-bold text-sm tracking-tight group-hover:gap-3 transition-all">
                <span>Explorar</span>
                <i class="fa-solid fa-chevron-right text-[10px]"></i>
              </div>
            </div>
          </a>
          
          <a 
            href="/blogs"
            class="group p-8 bg-white rounded-[2.5rem] border border-slate-100 hover:border-purple-200 hover:shadow-[0_20px_50px_rgba(168,85,247,0.08)] transition-all duration-500 text-center relative overflow-hidden"
          >
            <div class="absolute inset-0 bg-linear-to-br from-purple-50/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

            <div class="relative z-10">
              <div class="w-20 h-20 mx-auto mb-6 bg-linear-to-br from-purple-400/10 to-purple-400/20 rounded-3xl flex items-center justify-center text-purple-600 group-hover:scale-110 group-hover:-rotate-3 transition-transform duration-500 shadow-sm">
                <i class="fa-solid fa-book-medical text-3xl"></i>
              </div>
              
              <h3 class="text-xl font-black text-slate-800 mb-3">Blog de Bienestar</h3>
              <p class="text-sm text-slate-500 leading-relaxed px-2">
                Consejos de expertos sobre nutrición, desarrollo infantil y cuidados integrales.
              </p>
              
              <div class="mt-6 flex items-center justify-center gap-2 text-purple-600 font-bold text-sm tracking-tight group-hover:gap-3 transition-all">
                <span>Leer artículos</span>
                <i class="fa-solid fa-chevron-right text-[10px]"></i>
              </div>
            </div>
          </a>
          
          <a 
            href="/contacto"
            class="group p-8 bg-white rounded-[2.5rem] border border-slate-100 hover:border-pink-200 hover:shadow-[0_20px_50px_rgba(236,72,153,0.08)] transition-all duration-500 text-center relative overflow-hidden"
          >
            <div class="absolute inset-0 bg-linear-to-br from-pink-50/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

            <div class="relative z-10">
              <div class="w-20 h-20 mx-auto mb-6 bg-linear-to-br from-pink-400/10 to-pink-400/20 rounded-3xl flex items-center justify-center text-pink-600 group-hover:scale-110 transition-transform duration-500 shadow-sm">
                <i class="fa-solid fa-calendar-check text-3xl"></i>
              </div>
              
              <h3 class="text-xl font-black text-slate-800 mb-3">Atención Directa</h3>
              <p class="text-sm text-slate-500 leading-relaxed px-2">
                ¿Tienes dudas o deseas agendar una cita? Nuestro equipo está listo para ayudarte.
              </p>
              
              <div class="mt-6 flex items-center justify-center gap-2 text-pink-600 font-bold text-sm tracking-tight group-hover:gap-3 transition-all">
                <span>Escribirnos</span>
                <i class="fa-solid fa-chevron-right text-[10px]"></i>
              </div>
            </div>
          </a>
        </div>
      )}
      
    </div>
  </main>
</Layout>

<style>
  /* Suavizado de scroll para cuando los filtros se quedan sticky */
  aside {
    scrollbar-width: thin;
    scrollbar-color: #f1f5f9 transparent;
  }
</style>
