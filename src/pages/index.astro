---
// Tu código de importaciones permanece igual
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/siteConfig';
import Welcome from '../components/Welcome.astro';  // Corregido: 'Modal' a 'Welcome'

const quickServices = [
  { 
    title: "Control de Crecimiento", 
    icon: "baby", 
    desc: "Seguimiento especializado del desarrollo físico y motor de tu pequeño.", 
    image: "/images/service-growth.jpg",
    color: "bg-pink-500/20",          // icono
    hoverColor: "group-hover:bg-pink-500 group-hover:border-pink-400", // icono hover
    buttonColor: "bg-pink-600/80",    // botón
    buttonHover: "hover:bg-pink-600", // botón hover
    overlayColor: "from-pink-900/80 via-pink-900/40 to-transparent", // overlay
    cardColor: "bg-pink-50/10",       // fondo tarjeta
    cardHover: "hover:shadow-pink-400/50" // sombra hover tarjeta
  },
  { 
    title: "Vacunación Integral", 
    icon: "syringe", 
    desc: "Esquema completo de vacunas en un ambiente seguro y tranquilo.", 
    image: "/images/service-vaccine.jpg",
    color: "bg-yellow-500/20",
    hoverColor: "group-hover:bg-yellow-500 group-hover:border-yellow-400",
    buttonColor: "bg-yellow-600/80",
    buttonHover: "hover:bg-yellow-600",
    overlayColor: "from-yellow-900/80 via-yellow-900/40 to-transparent",
    cardColor: "bg-yellow-50/10",
    cardHover: "hover:shadow-yellow-400/50"
  },
  { 
    title: "Nutrición Infantil", 
    icon: "apple", 
    desc: "Especialistas en crear hábitos saludables desde la primera infancia.", 
    image: "/images/service-nutrition.jpg",
    color: "bg-green-500/20",
    hoverColor: "group-hover:bg-green-500 group-hover:border-green-400",
    buttonColor: "bg-green-600/80",
    buttonHover: "hover:bg-green-600",
    overlayColor: "from-green-900/80 via-green-900/40 to-transparent",
    cardColor: "bg-green-50/10",
    cardHover: "hover:shadow-green-400/50"
  },
  { 
    title: "Urgencias 24h", 
    icon: "ambulance", 
    desc: "Atención médica inmediata con protocolos de respuesta rápida.", 
    image: "/images/service-emergency.jpg",
    color: "bg-blue-500/20",
    hoverColor: "group-hover:bg-blue-500 group-hover:border-blue-400",
    buttonColor: "bg-blue-600/80",
    buttonHover: "hover:bg-blue-600",
    overlayColor: "from-blue-900/80 via-blue-900/40 to-transparent",
    cardColor: "bg-blue-50/10",
    cardHover: "hover:shadow-blue-400/50"
  }
];

const allBenefits = [
  { 
    id: 0,
    title: "Infraestructura diseñada", 
    subtitle: "para su bienestar",
    desc: [
      "Nuestra clínica ofrece un entorno seguro, cálido y acogedor, especialmente diseñado para el desarrollo integral de los niños desde sus primeros años.",
      "Contamos con instalaciones modernas equipadas con tecnología médica de vanguardia, consultorios pediátricos adaptados y áreas de espera amigables para reducir el estrés infantil.",
      "Cada espacio ha sido pensado para brindar comodidad tanto a los pacientes como a sus familias, promoviendo una experiencia tranquila y positiva.",
      "Aplicamos estrictos protocolos de bioseguridad, limpieza y control sanitario que garantizan una atención confiable, humana y de alta calidad en cada visita."
    ],
    image: "/images/clinica-home1.jpg" 
  },
  { 
    id: 1,
    title: "Infraestructura Moderna", 
    subtitle: "con tecnología avanzada",
    desc: [
      "Ambientes clínicos diseñados bajo estándares internacionales de bioseguridad, higiene y confort.",
      "Equipamiento médico moderno que permite diagnósticos precisos y tratamientos oportunos.",
      "Salas climatizadas, señalización clara y accesibilidad pensada para niños y padres.",
      "Mantenimiento constante y protocolos de limpieza permanente para la tranquilidad de su familia."
    ], 
    image: "/images/clinic-1.jpg" 
  },
  { 
    id: 2,
    title: "Especialistas Certificados", 
    subtitle: "atención confiable",
    desc: [
      "Staff médico conformado por pediatras certificados y especialistas en cuidado infantil.",
      "Alta formación académica respaldada por experiencia clínica y actualización constante.",
      "Enfoque humano y empático en cada consulta, priorizando el bienestar emocional del niño.",
      "Compromiso con una atención ética, profesional y personalizada para cada paciente."
    ], 
    image: "/images/benefit-certified.jpg" 
  },
  { 
    id: 3,
    title: "Gestión Digital", 
    subtitle: "trámites rápidos y fáciles",
    desc: [
      "Sistema de gestión digital que optimiza tiempos y mejora la experiencia del paciente.",
      "Historias clínicas electrónicas seguras y accesibles desde cualquier dispositivo.",
      "Agendamiento de citas en línea y seguimiento médico continuo.",
      "Acceso rápido a resultados, indicaciones y recomendaciones médicas desde tu celular."
    ], 
    image: "/images/value-innovation.jpg" 
  }
];


const testimonials = [
  { name: "María López", role: "Madre de Sofía (3 años)", quote: "La atención en la clínica es increíble. Mi hija se siente segura y los doctores son muy cariñosos.", image: "/images/testimonial-1.jpg" },
  { name: "Carlos Ramírez", role: "Padre de Mateo (1 año)", quote: "Recomiendo esta clínica por su tecnología y calidez. Siempre nos sentimos en familia.", image: "/images/testimonial-2.jpg" },
  { name: "Ana Torres", role: "Madre de Lucas (5 años)", quote: "El control de crecimiento de mi hijo ha sido perfecto. Profesionales de primera.", image: "/images/testimonial-3.jpg" }
];

const galleryImages = [
  "/images/clinic-1.jpg", "/images/clinic-2.jpg", "/images/clinic-3.jpg", "/images/clinic-4.jpg"
];
---

<Layout title={`Inicio | ${siteConfig.name}`}>
  <main class="overflow-hidden bg-white" >
    <!-- <Welcome />  --><!-- Removido client:load para evitar problemas de hidratación -->
    <!-- Hero con imagen de fondo: Cambié a un diseño más visual con overlay y CTA prominente -->
  <section id="hero-parallax" class="relative h-screen flex items-center justify-center overflow-hidden">
  <div id="parallax-bg" class="absolute inset-0 bg-cover bg-center scale-110" style="background-image: url('/images/hero-pediatric.jpg'); will-change: transform;"></div>
      
      <div class="relative z-10 text-center text-white px-4 max-w-4xl">
        <h1 class="text-5xl md:text-7xl font-bold italic tracking-tighter leading-none mb-6 animate-fade-in">
          Atención pediátrica <br/> <span class="text-yellow-300 not-italic">con corazón</span>
        </h1>
        <p class="text-xl md:text-2xl font-medium mb-10 text-green-100 animate-fade-in animation-delay-200">
          Brindamos soluciones médicas integrales para la salud de tus hijos en un entorno moderno y seguro. Tu tranquilidad es nuestro compromiso diario.
        </p>
        <div class="flex flex-col sm:flex-row gap-6 justify-center animate-fade-in animation-delay-400">
          <a href={siteConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="bg-white text-pink-600 px-10 py-5 rounded-2xl font-bold text-lg hover:shadow-xl hover:-translate-y-1 hover:scale-105 transition-all flex items-center justify-center gap-3 focus:ring-2 focus:ring-white" aria-label="Reservar cita por WhatsApp">
            <i class="bi bi-whatsapp text-xl" aria-hidden="true"></i> Reservar Cita
          </a>
          <a href="/nosotros" class="px-10 py-5 rounded-2xl font-bold text-lg border-2 border-white/30 hover:bg-white/10 hover:scale-105 transition-all flex items-center justify-center gap-3 focus:ring-2 focus:ring-white" aria-label="Conoce más sobre nosotros">
            <i data-lucide="info" class="w-5 h-5" aria-hidden="true"></i> Conócenos
          </a>
        </div>
      </div>
      <!-- Elementos decorativos infantiles -->
      <div class="absolute bottom-10 left-10 animate-bounce-soft">
        <i data-lucide="heart" class="w-12 h-12 text-yellow-300" aria-hidden="true"></i>
      </div>
      <div class="absolute top-20 right-20 animate-bounce-soft animation-delay-500">
        <i data-lucide="star" class="w-10 h-10 text-yellow-300" aria-hidden="true"></i>
      </div>
    </section>

   <!-- Sección de servicios: Grid con imágenes y overlays -->
<section class="cloud-section relative overflow-hidden py-16 md:py-32 px-4 bg-white">
  <!-- Este contenedor va encima de las nubes -->
  <div class="max-w-7xl mx-auto relative z-10">

    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 md:mb-20 gap-8">
      <div class="max-w-2xl">
        <h2 class="text-3xl md:text-4xl lg:text-6xl font-extrabold text-gray-900 leading-tight">
          Cuidado Integral <br />
          <span class="bg-clip-text text-green-400 italic">Pediátrico</span>
        </h2>
      </div>

      <p class="text-gray-500 max-w-sm font-medium leading-relaxed text-sm md:text-base">
        Especialidades médicas diseñadas para acompañar cada etapa del crecimiento de tus hijos.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-12">
      {quickServices.map((service, index) => (
        <div
          class={`group relative min-h-115 md:h-100 overflow-hidden rounded-[2.5rem] shadow-2xl transition-all duration-700 hover:-translate-y-4 ${
            index % 2 !== 0 ? "lg:mt-8" : ""
          } ${service.cardColor} ${service.cardHover}`}
          role="article"
        >
          <img
            src={service.image}
            alt={service.title}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
          />

          <div class="absolute inset-0 bg-linear-to-t from-gray-900 via-gray-900/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity duration-500"></div>

          <div class="absolute inset-0 p-6 md:p-8 flex flex-col justify-end transform transition-transform duration-500">
            <div
              class={`w-12 h-12 md:w-16 md:h-16 ${service.color} backdrop-blur-md rounded-2xl flex items-center justify-center text-white mb-4 md:mb-6 border border-white/30 ${service.hoverColor} transition-all duration-500 shadow-xl`}
            >
              <i data-lucide={service.icon} class="w-6 h-6 md:w-8 md:h-8 group-hover:animate-pulse" aria-hidden="true"></i>
            </div>

            <h3 class="text-xl md:text-2xl font-bold text-white mb-3 tracking-tight">
              {service.title}
            </h3>

            <p class="text-gray-200 text-sm leading-relaxed mb-4 md:mb-6 opacity-100 md:opacity-0 group-hover:opacity-100 transition-all duration-500 translate-y-0 md:translate-y-4 group-hover:translate-y-0">
              {service.desc}
            </p>

            <div class="overflow-hidden h-12 md:h-0 group-hover:h-12 transition-all duration-500">
              <a
                href={`/servicios#${service.title.toLowerCase().replace(/\s+/g, "-")}`}
                class={`inline-flex items-center gap-2 text-white font-bold text-sm ${service.buttonColor} ${service.buttonHover} px-4 md:px-6 py-2 md:py-3 rounded-xl backdrop-blur-sm transition-colors`}
              >
                Saber más
                <i data-lucide="chevron-right" class="w-4 h-4"></i>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

    <section class="py-24 px-4 bg-gray-50 overflow-hidden">
      <div class="max-w-7xl mx-auto relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          
          <div class="z-10 text-center lg:text-left">
            <h2 class="text-4xl md:text-5xl font-bold text-gray-900 italic leading-tight">
              <span id="big-title">{allBenefits[0].title}</span> <br />
              <span id="big-subtitle" class="text-blue-400 not-italic">{allBenefits[0].subtitle}</span>

            </h2>
            
            <div id="big-desc-container" class="mt-6 text-gray-600 text-lg md:text-xl font-medium max-w-2xl mx-auto lg:mx-0 space-y-4 transition-all duration-500">
              {allBenefits[0].desc.map((p) => (
                <p class="fade-in">{p}</p>
              ))}
            </div>
          </div>

          <div class="relative mt-12 lg:mt-0">
            <div class="relative z-0 rounded-3xl overflow-hidden shadow-2xl border-4 border-white aspect-video lg:aspect-square">
              <img id="big-image" src={allBenefits[0].image} alt="Principal" class="w-full h-full object-cover transition-all duration-700" />
            </div>

            <div class="relative mt-8 w-full z-20 lg:absolute lg:mt-0 lg:-right-40 lg:top-1/2 lg:-translate-y-1/2 lg:w-125">
              <ul id="cards-container" class="flex flex-col gap-6 w-full">
                {allBenefits.slice(1).map((item) => (
                  <li 
                    class="benefit-card flex gap-4 items-center bg-white/95 backdrop-blur-md p-3 rounded-2xl shadow-xl border border-white/30 
                          transition-all duration-500 group cursor-pointer lg:w-max lg:ml-auto hover:lg:w-full overflow-hidden"
                    data-id={item.id}
                    data-json={JSON.stringify(item)} 
                  >
                    <img src={item.image} class="card-img w-16 h-16 md:w-20 md:h-20 rounded-xl object-cover shrink-0" />
                    
                    <div class="lg:max-w-0 lg:opacity-0 group-hover:lg:max-w-md group-hover:lg:opacity-100 transition-all duration-500">
                      <div class="min-w-62.5 pl-2">
                        <h4 class="card-title text-lg font-bold text-gray-900 mb-1">{item.title}</h4>
                        <p class="card-desc-preview text-gray-600 text-sm line-clamp-2 mb-1">{item.desc[0]}</p>
                        <span class="text-gray-600 text-[10px] font-bold uppercase tracking-widest">... Ver más</span>
                      </div>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-28 px-8 bg-white">
  <div class="max-w-7xl mx-auto text-center">
    <!-- Título -->
    <h2 class="text-4xl md:text-5xl font-bold text-gray-900 italic mb-12">
      Lo que dicen <br/>
      <span class="bg-[linear-gradient(to_right,#FF1493,#FFFF00,#44B5E6)] bg-clip-text text-transparent italic">
        nuestras familias
      </span>
    </h2>

    <!-- Carrusel -->
    <div
      id="testimonials-container"
      class="overflow-hidden relative py-10"
    >
      <div class="flex gap-6 w-max" id="testimonials-track">
        {testimonials.concat(testimonials).map((testimonial) => (
          <article
            class="shrink-0 w-80 bg-white p-6 rounded-3xl shadow-lg hover:shadow-xl transition-shadow duration-300"
            role="group"
            aria-label={`Testimonio de ${testimonial.name}`}
          >
            <img
              src={testimonial.image}
              alt={`Foto de ${testimonial.name}`}
              class="w-16 h-16 rounded-full mx-auto mb-4 shadow-lg group-hover:scale-110 transition-transform duration-300"
              loading="lazy"
            />
            <p class="text-gray-600 italic mb-4">"{testimonial.quote}"</p>
            <h4 class="font-bold text-gray-900">{testimonial.name}</h4>
            <p class="text-sm text-gray-600">{testimonial.role}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>



    <!-- Galería de la clínica: Grid de imágenes -->
    <section class="py-24 px-4 bg-gray-900">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-6xl font-black text-white italic mt-2">
            Nuestra <span class="bg-[linear-gradient(to_right,#FF1493,#FFFF00,#44B5E6)] bg-clip-text text-transparent ">clínica</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 md:grid-rows-2 gap-4 h-200 md:h-150">
          {galleryImages.map((image, index) => (
            <div
              class={`group relative overflow-hidden rounded-3xl shadow-2xl cursor-pointer gallery-item
                ${index === 0 ? 'md:col-span-2 md:row-span-2' : ''}
                ${index === 1 ? 'md:col-span-2 md:row-span-1' : ''}
              `}
            >
              
              
              <img 
                src={image} 
                alt={`Instalación ${index + 1}`} 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" 
                loading="lazy" 
              />

              <div class="absolute bottom-4 left-4 z-20 translate-y-10 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500">
                <span class="bg-white/10 backdrop-blur-md text-white text-xs px-3 py-1 rounded-full border border-white/20 cursor-pointer view-btn">
                  Ver ambiente
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Sección de CTA: Imagen de fondo con overlay -->
    <section class="py-32 px-4">
      <div class="max-w-6xl mx-auto relative rounded-[3rem] p-12 lg:p-24 text-center text-white overflow-hidden shadow-[0_20px_50px_rgba(34,197,94,0.3)] group">
        <div id="cta-parallax-bg"
      class="absolute inset-0 bg-cover bg-center scale-110 transition-transform duration-500 ease-out" 
      style="background-image: url('/images/service-psychology.jpg');"></div>

   <div class="absolute inset-0 bg-linear-to-br from-pink-600/95 via-yellow-500/15 to-blue-800/95 group-hover:opacity-95 transition-all duration-700"></div>
    
    <div class="absolute inset-0 overflow-hidden pointer-events-none opacity-20">
      <i data-lucide="sparkles" class="absolute top-10 left-10 w-12 h-12 animate-pulse"></i>
      <i data-lucide="stethoscope" class="absolute bottom-10 right-20 w-16 h-16 rotate-12"></i>
    </div>

    <div class="relative z-10">
      <span class="inline-block bg-white/20 backdrop-blur-md px-4 py-1 rounded-full text-sm font-bold tracking-widest uppercase mb-6 animate-bounce-slow">
        Estamos listos para ayudarte
      </span>
      
      <h2 class="text-5xl md:text-7xl font-bold mb-8 italic tracking-tighter leading-tight">
        Tu tranquilidad <br/> 
        <span class="text-yellow-300 not-italic drop-shadow-md">empieza aquí</span>
      </h2>
      
      <p class="text-white/90 text-lg md:text-2xl mb-12 max-w-2xl mx-auto font-medium leading-relaxed">
        Agenda una consulta hoy mismo en <span class="text-white font-bold underline decoration-yellow-300 underline-offset-4">{siteConfig.location.city}</span> y brinda a tus hijos la atención que merecen.
      </p>

      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
        <a href={siteConfig.contact.whatsappUrl} 
          target="_blank" 
          class="cta-btn-primary group/btn bg-white text-green-700 px-12 py-5 rounded-2xl font-black text-xl hover:shadow-[0_0_30px_rgba(255,255,255,0.4)] transition-all flex items-center gap-3 active:scale-95"
        >
          <i class="bi bi-whatsapp text-2xl group-hover/btn:rotate-12 transition-transform"></i> 
          Reservar Cita
        </a>

        <a 
          href={`tel:${siteConfig.contact.phone}`} 
          class="group/btn px-10 py-5 rounded-2xl font-bold text-lg border-2 border-white/40 backdrop-blur-sm hover:bg-white hover:text-green-700 transition-all flex items-center gap-3 active:scale-95"
        >
          <i data-lucide="phone-call" class="w-5 h-5 group-hover/btn:animate-tada"></i> 
          Llamar Ahora
        </a>
      </div>
    </div>
  </div>
    </section>
  </main>
</Layout>

<style>
  /* Animaciones para tema infantil */
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fade-in 1s ease-out forwards;
  }
  .animation-delay-200 { animation-delay: 0.2s; }
  .animation-delay-400 { animation-delay: 0.4s; }
  .animation-delay-500 { animation-delay: 0.5s; }

  @keyframes bounce-soft {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-5px); }
    60% { transform: translateY(-2px); }
  }
  .animate-bounce-soft {
    animation: bounce-soft 2s infinite;
  }

  @keyframes pulse-soft {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.8; }
  }
  .animate-pulse-soft {
    animation: pulse-soft 3s infinite;
  }

  /* Animación para el carrusel constante */
  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-scroll {
    animation: scroll 20s linear infinite;
  }

  @keyframes float {
  0% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
  100% { transform: translateY(0px); }
}

.group:hover .group-hover\:animate-bounce {
  animation: float 3s ease-in-out infinite;
}

/* Efecto de brillo sutil en las tarjetas */
  .group::after {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 50%; height: 100%;
    background: linear-gradient(to right, transparent, rgba(255,255,255,0.1), transparent);
    transform: skewX(-25deg);
    transition: 0.7s;
  }
  .group:hover::after {
    left: 125%;
  }

  /* Animación de flotación suave para los iconos */
  .group:hover [data-lucide] {
    animation: floating 2s ease-in-out infinite;
  }

  @keyframes floating {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }

  .fade-in { animation: fadeIn 0.5s ease forwards; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  #big-desc-container, #big-title, #big-image { transition: opacity 0.3s ease, transform 0.3s ease; }

  /* Efecto de borde iluminado al pasar el mouse */
  .group {
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.5s ease;
  }
  
  .group:hover {
    border-color: none; /* Verde esmeralda */
    box-shadow: 0 0 40px rgba(0, 0, 0, 0.5);
  }

  /* Animación de entrada suave para el Grid */
  .grid > div {
    animation: revealGallery 0.8s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  @keyframes revealGallery {
    from { opacity: 0; transform: translateY(30px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* Delay para cada imagen para efecto cascada */
  .grid > div:nth-child(1) { animation-delay: 0.1s; }
  .grid > div:nth-child(2) { animation-delay: 0.2s; }
  .grid > div:nth-child(3) { animation-delay: 0.3s; }
  .grid > div:nth-child(4) { animation-delay: 0.4s; }

  /* Estilo para el Lightbox animado */
  .lightbox-active {
    animation: fadeIn 0.3s ease-out;
  }
</style>
<script>
  // Almacenamos el estado de lo que está "Arriba" (Grande)
  let currentBig = {
    title: "Infraestructura diseñada",
    subtitle: "para su bienestar",
     desc: [
      "Nuestra clínica ofrece un entorno seguro, cálido y acogedor, especialmente diseñado para el desarrollo integral de los niños desde sus primeros años.",
      "Contamos con instalaciones modernas equipadas con tecnología médica de vanguardia, consultorios pediátricos adaptados y áreas de espera amigables para reducir el estrés infantil.",
