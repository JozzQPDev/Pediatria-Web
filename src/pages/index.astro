</style>
<script>
  // Almacenamos el estado de lo que está "Arriba" (Grande)
  let currentBig = {
    title: "Infraestructura diseñada",
    subtitle: "para su bienestar",
    desc: [
      "Nuestra clínica ofrece un entorno seguro, cálido y acogedor, especialmente diseñado para el desarrollo integral de los niños desde sus primeros años.",
      "Contamos con instalaciones modernas equipadas con tecnología médica de vanguardia, consultorios pediátricos adaptados y áreas de espera amigables para reducir el estrés infantil.",
      "Cada espacio ha sido pensado para brindar comodidad tanto a los pacientes como a sus familias, promoviendo una experiencia tranquila y positiva.",
      "Aplicamos estrictos protocolos de bioseguridad, limpieza y control sanitario que garantizan una atención confiable, humana y de alta calidad en cada visita.",
    ],
    image: "/images/clinica-home1.jpg",
  };

  const cards = document.querySelectorAll(".benefit-card");
  const bigImage = document.getElementById("big-image") as HTMLImageElement;
  const bigTitle = document.getElementById("big-title");
  const bigSubtitle = document.getElementById("big-subtitle");
  const bigDesc = document.getElementById("big-desc-container");

  cards.forEach((card) => {
    card.addEventListener("click", () => {
      // 1. Extraer datos de la card (usando el atributo data-json para no perder los párrafos)
      const cardData = JSON.parse(card.getAttribute("data-json") || "{}");

      // 2. SWAP: La Card ahora recibe lo que estaba en grande
      const tempToCard = { ...currentBig }; // Copia de lo que estaba grande

      // Actualizar visualmente la card que fue clickeada
      const cardTitleEl = card.querySelector(".card-title") as HTMLElement;
      const cardDescEl = card.querySelector(
        ".card-desc-preview",
      ) as HTMLElement;
      const cardImgEl = card.querySelector(".card-img") as HTMLImageElement;

      cardTitleEl.innerText = tempToCard.title;
      cardDescEl.innerText = tempToCard.desc[0]; // Vista previa del primer párrafo
      cardImgEl.src = tempToCard.image;
      card.setAttribute("data-json", JSON.stringify(tempToCard));

      // 3. SWAP: Lo grande ahora recibe lo que estaba en la card
      if (bigImage) {
        bigImage.style.opacity = "0";
        setTimeout(() => {
          bigImage.src = cardData.image;
          bigImage.style.opacity = "1";
        }, 300);
      }

      if (bigTitle && bigSubtitle && bigDesc) {
        bigTitle.style.opacity = "0";
        bigDesc.style.opacity = "0";

        setTimeout(() => {
          bigTitle.innerText = cardData.title;
          bigSubtitle.innerText = cardData.subtitle || "Detalles del servicio";

          // Generar párrafos dinámicamente
          bigDesc.innerHTML = cardData.desc
            .map((p: string) => `<p class="fade-in">${p}</p>`)
            .join("");

          bigTitle.style.opacity = "1";
          bigDesc.style.opacity = "1";
        }, 300);
      }

      // 4. Actualizar el estado global de "Lo Grande"
      currentBig = { ...cardData };
    });
  });

  const container = document.getElementById("testimonials-container") as HTMLElement | null;
  const track = document.getElementById("testimonials-track") as HTMLElement | null;

  if (container && track) {
    const _container = container;
    const _track = track;

    let scrollAmount = 0;
    const speed = 0.5;

    function autoScroll() {
      scrollAmount += speed;
      if (scrollAmount >= _track.scrollWidth / 2) {
        scrollAmount = 0;
      }
      _container.scrollLeft = scrollAmount;
      requestAnimationFrame(autoScroll);
    }

    autoScroll();
  }

  // Lógica simple de visualización (Lightbox)
  const galleryItems = document.querySelectorAll(".gallery-item .view-btn");

  galleryItems.forEach((btn) => {
    btn.addEventListener("click", () => {
      // Crear overlay
      const overlay = document.createElement("div");
      overlay.className =
        "fixed inset-0 bg-gray-900/95 z-[100] flex items-center justify-center p-4 md:p-12 cursor-zoom-out lightbox-active";

      // Contenedor de imagen para evitar que se pegue a los bordes
      const fullImg = document.createElement("img");
      const galleryItem = btn.closest(".gallery-item");
      const imgElement = galleryItem?.querySelector("img") as HTMLImageElement;
      if (imgElement) {
        fullImg.src = imgElement.src;
      }
      fullImg.className =
        "max-w-full max-h-full rounded-3xl shadow-2xl border-4 border-white/10 transform transition-transform duration-500 scale-95";

      overlay.appendChild(fullImg);
      document.body.appendChild(overlay);

      // Pequeño timeout para animación de entrada de la imagen
      setTimeout(() => {
        fullImg.classList.remove("scale-95");
        fullImg.classList.add("scale-100");
      }, 10);

      // Cerrar al hacer clic en el fondo
      overlay.onclick = () => {
        overlay.classList.add("opacity-0");
        setTimeout(() => overlay.remove(), 300);
      };
    });
  });
</script>
<script>
  // 1. Lógica del Carrusel del hero
  const slides = document.querySelectorAll('.carousel-slide');
  let current = 0;
  setInterval(() => {
    slides[current].classList.replace('opacity-100', 'opacity-0');
    const currentSlideDiv = slides[current].querySelector('div') as HTMLElement | null;
    if (currentSlideDiv) {
      currentSlideDiv.classList.remove('animate-ken-burns');
    }
    current = (current + 1) % slides.length;
    slides[current].classList.replace('opacity-0', 'opacity-100');
    const nextImg = slides[current].querySelector('div') as HTMLElement | null;
    if (nextImg) {
      void nextImg.offsetWidth; 
      nextImg.classList.add('animate-ken-burns');
    }
  }, 6000);

  // 2. Lógica Parallax para Iconos
  document.addEventListener('mousemove', (e) => {
    const layers = document.querySelectorAll('.parallax-layer');
    const x = (window.innerWidth - e.pageX * 2) / 100;
    const y = (window.innerHeight - e.pageY * 2) / 100;

    layers.forEach(layer => {
      const speed = layer.getAttribute('data-speed');
      const htmlLayer = layer as HTMLElement;
      if (speed) {
        htmlLayer.style.transform = `translateX(${x * Number(speed)}px) translateY(${y * Number(speed)}px)`;
      }
    });
  });
</script>