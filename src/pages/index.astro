---
import Layout from "../layouts/Layout.astro";
import { company } from "../data/company";

import HeroSection from "../components/index/HeroSection.astro";
import AboutSection from "../components/index/AboutSection.astro";
import QuickServicesSection from "../components/index/QuickServicesSection.astro";
import TeamSection from "../components/index/TeamSection.astro";
import QuoteSection from "../components/index/QuoteSection.astro";
import InfrastructureSection from "../components/index/InfrastructureSecion.astro";
import TestimonialsSection from "../components/index/TestimonialsSection.astro";
import FaqSection from "../components/index/FaqSection.astro";
import Quote2Section from "../components/index/Quote2Section.astro";
import CtaSection from "../components/index/CtaSection.astro";
import FloatingStatsBar from "../components/FloatingStatsBar.astro";
import CtaSection1 from "../components/index/CtaSection1.astro";
---

<Layout title={`Inicio | ${company.name}`} 
description={`Bienvenido a nuestra clínica pediátrica en ${company.address.city}, donde la salud y el bienestar de tus hijos son nuestra prioridad. Descubre un entorno seguro, moderno y acogedor diseñado para brindar atención médica integral a los más pequeños de la casa. Con especialistas certificados, tecnología avanzada y un enfoque humano, ofrecemos servicios que acompañan cada etapa del crecimiento infantil. Tu tranquilidad comienza aquí, en un lugar donde cada sonrisa cuenta.`}>
  
<HeroSection />
<FloatingStatsBar />

<main class="aos-mobile-enabled main-section overflow-hidden bg-white">
  <span class="cloud cloud--1" aria-hidden="true"></span>
  <span class="cloud cloud--2" aria-hidden="true"></span>
  <span class="cloud cloud--3" aria-hidden="true"></span>
  <span class="cloud cloud--4" aria-hidden="true"></span>
  <span class="cloud cloud--5" aria-hidden="true"></span>
  <span class="cloud cloud--6" aria-hidden="true"></span>
  <span class="cloud cloud--7" aria-hidden="true"></span>
  <span class="cloud cloud--8" aria-hidden="true"></span>
  <span class="cloud cloud--9" aria-hidden="true"></span>
  <span class="cloud cloud--10" aria-hidden="true"></span>
  <span class="cloud cloud--11" aria-hidden="true"></span>
  <span class="cloud cloud--12" aria-hidden="true"></span>

  <AboutSection />
  <QuickServicesSection />
  <CtaSection1 />
  <TeamSection />
  <QuoteSection />
  <span class="cloud cloud--5" aria-hidden="true"></span>
  <span class="cloud cloud--6" aria-hidden="true"></span>
  <span class="cloud cloud--7" aria-hidden="true"></span>
  <span class="cloud cloud--8" aria-hidden="true"></span>
  <span class="cloud cloud--9" aria-hidden="true"></span>
  <span class="cloud cloud--10" aria-hidden="true"></span>
  <span class="cloud cloud--11" aria-hidden="true"></span>
  <span class="cloud cloud--12" aria-hidden="true"></span>
  <InfrastructureSection />
  <FaqSection />
  <Quote2Section />
  <TestimonialsSection />
  <CtaSection />
 </main>
</Layout>
