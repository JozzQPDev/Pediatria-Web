---
// Prerender this page as static HTML
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import { services, getServiceBySlug, getRelatedServices } from "../../data/services";
import { siteConfig } from "../../data/siteConfig";

// Generate static paths for all services
export function getStaticPaths() {
  return services.map(service => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

// Handle case when service is not found
if (!service) {
  return Astro.redirect('/servicios');
}

// Get related services
const relatedServices = getRelatedServices(service.slug, 3);


// Color mapping for dynamic classes (versiones pasteles)
const colorClasses = {
  green: {
    bg: "bg-green-300",
    bgLight: "bg-green-50",
    text: "text-green-500",
    border: "border-green-200",
    ring: "focus-within:ring-green-300",
    gradient: "from-green-300 to-emerald-400"
  },
  blue: {
    bg: "bg-blue-300",
    bgLight: "bg-blue-50",
    text: "text-blue-500",
    border: "border-blue-200",
    ring: "focus-within:ring-blue-300",
    gradient: "from-blue-300 to-cyan-400"
  },
  yellow: {
    bg: "bg-yellow-300",
    bgLight: "bg-yellow-50",
    text: "text-yellow-600",
    border: "border-yellow-200",
    ring: "focus-within:ring-yellow-300",
    gradient: "from-yellow-300 to-orange-400"
  },
  pink: {
    bg: "bg-pink-300",
    bgLight: "bg-pink-50",
    text: "text-pink-500",
    border: "border-pink-200",
    ring: "focus-within:ring-pink-300",
    gradient: "from-pink-300 to-rose-400"
  },
  purple: {
    bg: "bg-purple-300",
    bgLight: "bg-purple-50",
    text: "text-purple-500",
    border: "border-purple-200",
    ring: "focus-within:ring-purple-300",
    gradient: "from-purple-300 to-violet-400"
  },
  teal: {
    bg: "bg-teal-300",
    bgLight: "bg-teal-50",
    text: "text-teal-500",
    border: "border-teal-200",
    ring: "focus-within:ring-teal-300",
    gradient: "from-teal-300 to-cyan-400"
  }
};

const colors = colorClasses[service.color as keyof typeof colorClasses] || colorClasses.blue;

---

<Layout 
  title={`${service.title} | Servicios`}
  description={service.shortDesc}
>
<Hero
    title={service.title}
    subtitle={service.shortDesc}
    backgroundImage={service.image}
    sideImage={service.image}
  />

  <!-- Service Overview -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="reveal-left">
          <div class={`inline-flex items-center gap-2 ${colors.bgLight} ${colors.text} px-4 py-2 rounded-full text-sm font-bold uppercase tracking-wider mb-6`}>
            <i data-lucide={service.icon} class="w-4 h-4"></i>
            Especialidad Médica
          </div>
          
          <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-6 leading-tight">
            Cuidado especializado para <span class={colors.text}>tu familia</span>
          </h2>
          
          <p class="text-lg text-gray-600 leading-relaxed mb-6">
            {service.fullDesc}
          </p>
          
          <div class="flex flex-wrap gap-4">
            <div class={`flex items-center gap-2 ${colors.bgLight} px-4 py-2 rounded-xl`}>
              <i data-lucide="clock" class={`w-5 h-5 ${colors.text}`}></i>
              <span class="text-sm font-medium text-gray-700">{service.duration}</span>
            </div>
            <div class={`flex items-center gap-2 ${colors.bgLight} px-4 py-2 rounded-xl`}>
              <i data-lucide="calendar" class={`w-5 h-5 ${colors.text}`}></i>
              <span class="text-sm font-medium text-gray-700">{service.schedule}</span>
            </div>
            <div class={`flex items-center gap-2 ${colors.bgLight} px-4 py-2 rounded-xl`}>
              <i data-lucide="user" class={`w-5 h-5 ${colors.text}`}></i>
              <span class="text-sm font-medium text-gray-700">{service.doctor}</span>
            </div>
          </div>
        </div>
        
        <div class="relative reveal-right">
          <div class={`absolute -top-4 -right-4 w-24 h-24 ${colors.bg} rounded-full opacity-20 blur-2xl`}></div>
          <div class={`absolute -bottom-4 -left-4 w-32 h-32 ${colors.bg} rounded-full opacity-20 blur-2xl`}></div>
          
          <div class="relative overflow-hidden rounded-3xl shadow-2xl group">
            <img 
              src={service.image} 
              alt={service.title}
              class="w-full h-80 object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class={`absolute inset-0 bg-linear-to-t ${colors.gradient} opacity-0 group-hover:opacity-20 transition-opacity duration-500`}></div>
          </div>
          
          <!-- Price Badge -->
          <div class="relative lg:absolute lg:-bottom-6 lg:-right-6 bg-white rounded-2xl shadow-xl p-6 border border-gray-100 reveal-scale stagger-2 mt-4 lg:mt-0 mx-auto lg:mx-0 w-fit">
            <p class="text-sm text-gray-500 mb-1">Inversión desde</p>
            <p class="text-3xl font-bold text-gray-900">{service.price}</p>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12 reveal">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">¿Qué incluye nuestro servicio?</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">Ofrecemos un servicio integral con todas las características necesarias para el cuidado de tu hijo.</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {service.features.map((feature, index) => (
          <div class={`bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all duration-300 reveal hover-lift stagger-${index + 1}`}>
            <div class={`w-12 h-12 ${colors.bgLight} ${colors.text} rounded-xl flex items-center justify-center mb-4`}>
              <i data-lucide="check-circle" class="w-6 h-6"></i>
            </div>
            <p class="text-gray-700 font-medium">{feature}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1 reveal-left">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Beneficios de elegirnos</h2>
          <div class="space-y-4">
            {service.benefits.map((benefit, index) => (
              <div class="flex items-start gap-4 reveal stagger-${index + 1}">
                <div class={`w-8 h-8 ${colors.bg} rounded-full flex items-center justify-center shrink-0 mt-1`}>
                  <i data-lucide="heart" class="w-4 h-4 text-white"></i>
                </div>
                <p class="text-gray-600 leading-relaxed">{benefit}</p>
              </div>
            ))}
          </div>
        </div>
        
        <div class="order-1 lg:order-2 reveal-right">
          <div class={`bg-linear-to-br ${colors.gradient} rounded-3xl p-8 text-white`}>



            <div class="flex items-center gap-4 mb-6">
              <div class="w-16 h-16 bg-white/20 rounded-2xl flex items-center justify-center">
                <i data-lucide="award" class="w-8 h-8"></i>
              </div>
              <div>
                <h3 class="text-xl font-bold">Calidad Garantizada</h3>
                <p class="text-white/80">Servicio certificado y respaldado</p>
              </div>
            </div>
            
            <div class="space-y-4">
              <div class="flex items-center gap-3">
                <i data-lucide="shield-check" class="w-5 h-5 text-white/80"></i>
                <span class="text-white/90">Protocolos de bioseguridad</span>
              </div>
              <div class="flex items-center gap-3">
                <i data-lucide="stethoscope" class="w-5 h-5 text-white/80"></i>
                <span class="text-white/90">Especialistas certificados</span>
              </div>
              <div class="flex items-center gap-3">
                <i data-lucide="clock" class="w-5 h-5 text-white/80"></i>
                <span class="text-white/90">Atención puntual</span>
              </div>
              <div class="flex items-center gap-3">
                <i data-lucide="heart-handshake" class="w-5 h-5 text-white/80"></i>
                <span class="text-white/90">Atención personalizada</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12 reveal">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Nuestro Proceso</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">Te acompañamos en cada paso del camino hacia la salud de tu hijo.</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {service.process.map((step, index) => (
          <div class="relative reveal stagger-${index + 1}">
            {index < service.process.length - 1 && (
              <div class="hidden lg:block absolute top-8 left-full w-full h-0.5 bg-gray-200 -translate-y-1/2 z-0"></div>
            )}
            <div class="bg-white rounded-2xl p-6 shadow-lg relative z-10 h-full hover-lift">
              <div class={`w-16 h-16 ${colors.bg} rounded-2xl flex items-center justify-center text-white text-2xl font-bold mb-4`}>
                {step.step}
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-12 reveal">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Preguntas Frecuentes</h2>
        <p class="text-gray-600">Resolvemos tus dudas sobre este servicio</p>
      </div>

      <div class="space-y-4">
        {service.faq.map((item, index) => (
          <div class={`bg-gray-50 rounded-2xl overflow-hidden reveal stagger-${index + 1}`}>
            <details class="group">
              <summary class={`flex items-center justify-between p-6 cursor-pointer list-none hover:${colors.bgLight} transition-colors`}>
                <h3 class="text-lg font-bold text-gray-900 pr-4">{item.question}</h3>
                <span class={`w-10 h-10 ${colors.bgLight} ${colors.text} rounded-full flex items-center justify-center shrink-0 group-open:rotate-180 transition-transform`}>
                  <i data-lucide="chevron-down" class="w-5 h-5"></i>
                </span>
              </summary>
              <div class="px-6 pb-6">
                <p class="text-gray-600 leading-relaxed">{item.answer}</p>
              </div>
            </details>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class={`py-16 bg-linear-to-br ${colors.gradient} text-white`}>


    <div class="max-w-4xl mx-auto px-4 text-center reveal">
      <h2 class="text-3xl lg:text-4xl font-bold mb-4">
        ¿Listo para agendar tu cita?
      </h2>
      <p class="text-white/90 text-lg mb-8 max-w-2xl mx-auto">
        Nuestro equipo está preparado para brindarte la mejor atención. Agenda ahora y comienza el cuidado de la salud de tu hijo.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href={siteConfig.contact.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-3 bg-white text-gray-900 px-8 py-4 rounded-2xl font-bold hover:bg-gray-100 hover:scale-105 transition-all shadow-xl"
        >
           <i class="bi bi-whatsapp text-lg" aria-hidden="true"></i>
          Agendar por WhatsApp
        </a>
        <a 
          href="/contacto"
          class="inline-flex items-center justify-center gap-3 bg-white/20 backdrop-blur-md text-white px-8 py-4 rounded-2xl font-bold hover:bg-white/30 transition-all border border-white/30"
        >
          <i data-lucide="map-pin" class="w-5 h-5"></i>
          Ver Ubicación
        </a>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  {relatedServices.length > 0 && (
    <section class="py-16 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12 reveal">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Otros Servicios</h2>
          <p class="text-gray-600">Descubre más especialidades que ofrecemos</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {relatedServices.map((relatedService, index) => (
            <a 
              href={`/servicios/${relatedService.slug}`}
              class="group bg-white rounded-3xl shadow-lg hover:shadow-2xl transition-all duration-500 overflow-hidden reveal hover-lift stagger-${index + 1}"
            >
              <div class="relative overflow-hidden h-48">
                <img 
                  src={relatedService.image} 
                  alt={relatedService.title}
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                />
                <div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>



              </div>
              
              <div class="p-6">
                <div class="flex items-center gap-2 mb-3">
                  <i data-lucide={relatedService.icon} class={`w-5 h-5 text-${relatedService.color}-400`}></i>
                  <span class={`text-sm font-bold uppercase tracking-wider text-${relatedService.color}-400`}>
                    {relatedService.category || 'Especialidad'}
                  </span>
                </div>
                
                <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-pink-400 transition-colors">
                  {relatedService.title}
                </h3>
                
                <p class="text-gray-600 text-sm line-clamp-2 mb-4">
                  {relatedService.shortDesc}
                </p>
                
                <span class="inline-flex items-center gap-2 text-pink-400 font-bold text-sm group-hover:gap-3 transition-all">
                  Ver más
                  <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

<script>
  // Intersection Observer for scroll-triggered animations
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.1
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('active');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  // Observe all elements with reveal classes
  document.addEventListener('DOMContentLoaded', () => {
    const revealElements = document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale');
    revealElements.forEach(el => observer.observe(el));
  });
</script>
