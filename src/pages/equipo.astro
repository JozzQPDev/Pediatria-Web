---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";

const doctores = [
  {
    name: "Dra. Elena Martínez",
    role: "Pediatra Neonatóloga",
    specialty: "Líder de Cuidado del Recién Nacido",
    image: "/images/medic-1.jpg",
    tags: ["Lactancia", "Prematuros"],
    linkedin: "https://linkedin.com/in/elena-martinez",
    email: "emartinez@clinica.com",
    // Colores:
    overlayFrom: "from-green-600/80",
    accentText: "text-green-600",
    accentRing: "focus-within:ring-green-500",
    accentHoverBg: "hover:bg-green-50",
    tagHoverText: "hover:text-green-600",
    borderAccent: "border-green-400",
    softBg: "bg-green-50/50",
  },
  {
    name: "Dr. Ricardo Santos",
    role: "Pediatra Especialista",
    specialty: "Crecimiento y Desarrollo",
    image: "/images/medic-2.jpg",
    tags: ["Nutrición", "Adolescentes"],
    linkedin: "https://linkedin.com/in/ricardo-santos",
    email: "rsantos@clinica.com",
    overlayFrom: "from-blue-600/80",
    accentText: "text-blue-600",
    accentRing: "focus-within:ring-blue-500",
    accentHoverBg: "hover:bg-blue-50",
    tagHoverText: "hover:text-blue-600",
    borderAccent: "border-blue-400",
    softBg: "bg-blue-50/50",
  },
  {
    name: "Dra. Sofía Alva",
    role: "Odontopediatra",
    specialty: "Salud Bucal Infantil",
    image: "/images/medic-3.jpg",
    tags: ["Ortodoncia", "Prevención"],
    linkedin: "https://linkedin.com/in/sofia-alva",
    email: "salva@clinica.com",
    overlayFrom: "from-yellow-600/80",
    accentText: "text-yellow-600",
    accentRing: "focus-within:ring-yellow-500",
    accentHoverBg: "hover:bg-yellow-50",
    tagHoverText: "hover:text-yellow-600",
    borderAccent: "border-yellow-400",
    softBg: "bg-yellow-50/50",
  },
  {
    name: "Dr. Carlos Ruiz",
    role: "Psicólogo Infantil",
    specialty: "Desarrollo Emocional",
    image: "/images/medic-4.jpg",
    tags: ["Conducta", "Terapia"],
    linkedin: "https://linkedin.com/in/carlos-ruiz",
    email: "cruiz@clinica.com",
    overlayFrom: "from-purple-600/80",
    accentText: "text-purple-600",
    accentRing: "focus-within:ring-purple-500",
    accentHoverBg: "hover:bg-purple-50",
    tagHoverText: "hover:text-purple-600",
    borderAccent: "border-purple-400",
    softBg: "bg-purple-50/50",
  },
];

const beneficios = [
  {
    title: "Staff Colegiado",
    desc: "Especialistas certificados con años de experiencia...",
    icon: "award",
    image: "/images/benefit-certified.jpg",
    overlayFrom: "from-green-600/90",
    iconColor: "text-green-600",
    ring: "focus-within:ring-green-500",
    descText: "text-green-100",
  },
  {
    title: "Atención Moderna",
    desc: "Equipamiento tecnológico de última generación...",
    icon: "sparkles",
    image: "/images/benefit-modern.jpg",
    overlayFrom: "from-blue-600/90",
    iconColor: "text-blue-600",
    ring: "focus-within:ring-blue-500",
    descText: "text-blue-100",
  },
  {
    title: "Enfoque Familiar",
    desc: "Entendemos que la salud de un niño involucra...",
    icon: "users",
    image: "/images/benefit-family.jpg",
    overlayFrom: "from-purple-600/90",
    iconColor: "text-purple-600",
    ring: "focus-within:ring-purple-500",
    descText: "text-purple-100",
  },
];
---

<Layout title="Nuestro Equipo Médico" description="Conoce a los especialistas que conforman nuestro equipo médico, dedicados a brindar el mejor cuidado a tus hijos. Profesionales certificados en pediatría, odontología infantil y psicología infantil, comprometidos con la salud y bienestar de tu familia.">
  <Hero
    title="Especialistas de Corazón"
    subtitle="Profesionales certificados con un solo objetivo: el bienestar y la salud integral de tus hijos."
    backgroundImage="/img/hero-equipo.jpg"
    sideImage="/img/hero-equipo.jpg"
  />
 <main class="main-section">
    <span class="cloud cloud--1" aria-hidden="true"></span>
    <span class="cloud cloud--2" aria-hidden="true"></span>
    <span class="cloud cloud--3" aria-hidden="true"></span>
    <span class="cloud cloud--4" aria-hidden="true"></span>
    <span class="cloud cloud--5" aria-hidden="true"></span>
  <!-- Sección de doctores -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-16">
        <!-- (Esto queda verde porque es título general, no por doctor) -->
        <span class="inline-block text-green-600 font-bold uppercase tracking-[0.3em] text-[11px] bg-green-50 px-4 py-2 rounded-lg mb-6">
          Nuestro Equipo
        </span>

        <h2 class="text-4xl md:text-6xl font-bold text-gray-900 italic leading-tight">
          Profesionales Dedicados <br />
          <span class="text-green-600 not-italic">al Cuidado Infantil</span>
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10">
        {
          doctores.map((doc) => (
            <div
              class:list={[
                "group focus-within:ring-2 rounded-3xl",
                doc.accentRing,
              ]}
              role="article"
              aria-label={`Perfil de ${doc.name}`}
            >
              <div class="relative overflow-hidden rounded-3xl mb-6 shadow-xl border border-gray-100 bg-gray-200 aspect-4/5">
                <img
                  src={doc.image}
                  alt={`Foto de ${doc.name}`}
                  class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105 grayscale-20 group-hover:grayscale-0"
                  loading="lazy"
                />

                <div
                  class:list={[
                    "absolute inset-0 bg-linear-to-t via-transparent to-transparent opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-all duration-300 flex items-end justify-center pb-8",
                    doc.overlayFrom,
                  ]}
                >


                  <div class="flex gap-4 translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                    <a
                      href={doc.linkedin}
                      target="_blank"
                      rel="noopener noreferrer"
                      class:list={[
                        "w-11 h-11 bg-white rounded-full flex items-center justify-center shadow-lg hover:scale-110 transition-all focus:ring-2",
                        doc.accentText,
                        doc.accentHoverBg,
                      ]}
                      aria-label={`LinkedIn de ${doc.name}`}
                    >
                      <i data-lucide="linkedin" class="w-5 h-5" aria-hidden="true"></i>
                    </a>

                    <a
                      href={`mailto:${doc.email}`}
                      class:list={[
                        "w-11 h-11 bg-white rounded-full flex items-center justify-center shadow-lg hover:scale-110 transition-all focus:ring-2",
                        doc.accentText,
                        doc.accentHoverBg,
                      ]}
                      aria-label={`Email de ${doc.name}`}
                    >
                      <i data-lucide="mail" class="w-5 h-5" aria-hidden="true"></i>
                    </a>
                  </div>
                </div>
              </div>

              <div class="text-center lg:text-left">
                <h3 class="text-2xl font-bold text-gray-900 mb-1">{doc.name}</h3>

                <p class:list={["font-bold text-sm mb-4 uppercase tracking-wide", doc.accentText]}>
                  {doc.role}
                </p>

                <div class:list={["p-4 rounded-2xl mb-5", doc.softBg]}>
                  <p class:list={["text-gray-600 text-sm leading-relaxed italic border-l-2 pl-3", doc.borderAccent]}>
                    "{doc.specialty}"
                  </p>
                </div>

                <div class="flex flex-wrap gap-2 justify-center lg:justify-start">
                  {doc.tags.map((tag) => (
                    <span
                      class:list={[
                        "px-3 py-1 bg-gray-100 text-gray-500 rounded-lg text-[10px] font-bold uppercase tracking-widest border border-gray-200 transition-colors",
                        doc.accentHoverBg,
                        doc.tagHoverText,
                      ]}
                    >
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Sección de beneficios -->
      <div class="mt-32 grid md:grid-cols-3 gap-12 border-t border-gray-100 pt-20">
        {
          beneficios.map((ben) => (
            <div
              class:list={[
                "group relative overflow-hidden rounded-3xl shadow-lg hover:shadow-2xl transition-all duration-500 cursor-pointer focus-within:ring-2",
                ben.ring,
              ]}
              role="article"
              aria-label={`Beneficio: ${ben.title}`}
            >
              <img
                src={ben.image}
                alt={`Imagen de ${ben.title}`}
                class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />

              <div
                class:list={[
                  "absolute inset-0 bg-linear-to-t to-transparent opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-500 flex flex-col justify-end p-6",
                  ben.overlayFrom,
                ]}
              >


                <div class:list={["w-16 h-16 bg-white rounded-2xl flex items-center justify-center mb-4 group-hover:animate-bounce", ben.iconColor]}>
                  <i data-lucide={ben.icon} class="w-8 h-8" aria-hidden="true"></i>
                </div>

                <h4 class="text-xl font-bold text-white mb-2">{ben.title}</h4>
                <p class:list={["text-sm leading-relaxed", ben.descText]}>{ben.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
 </main>
</Layout>

<style>
  @keyframes bounce-soft {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-5px); }
    60% { transform: translateY(-2px); }
  }
  .animate-bounce-soft {
    animation: bounce-soft 2s infinite;
  }

  @keyframes pulse-soft {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.8; }
  }
  .animate-pulse-soft {
    animation: pulse-soft 3s infinite;
  }
</style>
