---
import Layout from "../layouts/Layout.astro";
import { doctors } from "../data/doctors";
import TitleSection from "../components/equipo/TitleSection.astro";
import LeadDoctorHero from "../components/equipo/LeadDoctorHero.astro";
import SpecialistsGrid from "../components/equipo/SpecialistsGrid.astro";
import TeamValues from "../components/equipo/TeamValues.astro";

type DoctorColor = 'green' | 'blue' | 'yellow' | 'purple' | 'pink';

const colorStyles: Record<DoctorColor, { text: string; bg: string; fill: string; border: string; glow: string }> = {
  pink: { text: "text-pink-500", bg: "bg-pink-50", fill: "bg-pink-500", border: "border-pink-100", glow: "shadow-pink-200/50" },
  blue: { text: "text-blue-600", bg: "bg-blue-50", fill: "bg-blue-600", border: "border-blue-100", glow: "shadow-blue-200/50" },
  yellow: { text: "text-orange-500", bg: "bg-orange-50", fill: "bg-orange-500", border: "border-orange-100", glow: "shadow-orange-200/50" },
  purple: { text: "text-purple-600", bg: "bg-purple-50", fill: "bg-purple-600", border: "border-purple-100", glow: "shadow-purple-200/50" },
  green: { text: "text-emerald-600", bg: "bg-emerald-50", fill: "bg-emerald-600", border: "border-emerald-100", glow: "shadow-emerald-200/50" },
};

const leadDoctor = doctors.find(d => d.name.includes("Amalia")) || doctors[0];
const specialists = doctors.filter(d => d.id !== leadDoctor.id);
---

<Layout title="Equipo Médico Especializado | Clínica Dharma">
  
  <main class="main-section overflow-hidden bg-white">
    <span class="cloud cloud--1" aria-hidden="true"></span>
    <span class="cloud cloud--2" aria-hidden="true"></span>
    <span class="cloud cloud--3" aria-hidden="true"></span>
    <span class="cloud cloud--4" aria-hidden="true"></span>
    <span class="cloud cloud--5" aria-hidden="true"></span>
    <span class="cloud cloud--6" aria-hidden="true"></span>
    <span class="cloud cloud--7" aria-hidden="true"></span>
    <span class="cloud cloud--8" aria-hidden="true"></span>
    <span class="cloud cloud--9" aria-hidden="true"></span>
    <span class="cloud cloud--10" aria-hidden="true"></span>
    <span class="cloud cloud--11" aria-hidden="true"></span>
    <span class="cloud cloud--12" aria-hidden="true"></span>

    <TitleSection />
    <LeadDoctorHero leadDoctor={leadDoctor} colorStyles={colorStyles} />
    <SpecialistsGrid specialists={specialists} colorStyles={colorStyles} />
    <TeamValues />
    
  </main>
</Layout>
     
<style>
  .animate-float {
    animation: float 5s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-10px, -15px); }
  }

  h1, h2, h3 { text-wrap: balance; }
</style>