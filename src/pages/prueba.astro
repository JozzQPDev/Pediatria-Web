---
// Layout e importaciones de Astro
import { siteConfig } from '../data/siteConfig';
import Layout from '../layouts/Layout.astro';
---
<Layout title={`Contacto | ${siteConfig.name}`}>
<body class="font-sans text-gray-800 bg-gray-50/50">

  <div class="bg-[linear-gradient(to_right,#E61E8D,#E6332A,#F19120,#FCBD11,#92278F,#8DC63F,#0054A6,#2B3990,#F15A24,#44B5E6)] text-white py-2 text-[11px] md:text-sm font-bold uppercase tracking-widest relative z-50 shadow-md">
    <div class="max-w-7xl mx-auto px-4 flex justify-between items-center">
      <div class="flex gap-6">
        <a href={`tel:${siteConfig.contact.phone}`} class="flex items-center gap-2 hover:scale-105 transition-transform">
          <i data-lucide="phone" class="w-4 h-4"></i>
          <span class="drop-shadow-sm">{siteConfig.contact.phone}</span>
        </a>
      </div>
      <div class="hidden sm:block drop-shadow-sm">
        📍 {siteConfig.location.city}, {siteConfig.location.district}
      </div>
    </div>
  </div>

  <header class="bg-white/95 backdrop-blur-md sticky top-0 z-40 border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
      <a href="/" class="flex flex-col items-center group">
        <img src="/images/logo-text.png" alt="Logo Clínica" class="h-12 w-auto object-contain transition-transform group-hover:scale-105">
      </a>

      <nav class="hidden lg:flex items-center gap-8 text-[13px] font-bold uppercase tracking-wide text-gray-500">
        <a href="/" class="hover:text-pink-600 transition-colors">Inicio</a>
        <a href="#servicios" class="hover:text-pink-600 transition-colors">Servicios</a>
        <a href="#especialistas" class="hover:text-pink-600 transition-colors">Especialistas</a>
        <a href="#contacto" class="hover:text-pink-600 transition-colors">Contacto</a>
      </nav>

      <a href={siteConfig.contact.whatsappUrl} class="bg-[#44B5E6] hover:bg-[#0054A6] text-white px-6 py-2.5 rounded-full font-bold text-sm transition-all shadow-lg hover:-translate-y-1 flex items-center gap-2">
        <i class="bi bi-whatsapp"></i>
        AGENDAR CITA
      </a>
    </div>
  </header>

  <section class="relative overflow-hidden bg-white py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 grid lg:grid-cols-2 gap-12 items-center">
      <div class="z-10 text-center lg:text-left">
        <span class="inline-block px-4 py-1 rounded-full bg-pink-50 text-pink-600 font-bold text-xs uppercase tracking-widest mb-6">
          Cuidamos lo que más amas
        </span>
        <h1 class="text-4xl md:text-6xl font-black text-gray-900 leading-tight mb-6">
          Atención pediátrica con <span class="text-[#E61E8D]">amor</span> y <span class="text-[#8DC63F]">color</span>
        </h1>
        <p class="text-lg text-gray-600 mb-10 max-w-xl mx-auto lg:mx-0">
          En Clínica Pediátrica ofrecemos un espacio seguro y divertido para el crecimiento saludable de tus hijos. Especialistas certificados con calidez humana.
        </p>
        <div class="flex flex-wrap justify-center lg:justify-start gap-4">
          <a href="#servicios" class="px-8 py-4 bg-[#E61E8D] text-white rounded-2xl font-bold shadow-xl shadow-pink-200 hover:scale-105 transition-transform">
            Nuestros Servicios
          </a>
          <a href="#contacto" class="px-8 py-4 bg-gray-100 text-gray-700 rounded-2xl font-bold hover:bg-gray-200 transition-colors">
            Ver Ubicación
          </a>
        </div>
      </div>
      
      <div class="relative">
        <div class="absolute -top-10 -right-10 w-64 h-64 bg-yellow-200/50 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-10 -left-10 w-64 h-64 bg-blue-200/50 rounded-full blur-3xl"></div>
        <div class="relative rounded-3xl overflow-hidden shadow-2xl border-8 border-white">
           <img src="/images/hero-pediatric.jpg" alt="Niño feliz en consulta" class="w-full h-auto">
        </div>
      </div>
    </div>
  </section>

  <section id="servicios" class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-black text-gray-900">Especialidades para ellos</h2>
      <p class="text-gray-500 mt-4">Todo lo que tu pequeño necesita en un solo lugar</p>
    </div>

    <div class="max-w-7xl mx-auto px-4 grid md:grid-cols-3 gap-8">
      <div class="bg-white p-8 rounded-3xl shadow-sm border-b-4 border-[#E61E8D] hover:shadow-xl transition-shadow group">
        <div class="w-14 h-14 bg-pink-50 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
          <i data-lucide="baby" class="w-8 h-8 text-[#E61E8D]"></i>
        </div>
        <h3 class="text-xl font-bold mb-3">Control de Niño Sano</h3>
        <p class="text-gray-500 text-sm">Seguimiento detallado del crecimiento y desarrollo físico y cognitivo.</p>
      </div>

      <div class="bg-white p-8 rounded-3xl shadow-sm border-b-4 border-[#44B5E6] hover:shadow-xl transition-shadow group">
        <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
          <i data-lucide="syringe" class="w-8 h-8 text-[#44B5E6]"></i>
        </div>
        <h3 class="text-xl font-bold mb-3">Vacunación</h3>
        <p class="text-gray-500 text-sm">Esquema completo de vacunas para proteger a tus hijos de enfermedades.</p>
      </div>

      <div class="bg-white p-8 rounded-3xl shadow-sm border-b-4 border-[#8DC63F] hover:shadow-xl transition-shadow group">
        <div class="w-14 h-14 bg-green-50 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
          <i data-lucide="stethoscop" class="w-8 h-8 text-[#8DC63F]"></i>
        </div>
        <h3 class="text-xl font-bold mb-3">Pediatría General</h3>
        <p class="text-gray-500 text-sm">Atención integral ante cualquier malestar o consulta de salud diaria.</p>
      </div>
    </div>
  </section>
<footer class="bg-gray-900 text-white pt-16 pb-8">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
        
        <div class="flex flex-col gap-6">
          <div class="bg-white p-3 rounded-2xl inline-block w-fit">
            <img src="/images/logo-text.png" alt="Logo Clínica" class="h-10 w-auto">
          </div>
          <p class="text-gray-400 text-sm leading-relaxed">
            Dedicados a brindar salud integral y bienestar a los más pequeños de la casa, con la calidez y el profesionalismo que tu familia merece.
          </p>
          <div class="flex gap-4">
            <a href={siteConfig.socials.facebook} class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center hover:bg-[#E61E8D] transition-colors">
              <i data-lucide="facebook" class="w-5 h-5"></i>
            </a>
            <a href={siteConfig.socials.instagram} class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center hover:bg-[#92278F] transition-colors">
              <i data-lucide="instagram" class="w-5 h-5"></i>
            </a>
          </div>
        </div>

        <div>
          <h4 class="text-lg font-bold mb-6 border-l-4 border-[#8DC63F] pl-3">Navegación</h4>
          <ul class="space-y-4 text-gray-400 text-sm">
            <li><a href="/" class="hover:text-white transition-colors">Inicio</a></li>
            <li><a href="/nosotros" class="hover:text-white transition-colors">Sobre Nosotros</a></li>
            <li><a href="/servicios" class="hover:text-white transition-colors">Servicios Médicos</a></li>
            <li><a href="/equipo" class="hover:text-white transition-colors">Nuestro Equipo</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-lg font-bold mb-6 border-l-4 border-[#44B5E6] pl-3">Contacto</h4>
          <ul class="space-y-4 text-gray-400 text-sm">
            <li class="flex items-start gap-3">
              <i data-lucide="map-pin" class="w-5 h-5 text-[#44B5E6] shrink-0"></i>
              <span>{siteConfig.location.address}, {siteConfig.location.district}</span>
            </li>
            <li class="flex items-center gap-3">
              <i data-lucide="phone" class="w-5 h-5 text-[#44B5E6] shrink-0"></i>
              <span>{siteConfig.contact.phone}</span>
            </li>
            <li class="flex items-center gap-3">
              <i data-lucide="mail" class="w-5 h-5 text-[#44B5E6] shrink-0"></i>
              <span>{siteConfig.contact.email}</span>
            </li>
          </ul>
        </div>

        <div>
          <h4 class="text-lg font-bold mb-6 border-l-4 border-[#FCBD11] pl-3">Horario</h4>
          <div class="bg-gray-800/50 p-4 rounded-2xl border border-gray-700">
            <div class="flex justify-between text-sm mb-2">
              <span class="text-gray-300">Lun - Vie:</span>
              <span class="text-white font-medium">8:00 - 20:00</span>
            </div>
            <div class="flex justify-between text-sm mb-2">
              <span class="text-gray-300">Sábados:</span>
              <span class="text-white font-medium">9:00 - 14:00</span>
            </div>
            <div class="flex justify-between text-sm text-pink-400 font-bold">
              <span>Domingos:</span>
              <span>Cerrado</span>
            </div>
          </div>
        </div>

      </div>

      <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-gray-500 text-xs">
          © {new Date().getFullYear()} Clínica Pediátrica. Todos los derechos reservados.
        </p>
        <div class="flex gap-6 text-xs text-gray-500">
          <a href="/privacidad" class="hover:text-white transition-colors">Política de Privacidad</a>
          <a href="/terminos" class="hover:text-white transition-colors">Términos de Servicio</a>
        </div>
      </div>
    </div>
    
    <div class="h-1.5 w-full bg-[linear-gradient(to_right,#E61E8D,#E6332A,#F19120,#FCBD11,#92278F,#8DC63F,#0054A6,#2B3990,#F15A24,#44B5E6)] mt-8"></div>
  </footer>
</body>
</Layout>