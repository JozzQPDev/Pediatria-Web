---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../data/siteConfig";
import ContactForm from "../components/ContactForm";
---

<Layout
  title="Reserva tu Cita"
  description="Agenda una cita médica para tu hijo en nuestra clínica pediátrica en Huamanga, Ayacucho. Atención especializada con amor y profesionalismo."
>
  <main class="main-section">
    <!-- Nubes decorativas -->
    <span class="cloud cloud--1" aria-hidden="true"></span>
    <span class="cloud cloud--2" aria-hidden="true"></span>
    <span class="cloud cloud--3" aria-hidden="true"></span>
    <span class="cloud cloud--4" aria-hidden="true"></span>
    <span class="cloud cloud--5" aria-hidden="true"></span>
    <span class="cloud cloud--6" aria-hidden="true"></span>
    <span class="cloud cloud--7" aria-hidden="true"></span>
    <span class="cloud cloud--8" aria-hidden="true"></span>

    <!-- Hero Section -->
    <section class="relative py-12 md:py-16">
      <div class="max-w-6xl mx-auto px-5">
        <!-- HERO LIMPIO -->
        <div class="text-center mb-10">
          <!-- Badge simple -->
          <span
            class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-pink-50 border border-pink-200 mb-5"
          >
            <span class="w-2 h-2 rounded-full bg-pink-500"></span>
            <span class="text-sm font-medium text-pink-600"
              >Atención Pediátrica de Calidad</span
            >
          </span>

          <!-- Título limpio -->
          <h1 class="text-3xl md:text-4xl font-bold text-gray-800 mb-3">
            Reserva la <span class="text-pink-500">Cita Médica</span> de tu Hijo
          </h1>

          <!-- Subtítulo simple -->
          <p class="text-gray-500 text-base md:text-lg max-w-xl mx-auto">
            Agenda fácilmente una consulta pediátrica con nuestros
            especialistas.
          </p>
        </div>

        <!-- GRID 1:2 - Info | Formulario con animación escalonada -->
        <div class="grid lg:grid-cols-3 gap-6 lg:gap-10 items-start">
          <!-- INFORMACIÓN -->
          <div class="space-y-4">
            <!-- HORARIOS -->
            <div
              class="group rounded-2xl p-5 border border-pink-100 hover:-translate-y-1 transition-all duration-300 reveal-left"
            >
              <div class="flex items-center gap-3 mb-3">
                <div
                  class="w-12 h-12 bg-linear-to-br from-pink-400 to-pink-600 rounded-xl flex items-center justify-center shadow-md"
                >
                  <i data-lucide="clock" class="w-6 h-6 text-white"></i>
                </div>

                <div>
                  <h3 class="font-semibold text-gray-800">
                    Horarios de Atención
                  </h3>
                  <p class="text-gray-400 text-xs">
                    Consulta nuestros horarios
                  </p>
                </div>
              </div>

              <ul class="text-sm space-y-1 text-gray-600">
                <li class="flex justify-between">
                  <span>Lun - Vie</span>
                  <span class="font-semibold text-pink-600">08:00 - 20:00</span>
                </li>

                <li class="flex justify-between">
                  <span>Sábados</span>
                  <span class="font-semibold text-pink-600">09:00 - 14:00</span>
                </li>

                <li class="flex justify-between text-red-600 font-semibold">
                  <span>Emergencias</span>
                  <span>24 Horas</span>
                </li>
              </ul>
            </div>

            <!-- UBICACIÓN -->
            <div
              class="group rounded-2xl p-5 border border-blue-100 hover:-translate-y-1 transition-all duration-300 reveal-left stagger-1"
            >
              <div class="flex items-center gap-3 mb-3">
                <div
                  class="w-12 h-12 bg-linear-to-br from-blue-400 to-blue-600 rounded-xl flex items-center justify-center shadow-md"
                >
                  <i data-lucide="map-pin" class="w-6 h-6 text-white"></i>
                </div>

                <div>
                  <h3 class="font-semibold text-gray-800">Ubicación</h3>
                  <p class="text-gray-400 text-xs">Encuéntranos fácil</p>
                </div>
              </div>

              <p class="text-gray-600 text-sm mb-3">
                {siteConfig.location.fullAddress}
              </p>

              <a
                href={siteConfig.location.googleMapsLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-blue-600 text-sm font-semibold hover:text-blue-700 transition"
              >
                Ver en Maps
                <i data-lucide="arrow-right" class="w-4 h-4"></i>
              </a>
            </div>

            <!-- CONSEJO -->
            <div
              class="flex gap-3 items-start bg-pink-50 border border-pink-100 rounded-xl p-4 reveal-left stagger-2"
            >
              <i data-lucide="info" class="w-5 h-5 text-pink-500 mt-1"></i>

              <p class="text-sm text-gray-600 leading-relaxed">
                Llega <strong class="text-pink-600">15 minutos antes</strong> y trae
                <strong>DNI del padre/tutor</strong> y <strong
                  >informes médicos previos</strong
                >.
              </p>
            </div>
          </div>

          <!-- FORMULARIO (2 partes) -->
          <div class="lg:col-span-2">
            <div
              class="bg-white rounded-[2.5rem] border border-pink-200 overflow-hidden reveal-right"
            >
              <!-- Barra decorativa mejorado -->
              <div
                class="h-2 bg-linear-to-r from-pink-400 via-rose-500 to-pink-400"
              >
              </div>

              <div class="p-6 md:p-8 lg:p-10">
                <!-- Header del formulario mejorado -->
                <div class="flex items-center gap-5 mb-8">
                  <div
                    class="w-16 h-16 bg-linear-to-br from-pink-400 to-pink-600 rounded-2xl flex items-center justify-center shrink-0 shadow-lg shadow-pink-200/50"
                  >
                    <i data-lucide="calendar-check" class="w-8 h-8 text-white"
                    ></i>
                  </div>
                  <div>
                    <h3 class="text-2xl lg:text-3xl font-black text-gray-800">
                      Agenda tu Cita
                    </h3>
                    <p class="text-gray-400 font-medium">
                      Completa el formulario y te contactaremos en breve
                    </p>
                  </div>
                </div>
                <ContactForm
                  client:load
                  email={siteConfig.contact.email}
                  whatsappNumber={siteConfig.contact.whatsapp}
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de ayuda adicional -->
    <section class="relative py-12">
      <div class="max-w-4xl mx-auto px-5 text-center">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 bg-white rounded-full shadow-md mb-6"
        >
          <i data-lucide="phone-call" class="w-4 h-4 text-pink-500"></i>
          <span class="text-gray-600 font-medium text-sm"
            >¿Prefieres hablar con nosotros?</span
          >
        </div>
        <h3 class="text-2xl font-bold text-gray-800 mb-4">
          Estamos aquí para ayudarte
        </h3>
        <p class="text-gray-500 mb-6">
          Si tienes alguna duda sobre el proceso de reserva, no dudes en
          llamarnos
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={`tel:${siteConfig.contact.phone}`}
            class="inline-flex items-center justify-center gap-2 bg-pink-500 hover:bg-pink-600 text-white px-8 py-3 rounded-2xl font-bold transition-all hover:shadow-lg hover:shadow-pink-200/50"
          >
            <i data-lucide="phone" class="w-5 h-5"></i>
            Llamar ahora
          </a>
          <a
            href={siteConfig.contact.whatsappUrl}
            target="_blank"
            class="inline-flex items-center justify-center gap-2 bg-green-500 hover:bg-green-600 text-white px-8 py-3 rounded-2xl font-bold transition-all hover:shadow-lg hover:shadow-green-200/50"
          >
            <i class="bi bi-whatsapp text-xl"></i>
            Escribir WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Animaciones personalizadas */
  .reveal-up {
    opacity: 0;
    transform: translateY(30px);
    animation: revealUp 0.8s ease forwards;
  }

  .reveal-left {
    opacity: 0;
    transform: translateX(-40px);
    animation: revealLeft 0.8s ease forwards;
  }

  .reveal-right {
    opacity: 0;
    transform: translateX(40px);
    animation: revealRight 0.8s ease forwards;
  }

  @keyframes revealUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes revealLeft {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes revealRight {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Stagger delays */
  .stagger-1 {
    animation-delay: 0.1s;
  }
  .stagger-2 {
    animation-delay: 0.2s;
  }

  /* Animaciones de flotación */
  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-20px) rotate(5deg);
    }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  .animate-float-delayed {
    animation: float 7s ease-in-out infinite 1s;
  }

  .animate-float-slow {
    animation: float 8s ease-in-out infinite 2s;
  }

  @keyframes pulse-delayed {
    0%,
    100% {
      opacity: 0.15;
    }
    50% {
      opacity: 0.3;
    }
  }

  .animate-pulse-delayed {
    animation: pulse-delayed 4s ease-in-out infinite 1s;
  }

  /* Reducir movimiento si el usuario lo prefiere */
  @media (prefers-reduced-motion: reduce) {
    .reveal-up,
    .reveal-left,
    .reveal-right {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .animate-float,
    .animate-float-delayed,
    .animate-float-slow,
    .animate-pulse-delayed {
      animation: none;
    }
  }
</style>
