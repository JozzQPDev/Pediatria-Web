---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../data/siteConfig";
import ContactForm from "../components/ContactForm";
---

<Layout
  title="Reserva tu Cita"
  description="Agenda una cita médica para tu hijo en nuestra clínica pediátrica en Huamanga, Ayacucho. Atención especializada con amor y profesionalismo."
>
  <main class="main-section">
    <!-- Nubes decorativas -->
    <span class="cloud cloud--1" aria-hidden="true"></span>
    <span class="cloud cloud--2" aria-hidden="true"></span>
    <span class="cloud cloud--3" aria-hidden="true"></span>
    <span class="cloud cloud--4" aria-hidden="true"></span>
    <span class="cloud cloud--5" aria-hidden="true"></span>
    <span class="cloud cloud--6" aria-hidden="true"></span>
    <span class="cloud cloud--7" aria-hidden="true"></span>
    <span class="cloud cloud--8" aria-hidden="true"></span>

    <!-- Hero Section Mejorado -->
    <section class="relative py-16 md:py-24 overflow-hidden">
      <!-- Elementos decorativos flotantes -->
      <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <div class="absolute top-20 left-[10%] animate-float opacity-30">
          <i data-lucide="heart" class="w-10 h-10 text-pink-400"></i>
        </div>
        <div class="absolute top-32 right-[15%] animate-float-delayed opacity-25">
          <i data-lucide="star" class="w-8 h-8 text-yellow-400"></i>
        </div>
        <div class="absolute bottom-32 left-[20%] animate-float-slow opacity-20">
          <i data-lucide="stethoscope" class="w-12 h-12 text-blue-400"></i>
        </div>
        <div class="absolute bottom-20 right-[10%] animate-float opacity-25">
          <i data-lucide="baby" class="w-10 h-10 text-green-400"></i>
        </div>
        <div class="absolute top-1/3 left-[5%] animate-pulse opacity-15">
          <i data-lucide="sparkles" class="w-6 h-6 text-purple-400"></i>
        </div>
        <div class="absolute top-1/2 right-[8%] animate-pulse-delayed opacity-15">
          <i data-lucide="heart-handshake" class="w-8 h-8 text-rose-400"></i>
        </div>
      </div>

      <div class="max-w-6xl mx-auto px-5 relative z-10">
        <!-- HERO MEJORADO -->
        <div class="text-center mb-12 reveal-up">
          <!-- Badge mejorado -->
          <span class="inline-flex items-center gap-2 px-5 py-2 rounded-full bg-gradient-to-r from-pink-100 to-purple-100 border border-pink-200/50 shadow-md mb-6">
            <span class="w-2.5 h-2.5 rounded-full bg-pink-500 animate-pulse"></span>
            <span class="text-sm font-bold text-pink-600 uppercase tracking-wider">Atención Pediátrica de Calidad</span>
          </span>

          <!-- Título con gradiente -->
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-gray-800 mb-4 leading-tight">
            Reserva la 
            <span class="bg-gradient-to-r from-pink-500 via-rose-500 to-pink-400 bg-clip-text text-transparent">
              Cita Médica
            </span>
            <br class="md:hidden" />
            de tu Hijo
          </h1>

          <!-- Subtítulo mejorado -->
          <p class="text-gray-500 text-lg md:text-xl max-w-2xl mx-auto leading-relaxed">
            Agenda fácilmente una consulta pediátrica con nuestros especialistas. 
            <strong class="text-pink-500">Tu hijo merece la mejor atención.</strong>
          </p>
        </div>

        <!-- GRID 1:2 - Info | Formulario con animación escalonada -->
        <div class="grid lg:grid-cols-3 gap-6 lg:gap-10 items-start">
          <!-- INFORMACIÓN (1 parte) -->
          <div class="space-y-5">
            <!-- HORARIO - Tarjeta mejorada -->
            <div class="group bg-white rounded-3xl p-6 border border-gray-100 shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 reveal-left">
              <div class="flex items-center gap-4 mb-4">
                <div class="w-14 h-14 bg-gradient-to-br from-pink-400 to-pink-600 rounded-2xl flex items-center justify-center shrink-0 shadow-lg shadow-pink-200/50">
                  <i data-lucide="clock" class="w-7 h-7 text-white"></i>
                </div>
                <div>
                  <h3 class="font-bold text-gray-800 text-lg">Horarios de Atención</h3>
                  <p class="text-gray-400 text-sm">Consulta nuestros horarios</p>
                </div>
              </div>
              <div class="space-y-3">
                <div class="flex justify-between items-center p-3 bg-pink-50/50 rounded-xl">
                  <span class="text-gray-600 font-medium">Lun - Vie</span>
                  <span class="text-pink-600 font-bold">08:00 - 20:00</span>
                </div>
                <div class="flex justify-between items-center p-3 bg-pink-50/50 rounded-xl">
                  <span class="text-gray-600 font-medium">Sábados</span>
                  <span class="text-pink-600 font-bold">09:00 - 14:00</span>
                </div>
                <div class="flex justify-between items-center p-3 bg-red-50/50 rounded-xl border border-red-100">
                  <span class="text-red-600 font-bold">Emergencias</span>
                  <span class="text-red-600 font-bold">24 Horas</span>
                </div>
              </div>
            </div>

            <!-- UBICACIÓN - Tarjeta mejorada -->
            <div class="group bg-white rounded-3xl p-6 border border-gray-100 shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 reveal-left stagger-1">
              <div class="flex items-center gap-4 mb-4">
                <div class="w-14 h-14 bg-gradient-to-br from-blue-400 to-blue-600 rounded-2xl flex items-center justify-center shrink-0 shadow-lg shadow-blue-200/50">
                  <i data-lucide="map-pin" class="w-7 h-7 text-white"></i>
                </div>
                <div>
                  <h3 class="font-bold text-gray-800 text-lg">Ubicación</h3>
                  <p class="text-gray-400 text-sm">Encuéntranos fácil</p>
                </div>
              </div>
              <p class="text-gray-600 mb-4 font-medium">
                {siteConfig.location.fullAddress}
              </p>
              <a href={siteConfig.location.googleMapsLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-blue-600 font-bold hover:text-blue-700 transition group/link">
                Ver en Maps
                <i data-lucide="arrow-right" class="w-4 h-4 group-hover/link:translate-x-1 transition-transform"></i>
              </a>
            </div>

            <!-- CONSEJO - Tarjeta mejorada -->
            <div class="group bg-gradient-to-br from-pink-50 via-purple-50 to-pink-100/30 rounded-3xl p-6 border border-pink-200/50 shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-300 reveal-left stagger-2">
              <div class="flex items-center gap-4 mb-3">
                <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center shrink-0 shadow-md">
                  <i data-lucide="info" class="w-7 h-7 text-pink-500"></i>
                </div>
                <div>
                  <h3 class="font-bold text-gray-800 text-lg">Primera visita</h3>
                  <p class="text-pink-400 text-sm">Información importante</p>
                </div>
              </div>
              <p class="text-gray-600 leading-relaxed">
                Llega <strong class="text-pink-600">15 minutos antes</strong>. 
                Trae el <strong>DNI del padre/tutor</strong> y <strong>informes médicos previos</strong> de tu pequeño.
              </p>
              <!-- Decoración -->
              <div class="absolute -right-4 -top-4 w-20 h-20 bg-pink-200/30 rounded-full blur-xl"></div>
            </div>
          </div>

          <!-- FORMULARIO (2 partes) -->
          <div class="lg:col-span-2">
            <div class="bg-white rounded-[2.5rem] shadow-2xl border border-pink-100/50 overflow-hidden reveal-right">
              <!-- Barra decorativa mejorado -->
              <div class="h-2 bg-gradient-to-r from-pink-400 via-rose-500 to-pink-400"></div>
              
              <!-- Decorative corner accents -->
              <div class="absolute top-0 right-0 w-24 h-24 bg-gradient-to-bl from-pink-100/50 to-transparent rounded-bl-3xl"></div>
              <div class="absolute bottom-0 left-0 w-24 h-24 bg-gradient-to-tr from-pink-100/50 to-transparent rounded-tr-3xl"></div>
              
              <div class="p-6 md:p-8 lg:p-10">
                <!-- Header del formulario mejorado -->
                <div class="flex items-center gap-5 mb-8">
                  <div class="w-16 h-16 bg-gradient-to-br from-pink-400 to-pink-600 rounded-2xl flex items-center justify-center shrink-0 shadow-lg shadow-pink-200/50">
                    <i data-lucide="calendar-check" class="w-8 h-8 text-white"></i>
                  </div>
                  <div>
                    <h3 class="text-2xl lg:text-3xl font-black text-gray-800">Agenda tu Cita</h3>
                    <p class="text-gray-400 font-medium">Completa el formulario y te contactaremos en breve</p>
                  </div>
                </div>

                <!-- Decoración de pasos -->
                <div class="flex items-center gap-3 mb-8 pb-6 border-b border-gray-100">
                  <div class="flex items-center justify-center w-8 h-8 bg-pink-100 text-pink-600 rounded-full font-bold text-sm">1</div>
                  <span class="text-gray-500 text-sm">Completa tus datos</span>
                  <i data-lucide="arrow-right" class="w-4 h-4 text-gray-300"></i>
                  <div class="flex items-center justify-center w-8 h-8 bg-gray-100 text-gray-400 rounded-full font-bold text-sm">2</div>
                  <span class="text-gray-400 text-sm">Elige método</span>
                  <i data-lucide="arrow-right" class="w-4 h-4 text-gray-300"></i>
                  <div class="flex items-center justify-center w-8 h-8 bg-gray-100 text-gray-400 rounded-full font-bold text-sm">3</div>
                  <span class="text-gray-400 text-sm">Envía tu solicitud</span>
                </div>

                <ContactForm
                  client:load
                  email={siteConfig.contact.email}
                  whatsappNumber={siteConfig.contact.whatsapp}
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de ayuda adicional -->
    <section class="relative py-12 bg-gradient-to-b from-pink-50/50 to-white">
      <div class="max-w-4xl mx-auto px-5 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white rounded-full shadow-md mb-6">
          <i data-lucide="phone-call" class="w-4 h-4 text-pink-500"></i>
          <span class="text-gray-600 font-medium text-sm">¿Prefieres hablar con nosotros?</span>
        </div>
        <h3 class="text-2xl font-bold text-gray-800 mb-4">Estamos aquí para ayudarte</h3>
        <p class="text-gray-500 mb-6">Si tienes alguna duda sobre el proceso de reserva, no dudes en llamarnos</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={`tel:${siteConfig.contact.phone}`} class="inline-flex items-center justify-center gap-2 bg-pink-500 hover:bg-pink-600 text-white px-8 py-3 rounded-2xl font-bold transition-all hover:shadow-lg hover:shadow-pink-200/50">
            <i data-lucide="phone" class="w-5 h-5"></i>
            Llamar ahora
          </a>
          <a href={siteConfig.contact.whatsappUrl} target="_blank" class="inline-flex items-center justify-center gap-2 bg-green-500 hover:bg-green-600 text-white px-8 py-3 rounded-2xl font-bold transition-all hover:shadow-lg hover:shadow-green-200/50">
            <i class="bi bi-whatsapp text-xl"></i>
            Escribir WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Animaciones personalizadas */
  .reveal-up {
    opacity: 0;
    transform: translateY(30px);
    animation: revealUp 0.8s ease forwards;
  }

  .reveal-left {
    opacity: 0;
    transform: translateX(-40px);
    animation: revealLeft 0.8s ease forwards;
  }

  .reveal-right {
    opacity: 0;
    transform: translateX(40px);
    animation: revealRight 0.8s ease forwards;
  }

  @keyframes revealUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes revealLeft {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes revealRight {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Stagger delays */
  .stagger-1 { animation-delay: 0.1s; }
  .stagger-2 { animation-delay: 0.2s; }

  /* Animaciones de flotación */
  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(5deg); }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  .animate-float-delayed {
    animation: float 7s ease-in-out infinite 1s;
  }

  .animate-float-slow {
    animation: float 8s ease-in-out infinite 2s;
  }

  @keyframes pulse-delayed {
    0%, 100% { opacity: 0.15; }
    50% { opacity: 0.3; }
  }

  .animate-pulse-delayed {
    animation: pulse-delayed 4s ease-in-out infinite 1s;
  }

  /* Reducir movimiento si el usuario lo prefiere */
  @media (prefers-reduced-motion: reduce) {
    .reveal-up,
    .reveal-left,
    .reveal-right {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .animate-float,
    .animate-float-delayed,
    .animate-float-slow,
    .animate-pulse-delayed {
      animation: none;
    }
  }
</style>

