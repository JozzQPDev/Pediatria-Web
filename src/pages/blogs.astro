---
import Layout from "../layouts/Layout.astro";

import TitleSection from "../components/blogs/TitleSection.astro";
import FeaturedPost from "../components/blogs/FeaturedPost.astro";
import CategoriesFilter from "../components/blogs/CategoriesFilter.astro";
import BlogGrid from "../components/blogs/BlogGrid.astro";
import NewsletterSection from "../components/blogs/NewsletterSection.astro";
import TagsCloud from "../components/blogs/TagsCloud.astro";
import CTASection from "../components/blogs/CTASection.astro";

import { blogPosts, getAllCategories, getAllTags } from "../data/blogPosts";

const categories = getAllCategories();
const tags = getAllTags();
const normalizedBlogPosts = blogPosts.map(post => ({
  ...post,
  author: post.author || 'Dr. Amalia Fernández'
}));
const recentPosts = blogPosts.slice(0, 3).map(post => ({
  ...post,
  author: post.author || 'Dr. Amalia Fernández'
}));

---

<Layout 
  title="Blog | Consejos y Artículos de Salud Infantil"
  description="Descubre artículos informativos sobre salud infantil, desarrollo, nutrición y cuidados para tus hijos."
>

  <!-- Sección de propósito: Grid con imágenes y texto -->
  <main class="main-section">
  <span class="cloud cloud--1" aria-hidden="true"></span>
  <span class="cloud cloud--2" aria-hidden="true"></span>
  <span class="cloud cloud--3" aria-hidden="true"></span>
  <span class="cloud cloud--4" aria-hidden="true"></span>
  <span class="cloud cloud--5" aria-hidden="true"></span>
  <span class="cloud cloud--6" aria-hidden="true"></span>
  <span class="cloud cloud--7" aria-hidden="true"></span>
  <span class="cloud cloud--8" aria-hidden="true"></span>
  <span class="cloud cloud--9" aria-hidden="true"></span>
  <span class="cloud cloud--10" aria-hidden="true"></span>
  <span class="cloud cloud--11" aria-hidden="true"></span>
  <span class="cloud cloud--12" aria-hidden="true"></span>


    <TitleSection />
    <FeaturedPost featuredPost={recentPosts[0]} />
    <CategoriesFilter categories={categories} />
    <BlogGrid blogPosts={normalizedBlogPosts} />
    <!-- <NewsletterSection />
    <TagsCloud tags={tags} />-->
    <CTASection />
  </main>
</Layout>

<script>
  import { initBlogFilter } from '../scripts/blogFilter.ts';
  initBlogFilter();
</script>
