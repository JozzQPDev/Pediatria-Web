---
// Tu código de importaciones permanece igual
import { siteConfig } from "../data/siteConfig";
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';

const valores = [
  {
    title: "Innovación Médica",
    desc: "Equipamiento de última generación para diagnósticos precisos desde el primer día.",
    icon: "microscope",
    image: "/images/value-innovation.jpg"
  },
  {
    title: "Trato Humano",
    desc: "Un entorno diseñado para que los niños se sientan en confianza, como en casa.",
    icon: "heart",
    image: "/images/value-care.jpg"
  },
  {
    title: "Seguridad Infantil",
    desc: "Instalaciones bajo estándares internacionales de seguridad pediátrica.",
    icon: "shield-check",
    image: "/images/value-safety.jpg"
  },
  {
    title: "Compromiso Familiar",
    desc: "Acompañamos a los padres en cada etapa del desarrollo de sus hijos.",
    icon: "users",
    image: "/images/value-family.jpg"
  }
];

const galleryImages = [
  "/images/clinic-1.jpg", "/images/clinic-2.jpg", "/images/clinic-3.jpg"
];
---

<Layout title="Nuestra Propuesta | Ya Abiertos">
  <!-- Hero con imagen de fondo y elementos decorativos -->
  <Hero 
    title="Un nuevo concepto en salud infantil" 
    subtitle="Abrimos nuestras puertas para ofrecer a tu familia la atención médica que siempre soñaste: moderna, humana y especializada." 
    backgroundImage="/img/hero-nosotros.jpg"
    sideImage="/img/hero-nosotros.jpg"
    />

<!-- Sección de propósito: Grid con imágenes y texto -->
  <section class="py-24 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="relative reveal-left">

          <div class="absolute -top-10 -left-10 w-64 h-64 bg-green-50 rounded-full blur-3xl"></div>
          <div class="relative z-10">
            <img 
              src="https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&q=80&w=800" 
              alt="Nuestra nueva clínica" 
              class="rounded-3xl shadow-2xl border border-gray-100"
              loading="lazy"
            />
            <div class="absolute -bottom-6 -right-6 bg-yellow-500 p-8 rounded-3xl text-white z-20 shadow-xl animate-bounce-soft">
              <p class="text-xs font-bold uppercase tracking-widest opacity-80 mb-1">Estamos listos</p>
              <p class="text-2xl font-bold">¡Te Esperamos!</p>
            </div>
          </div>
        </div>

        <div class="space-y-8 reveal-right">
          <div>
            <span class="text-yellow-500 font-bold uppercase tracking-widest text-sm animate-bounce-soft inline-block">Nuestro Propósito</span>
            <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mt-4 leading-tight italic">
              Diseñamos la clínica <br/> <span class="text-yellow-500 not-italic">que tus hijos merecen</span>
            </h2>
          </div>
          <p class="text-lg text-gray-600 leading-relaxed animate-slide-up" style="animation-delay: 0.2s;"> 
            La <strong> {siteConfig.name}</strong> nace con el objetivo 
            de ser el centro de referencia en salud infantil. 
            Priorizamos la seguridad y el bienestar emocional 
            en cada uno de nuestros espacios. </p>
          <div class="grid grid-cols-3 gap-4">
            {galleryImages.map((image, index) => (
              <img src={image} alt={`Vista de la clínica ${index + 1}`} class="rounded-2xl shadow-lg hover:scale-105 transition-transform reveal stagger-${index + 1}" loading="lazy" />
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Sección de valores: Cards con imágenes y overlays -->
  <section class="py-24 bg-gray-50 rounded-t-3xl lg:rounded-t-5xl">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-16 reveal">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4 tracking-tight italic">¿Por qué confiar <br/><span class="text-yellow-500 not-italic">en nosotros?</span></h2>
        <p class="text-gray-500 max-w-2xl mx-auto text-lg leading-relaxed">Combinamos excelencia médica con un entorno cálido y profesional.</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {valores.map((v, index) => (
          <div class="group relative overflow-hidden rounded-3xl shadow-lg hover:shadow-2xl transition-all duration-500 cursor-pointer focus-within:ring-2 focus-within:ring-green-500 reveal stagger-${index + 1} hover-lift card-shine" role="article" aria-label={`Valor: ${v.title}`}>

            <img src={v.image} alt={`Imagen de ${v.title}`} class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            <div class="absolute inset-0 bg-linear-to-t from-green-600/90 to-transparent opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-500 flex flex-col justify-end p-6">
              <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-green-600 mb-4 group-hover:animate-bounce">
                <i data-lucide={v.icon} class="w-7 h-7" aria-hidden="true"></i>
              </div>
              <h3 class="text-xl font-bold text-white mb-2">{v.title}</h3>
              <p class="text-green-100 text-sm">{v.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-20 text-center reveal">
        <p class="text-gray-500 mb-6">Conoce cómo podemos cuidar de tus hijos</p>
        <a href="/servicios" class="inline-flex items-center gap-2 text-yellow-500 font-bold text-lg hover:gap-4 hover:text-yellow-600 transition-all animate-float" aria-label="Explorar especialidades">
          Explorar nuestras especialidades
          <i data-lucide="arrow-right" class="w-6 h-6" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Intersection Observer for scroll-triggered animations
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.1
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('active');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  // Observe all elements with reveal classes
  document.addEventListener('DOMContentLoaded', () => {
    const revealElements = document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale');
    revealElements.forEach(el => observer.observe(el));
  });
</script>


<style>
  /* Animaciones para tema infantil */
  @keyframes bounce-soft {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-5px); }
    60% { transform: translateY(-2px); }
  }
  .animate-bounce-soft {
    animation: bounce-soft 2s infinite;
  }
</style>
