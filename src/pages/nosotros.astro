---
// Tu código de importaciones permanece igual
import { siteConfig } from "../data/siteConfig";
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';

// 1. Definimos los tipos TypeScript
type ColorKey = 'blue' | 'pink' | 'green' | 'purple';

interface ColorClasses {
  ring: string;
  from: string;
  fromWithOpacity: string;
  text100: string;
  text600: string;
}


// 2. Definimos el mapa de clases con el tipo adecuado (versiones pasteles)
const colorClasses: Record<ColorKey, ColorClasses> = {
  blue: {
    ring: 'focus-within:ring-blue-300',
    from: 'from-blue-300',
    fromWithOpacity: 'from-blue-300/80',
    text100: 'text-blue-50',
    text600: 'text-blue-400',
  },
  pink: {
    ring: 'focus-within:ring-pink-300',
    from: 'from-pink-300',
    fromWithOpacity: 'from-pink-300/80',
    text100: 'text-pink-50',
    text600: 'text-pink-400',
  },
  green: {
    ring: 'focus-within:ring-green-300',
    from: 'from-green-300',
    fromWithOpacity: 'from-green-300/80',
    text100: 'text-green-50',
    text600: 'text-green-400',
  },
  purple: {
    ring: 'focus-within:ring-purple-300',
    from: 'from-purple-300',
    fromWithOpacity: 'from-purple-300/80',
    text100: 'text-purple-50',
    text600: 'text-purple-400',
  }
};

const valores: Array<{
  title: string;
  desc: string;
  icon: string;
  image: string;
  color: ColorKey;
}> = [
  {
    title: "Innovación Médica",
    desc: "Equipamiento de última generación para diagnósticos precisos desde el primer día.",
    icon: "microscope",
    image: "/images/value-innovation.jpg",
    color: "blue"
  },
  {
    title: "Trato Humano",
    desc: "Un entorno diseñado para que los niños se sientan en confianza, como en casa.",
    icon: "heart",
    image: "/images/value-care.jpg",
    color: "pink"
  },
  {
    title: "Seguridad Infantil",
    desc: "Instalaciones bajo estándares internacionales de seguridad pediátrica.",
    icon: "shield-check",
    image: "/images/value-safety.jpg",
    color: "green"
  },
  {
    title: "Compromiso Familiar",
    desc: "Acompañamos a los padres en cada etapa del desarrollo de sus hijos.",
    icon: "users",
    image: "/images/value-family.jpg",
    color: "purple"
  }
];

const nosotrosvm = {
  vision: "Ser el hogar de salud donde cada niño crezca sano, pleno y feliz, transformando la experiencia médica en un momento de confianza y bienestar para toda la familia.",
  mision: `En ${siteConfig.name}, brindamos atención pediátrica integral de excelencia, combinando calidez humana con tecnología avanzada. Nos dedicamos a proteger la salud infantil en un entorno diseñado para que los más pequeños se sientan seguros, comprendidos y cuidados.`
};

const galleryImages = [
  "/images/clinic-4.jpg", "/images/clinic-5.jpg", "/images/clinic-6.jpg"
];
---

<Layout title="Sobre Nosotros" description="Conoce la historia, misión y visión de nuestra clínica pediátrica. Descubre cómo cuidamos de tus hijos con amor y profesionalismo.">

  <!-- Hero con imagen de fondo y elementos decorativos -->
  <Hero 
    title="Un nuevo concepto en salud infantil" 
    subtitle="Abrimos nuestras puertas para ofrecer a tu familia la atención médica que siempre soñaste: moderna, humana y especializada." 
    backgroundImage="/img/hero-nosotros.jpg"
    sideImage="/img/hero-nosotros.jpg"
  />

  <!-- Sección de propósito: Grid con imágenes y texto -->
  <main class="main-section">
    <span class="cloud cloud--1" aria-hidden="true"></span>
    <span class="cloud cloud--2" aria-hidden="true"></span>
    <span class="cloud cloud--3" aria-hidden="true"></span>
    <span class="cloud cloud--4" aria-hidden="true"></span>
    <span class="cloud cloud--5" aria-hidden="true"></span>

    <section class="py-24 relative z-10 overflow-hidden">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div class="relative reveal-left order-2 lg:order-1">
            <!-- Círculo decorativo de fondo -->
            <div class="absolute -top-10 -left-10 w-72 h-72 bg-pink-100 rounded-full blur-3xl opacity-60"></div>
            <div class="relative z-10">
              <img 
                src="images/clinic-prinspl.jpg" 
                alt="Nuestra nueva clínica" 
                class="rounded-4x1 shadow-2xl shadow-pink-200/50 border-4 border-white"
                loading="lazy"
              />
              <!-- Badge flotante -->
              <div class="absolute -bottom-8 -right-8 bg-white p-6 rounded-3xl text-gray-800 z-20 shadow-xl border border-pink-100 animate-bounce-soft max-w-50">
                <div class="flex items-center gap-3 mb-2">
                  <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
                  <p class="text-xs font-bold uppercase tracking-widest text-gray-400">Abierto</p>
                </div>
                <p class="text-xl font-bold text-gray-900">¡Te Esperamos!</p>
              </div>
            </div>
          </div>

          <div class="space-y-8 reveal-right order-1 lg:order-2">
            <div>
              <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-pink-50 text-pink-500 font-bold uppercase tracking-widest text-xs mb-4 animate-bounce-soft">
                <span class="w-2 h-2 rounded-full bg-pink-400"></span>
                Nuestro Propósito
              </span>
              <h2 class="text-4xl lg:text-5xl font-extrabold text-gray-900 mt-2 leading-tight">
                Diseñamos la clínica <br/> 
                <span class="text-transparent bg-clip-text bg-linear-to-r from-pink-400 to-purple-500 not-italic">
                  que tus hijos merecen
                </span>
              </h2>
            </div>
            <p class="text-lg text-gray-600 leading-relaxed animate-slide-up" style="animation-delay: 0.2s;"> 
              La <strong class="text-gray-900">{siteConfig.name}</strong> nace con el objetivo 
              de ser el centro de referencia en salud infantil. 
              Priorizamos la seguridad y el bienestar emocional 
              en cada uno de nuestros espacios. 
            </p>
            
            <!-- Grid de imágenes decorativo -->
            <div class="grid grid-cols-3 gap-3 pt-4">
              {galleryImages.map((image, index) => (
                <div class={`relative overflow-hidden rounded-2xl shadow-md hover:scale-105 transition-transform duration-300 reveal stagger-${index + 1} group`}>
                  <img 
                    src={image} 
                    alt={`Vista de la clínica ${index + 1}`} 
                    class="w-full h-24 object-cover" 
                    loading="lazy" 
                  />
                  <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors"></div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Visión y Misión -->
    <section class="py-24  relative z-10">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-16 reveal">
          <span class="text-pink-400 font-bold uppercase tracking-widest text-sm animate-bounce-soft inline-block">Nuestra Esencia</span>
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mt-4 tracking-tight">Visión y Misión</h2>
          <div class="w-24 h-1 bg-pink-200 mx-auto mt-6 rounded-full"></div>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <!-- Visión -->
          <div class="group bg-white rounded-4x1 p-10 shadow-xl shadow-pink-100/50 hover:shadow-2xl hover:shadow-pink-200/50 transition-all duration-500 reveal hover-lift border border-pink-50/50 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-pink-50 rounded-bl-full -mr-10 -mt-10 transition-transform group-hover:scale-110"></div>
            
            <div class="flex flex-row items-center gap-4 relative z-10">
              <div class="w-16 h-16 bg-linear-to-br from-pink-100 to-pink-50 rounded-2xl flex items-center justify-center text-pink-500 shadow-inner group-hover:animate-bounce">
                <i data-lucide="eye" class="w-8 h-8" aria-hidden="true"></i>
              </div>
              <h3 class="text-3xl font-bold text-gray-900">Visión</h3>
            </div>
            <p class="text-gray-600 leading-relaxed text-lg mt-8 font-medium">
              {nosotrosvm.vision}
            </p>
          </div>

          <!-- Misión -->
          <div class="group bg-white rounded-4x1 p-10 shadow-xl shadow-purple-100/50 hover:shadow-2xl hover:shadow-purple-200/50 transition-all duration-500 reveal hover-lift border border-purple-50/50 relative overflow-hidden" style="animation-delay: 0.2s;">
            <div class="absolute top-0 right-0 w-32 h-32 bg-purple-50 rounded-bl-full -mr-10 -mt-10 transition-transform group-hover:scale-110"></div>
            
            <div class="flex flex-row items-center gap-4 relative z-10">
              <div class="w-16 h-16 bg-linear-to-br from-purple-100 to-purple-50 rounded-2xl flex items-center justify-center text-purple-500 shadow-inner group-hover:animate-bounce">
                <i data-lucide="target" class="w-8 h-8" aria-hidden="true"></i>
              </div>
              <h3 class="text-3xl font-bold text-gray-900">Misión</h3>
            </div>
            <p class="text-gray-600 leading-relaxed text-lg mt-8 font-medium">
              {nosotrosvm.mision}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de valores: Cards con imágenes y overlays -->
    <section class="py-24 bg-gray-50 rounded-t-3xl lg:rounded-t-5xl">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-16 reveal">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4 tracking-tight italic">¿Por qué confiar <br/><span class="text-pink-400 not-italic">en nosotros?</span></h2>
          <p class="text-gray-500 max-w-2xl mx-auto text-lg leading-relaxed">Combinamos excelencia médica con un entorno cálido y profesional.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          {valores.map((v, index) => {
            const colors = colorClasses[v.color];
            return (
              <div 
                class={`group relative overflow-hidden rounded-3xl shadow-lg hover:shadow-2xl transition-all duration-500 cursor-pointer focus-within:ring-2 ${colors.ring} reveal stagger-${index + 1} hover-lift card-shine`} 
                role="article" 
                aria-label={`Valor: ${v.title}`}
              >
                <img 
                  src={v.image} 
                  alt={`Imagen de ${v.title}`} 
                  class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500" 
                  loading="lazy" 
                />
                <div class={`absolute inset-0 bg-linear-to-t ${colors.fromWithOpacity} to-transparent opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-500 flex flex-col justify-end p-6`}>


                  <div class={`w-14 h-14 bg-white rounded-2xl flex items-center justify-center ${colors.text600} mb-4 group-hover:animate-bounce`}>
                    <i data-lucide={v.icon} class="w-7 h-7" aria-hidden="true"></i>
                  </div>
                  <h3 class="text-xl font-bold text-white mb-2">{v.title}</h3>
                  <p class={`${colors.text100} text-sm`}>{v.desc}</p>
                </div>
              </div>
            );
          })}
        </div>

        <div class="mt-20 text-center reveal">
          <p class="text-gray-500 mb-6">Conoce cómo podemos cuidar de tus hijos</p>
          <a href="/servicios" class="inline-flex items-center gap-2 text-pink-400 font-bold text-lg hover:gap-4 hover:text-pink-500 transition-all animate-float" aria-label="Explorar especialidades">
            Explorar nuestras especialidades
            <i data-lucide="arrow-right" class="w-6 h-6" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  // Intersection Observer for scroll-triggered animations
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.1
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('active');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  // Observe all elements with reveal classes
  document.addEventListener('DOMContentLoaded', () => {
    const revealElements = document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale');
    revealElements.forEach(el => observer.observe(el));
  });
</script>

<style>
  /* Animaciones para tema infantil */
  @keyframes bounce-soft {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-5px); }
    60% { transform: translateY(-2px); }
  }
  .animate-bounce-soft {
    animation: bounce-soft 2s infinite;
  }
</style>
