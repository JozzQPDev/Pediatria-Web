---
import type { Doctor } from '../../scripts/doctor';
interface ColorStyles {  
  text: string;  
  bg: string;  
  fill: string;  
  border: string;  
  glow: string;  
}  

type DoctorColor = 'green' | 'blue' | 'yellow' | 'purple' | 'pink';  

interface Props {  
  specialists: Doctor[];  
  colorStyles: Record<DoctorColor, ColorStyles>;  
}  

const { specialists, colorStyles } = Astro.props as Props;  
---
<section class="py-20 md:py-32">
    <div class="max-w-7xl mx-auto px-5 md:px-6">

      <div class="text-center mb-20">
      <div data-aos="fade-down">
        <span class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-white text-slate-500 font-bold uppercase tracking-[0.2em] text-[10px] border border-slate-100 shadow-sm mb-6">
          <span class="flex gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-pink-400"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
           </span>
            Especialistas
        </span>
      </div>

      <h2 class="text-5xl lg:text-7xl font-black text-slate-900 leading-[1.1] tracking-tight" data-aos="fade-up">
         Nuestros  <br/>
        <span class="text-transparent bg-clip-text bg-linear-to-r from-pink-500 via-orange-400 to-blue-600 italic font-serif">Especialistas Asociados</span>
      </h2>

      <p class="mt-8 text-slate-500 max-w-2xl mx-auto text-lg font-medium leading-relaxed" data-aos="fade-up" data-aos-delay="100">
          Un equipo interdisciplinario que colabora diariamente para brindar una atención integral a cada paciente.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-2 gap-8 lg:gap-12">
      {specialists.map((doc) => (
        <div class="group relative bg-slate-50/50 rounded-[3rem] p-6 md:p-8 border border-slate-100 hover:bg-white hover:shadow-2xl hover:shadow-slate-200/60 transition-all duration-500">
          <div class="flex flex-col md:flex-row gap-8 items-center md:items-start">
            
            <div class="relative w-48 h-48 md:w-56 md:h-56 shrink-0 rounded-[2.5rem] overflow-hidden shadow-xl group-hover:-rotate-2 transition-transform duration-500">
              <img src={doc.image} alt={doc.name} class="w-full h-full object-cover" />
              <div class={`absolute inset-0 opacity-20 ${colorStyles[doc.color as DoctorColor].bg}`}></div>
            </div>

            <div class="flex-1 text-center md:text-left space-y-4">
              <div>
                <span class={`inline-block px-4 py-1 rounded-full ${colorStyles[doc.color as DoctorColor].bg} ${colorStyles[doc.color as DoctorColor].text} text-[10px] font-black uppercase tracking-widest mb-3`}>
                  {doc.role}
                </span>
                <h3 class="text-2xl md:text-3xl font-black text-slate-900 leading-tight">
                  {doc.name}
                </h3>
                <p class="text-slate-500 font-bold text-sm md:text-base mt-2">
                  {doc.specialty}
                </p>
              </div>

              <div class="flex flex-wrap justify-center md:justify-start gap-2">
                {doc.tags.map(tag => (
                  <span class="text-[10px] font-bold text-slate-400">
                    • {tag}
                  </span>
                ))}
              </div>

              <p class="text-slate-400 text-xs md:text-sm leading-relaxed">
                Comprometido con la excelencia médica y el trato humano que define a nuestro centro en Ayacucho.
              </p>

              <div class="flex justify-center md:justify-start gap-4 pt-2">
                <a href={doc.linkedin} class="text-slate-300 hover:text-blue-500 transition-colors">
                  <i class="fa-brands fa-linkedin text-xl"></i>
                </a>
                <a href={`mailto:${doc.email}`} class="text-slate-300 hover:text-pink-500 transition-colors">
                  <i class="fa-solid fa-envelope text-xl"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>