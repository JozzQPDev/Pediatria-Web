---
interface Service {
  icon: string;
  features: string[];
}

interface Props {
  service: Service;
  colors: {
    bgLight: string;
    text: string;
    icon?: string; 
  };
}

const { service, colors }: Props = Astro.props;
---

<section class="py-16 md:py-24 relative overflow-hidden">
  <div class="absolute inset-0 z-0 opacity-30 md:opacity-40" style="background-image: radial-gradient(#cbd5e1 1px, transparent 1px); background-size: 30px 30px;"></div>

  <div class="max-w-7xl mx-auto px-5 md:px-6 relative z-10">
    
    <div class="flex flex-col lg:flex-row items-start lg:items-end justify-between mb-12 md:mb-20 gap-6 md:gap-8">
      <div class="max-w-2xl">
        <div class={`inline-flex items-center gap-3 ${colors.bgLight} ${colors.text} px-4 py-2 md:px-5 md:py-2.5 rounded-2xl text-[10px] md:text-[11px] font-black uppercase tracking-[0.2em] mb-6 animate-fade-in`}>
          <span class="flex gap-1">
            <span class={`w-1.5 h-1.5 rounded-full ${colors.icon || 'bg-current'}`}></span>
            <span class={`w-1.5 h-1.5 rounded-full ${colors.icon || 'bg-current'}`}></span>
            <span class={`w-1.5 h-1.5 rounded-full ${colors.icon || 'bg-current'}`}></span>
          </span>
          <i class={`${service.icon} text-sm md:text-base`}></i>
          <span>Excelencia Médica</span>
        </div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-black text-slate-900 mb-4 tracking-tighter leading-[1.1]">
          Protocolos diseñados para la <span class={colors.text}>tranquilidad</span> de mamá y papá
        </h2>
      </div>
      
      <p class="text-base md:text-lg text-slate-500 font-medium max-w-sm pb-2 border-l-4 lg:border-l-2 border-slate-200 pl-5 lg:pl-6">
        Estándares internacionales adaptados al cuidado afectivo de cada paciente.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
      {service.features.map((feature, index) => (
        <div class="group relative bg-white p-7 md:p-10 rounded-[2.5rem] md:rounded-[3rem] border border-slate-100 shadow-sm hover:shadow-xl transition-all duration-500 md:hover:-translate-y-3 overflow-hidden">
          
          <span class="absolute top-6 right-8 text-5xl md:text-6xl font-black text-slate-100 opacity-10 md:opacity-[0.03] group-hover:opacity-[0.08] transition-opacity select-none italic">
            {index + 1 < 10 ? `0${index + 1}` : index + 1}
          </span>

          <div class={`w-14 h-14 md:w-16 md:h-16 ${colors.bgLight} ${colors.text} rounded-2xl md:rounded-3xl flex items-center justify-center mb-6 md:mb-8 group-hover:rotate-6 transition-all duration-500 shadow-sm`}>
            <i class="fa-solid fa-hand-holding-heart text-xl md:text-2xl"></i>
          </div>

          <div class="space-y-3 md:space-y-4">
            <h3 class="text-lg md:text-xl font-black text-slate-800 leading-tight group-hover:text-slate-950 transition-colors">
              {feature}
            </h3>
            
            <div class={`w-12 h-1.5 rounded-full ${colors.bgLight} overflow-hidden`}>
              <div class={`h-full ${colors.text.replace('text', 'bg')} w-full md:w-0 md:group-hover:w-full transition-all duration-700`}></div>
            </div>
            
            <p class="text-sm text-slate-500 md:text-slate-400 font-medium leading-relaxed opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-500">
              Garantizamos un seguimiento exhaustivo y profesional en este punto clave de atención pediátrica.
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>