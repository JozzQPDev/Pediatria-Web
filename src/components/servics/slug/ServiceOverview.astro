---
interface Service {
  icon: string;
  fullDesc: string;
  image: string;
  price: string;
  schedule: string;
  doctor: string;
  title: string;
}

interface Props {
  service: Service;
  colors: any;
}

const { service, colors }: Props = Astro.props;
---

<section class="py-12 md:py-24 relative z-10 overflow-hidden">
  <div class={`absolute -top-12 -left-12 md:-top-24 md:-left-24 w-48 h-48 md:w-96 md:h-96 ${colors.blob} opacity-5 blur-3xl rounded-full`}></div>

  <div class="max-w-7xl mx-auto px-4 md:px-6">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      
      <div class="lg:col-span-7 order-2 lg:order-1">
        <div class={`inline-flex items-center gap-3 ${colors.bgLight} ${colors.text} px-4 py-2 md:px-5 md:py-2.5 rounded-2xl text-[10px] md:text-[11px] font-black uppercase tracking-[0.2em] mb-6 md:mb-8 animate-fade-in`}>
          <span class="flex gap-1">
            <span class={`w-1 h-1 md:w-1.5 md:h-1.5 rounded-full ${colors.icon}`}></span>
            <span class={`w-1 h-1 md:w-1.5 md:h-1.5 rounded-full ${colors.icon}`}></span>
            <span class={`w-1 h-1 md:w-1.5 md:h-1.5 rounded-full ${colors.icon}`}></span>
          </span>
          <i class={`${service.icon} text-sm md:text-base`}></i>
          <span>Servicio Especializado</span>
        </div>
        
        <h2 class="text-4xl md:text-6xl lg:text-7xl font-black text-slate-900 mb-6 md:mb-8 tracking-tighter leading-[1.1] lg:leading-[0.95] text-balance">
          Atención integral para <span class="relative inline-block">
            <span class={colors.text}>tu pequeño</span>
            <svg class={`absolute -bottom-1 md:-bottom-2 left-0 w-full h-2 md:h-3 ${colors.text} opacity-20`} viewBox="0 0 100 10" preserveAspectRatio="none">
              <path d="M0 5 Q 25 0 50 5 T 100 5" fill="none" stroke="currentColor" stroke-width="4"></path>
            </svg>
          </span>
        </h2>
        
        <p class="text-lg md:text-xl text-slate-500 leading-relaxed mb-10 md:mb-12 font-medium max-w-2xl text-pretty">
          {service.fullDesc}
        </p>
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 md:gap-6">
          {[
            { icon: 'fa-solid fa-clock', label: 'Horarios', val: service.schedule },
            { icon: 'fa-solid fa-user-md', label: 'Especialista', val: service.doctor },
            { icon: 'fa-solid fa-calendar-check', label: 'Citas', val: 'Lunes a Sábado' }
          ].map(item => (
            <div class="group relative bg-white md:bg-white/60 backdrop-blur-sm p-4 md:p-6 rounded-2xl md:rounded-4xl border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300">
              
              <div class="flex sm:flex-col items-center sm:items-start gap-4 sm:gap-0">
                <div class={`shrink-0 inline-flex items-center justify-center w-10 h-10 md:w-12 md:h-12 rounded-xl md:rounded-2xl mb-0 sm:mb-4 bg-slate-50 ${colors.text} group-hover:scale-110 transition-transform`}>
                  <i class={`${item.icon} text-base md:text-lg`}></i>
                </div>

                <div class="min-w-0 flex-1"> <p class="text-[9px] md:text-[10px] font-black uppercase tracking-[0.15em] text-slate-400 mb-0.5 md:mb-1">
                    {item.label}
                  </p>
                  <p class="text-sm md:text-[15px] font-bold text-slate-800 leading-tight truncate sm:whitespace-normal group-hover:text-black transition-colors">
                    {item.val}
                  </p>
                </div>
              </div>

              <div class={`hidden md:block absolute top-0 right-0 p-4 opacity-0 group-hover:opacity-10 transition-opacity`}>
                <i class={`${item.icon} text-4xl`}></i>
              </div>
            </div>
          ))}
        </div>  
      </div>
      
      <div class="lg:col-span-5 relative order-1 lg:order-2">
        <div class="relative rounded-[3rem] md:rounded-[5rem] overflow-hidden shadow-xl md:shadow-[0_50px_100px_-20px_rgba(0,0,0,0.15)] group">
          <img 
            src={service.image} 
            alt={service.title}
            class="w-full h-87.5 md:h-125 lg:h-162.5 object-cover group-hover:scale-105 transition-transform duration-[2s] ease-out"
          />
          
          <div class="absolute inset-0 bg-linear-to-t from-slate-900/80 via-slate-900/10 to-transparent opacity-60"></div>
          
          <div class="absolute bottom-6 left-4 right-4 md:bottom-10 md:left-6 md:right-6">
            <div class="bg-white/90 backdrop-blur-xl p-6 md:p-8 rounded-4xl md:rounded-[3rem] border border-white/40 shadow-2xl">
              <div class="flex flex-col items-start gap-1">
                <p class="text-[9px] md:text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Inversión médica</p>
                <div class="flex items-baseline gap-1">
                  <span class="text-3xl md:text-4xl font-black text-slate-900">{service.price}</span>
                  <span class="text-slate-500 font-bold text-xs md:text-sm">/ sesión</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class={`hidden md:block absolute -bottom-10 -right-10 w-40 h-40 ${colors.bgLight} rounded-full -z-10 animate-pulse`}></div>
      </div>

    </div>
  </div>
</section>