---
interface Props {
  service: {
    title: string;
  };
  colors: {
    gradient: string;
    text: string;
  };
}

const { service, colors } = Astro.props;
---

<section class={`py-16 md:py-24 bg-linear-to-br ${colors.gradient} text-white relative overflow-hidden`}>
  <div class="absolute top-0 right-0 w-48 h-48 md:w-64 md:h-64 bg-white/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
  <div class="absolute bottom-0 left-0 w-32 h-32 md:w-48 md:h-48 bg-black/10 rounded-full blur-2xl translate-y-1/2 -translate-x-1/2"></div>

  <div class="max-w-5xl mx-auto px-5 md:px-6 text-center relative z-10">
    <h2 class="text-3xl md:text-5xl font-black mb-6 tracking-tighter leading-[1.1] text-balance">
      ¿Listo para agendar <br class="md:hidden"> su <span class="text-white/80 italic">primera cita?</span>
    </h2>
    
    <p class="text-white/90 text-base md:text-xl mb-10 max-w-2xl mx-auto font-medium leading-relaxed px-2">
      En <strong class="text-white">Dharma</strong>, cada pequeño detalle cuenta para la salud de tu hijo. Comienza hoy mismo con la <strong>Dra. Amalia Luque</strong>.
    </p>
    
    <div class="flex flex-col sm:flex-row gap-4 md:gap-5 justify-center items-center">
      <a 
        href="/reserva" 
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-white text-slate-900 px-8 md:px-10 py-4 md:py-5 rounded-2xl font-black text-base md:text-lg hover:bg-slate-50 md:hover:scale-105 md:hover:-translate-y-1 transition-all shadow-xl group"
      >
        <i class="fa-brands fa-whatsapp text-xl md:text-2xl group-hover:rotate-12 transition-transform"></i>
        Agendar por WhatsApp
      </a>

      <a 
        href="/contacto"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-white/10 backdrop-blur-md text-white px-8 md:px-10 py-4 md:py-5 rounded-2xl font-bold text-base md:text-lg hover:bg-white/20 transition-all border border-white/30"
      >
        <i class="fa-solid fa-location-dot"></i>
        Ver Ubicación
      </a>
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-center gap-x-8 gap-y-4 text-white/70 text-[9px] md:text-[10px] font-black uppercase tracking-[0.2em]">
       <span class="flex items-center gap-2">
         <i class="fa-solid fa-check-double text-[12px]"></i> Atención Inmediata
       </span>
       <span class="flex items-center gap-2">
         <i class="fa-solid fa-shield-heart text-[12px]"></i> Seguridad Garantizada
       </span>
    </div>
  </div>
</section>