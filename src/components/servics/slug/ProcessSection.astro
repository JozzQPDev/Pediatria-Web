---
interface Service {
  icon: string;
  process: Array<{
    step: number;
    title: string;
    desc: string;
  }>;
}

interface Props {
  service: Service;
  colors: {
    bgLight: string;
    text: string;
    icon?: string;
  };
}

const { service, colors }: Props = Astro.props;
---

<section class="py-16 md:py-32 relative overflow-hidden">
  <div class={`absolute top-0 right-0 w-64 h-64 md:w-96 md:h-96 ${colors.bgLight} opacity-20 blur-[80px] md:blur-[100px] rounded-full -translate-y-1/2 translate-x-1/4`}></div>

  <div class="max-w-7xl mx-auto px-5 md:px-6 relative z-10">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 md:mb-24 gap-6 md:gap-8">
      <div class="max-w-2xl">
        <div class={`inline-flex items-center gap-3 ${colors.bgLight} ${colors.text} px-4 py-2 md:px-5 md:py-2.5 rounded-2xl text-[10px] md:text-[11px] font-black uppercase tracking-[0.2em] mb-6 md:mb-8 animate-fade-in`}>
          <span class="flex gap-1">
            <span class={`w-1.5 h-1.5 rounded-full ${colors.icon || 'bg-current'}`}></span>
            <span class={`w-1.5 h-1.5 rounded-full ${colors.icon || 'bg-current'}`}></span>
            <span class={`w-1.5 h-1.5 rounded-full ${colors.icon || 'bg-current'}`}></span>
          </span>
          <i class={`${service.icon} text-sm md:text-base`}></i>
          <span>Metodología Dharma</span>
        </div>
        <h2 class="text-3xl md:text-5xl lg:text-6xl font-black text-slate-900 tracking-tighter leading-[1.1] md:leading-none">
          Tu camino hacia el <br class="hidden md:block"/> <span class={colors.text}>bienestar infantil</span>
        </h2>
      </div>
      <p class="text-base md:text-lg text-slate-500 font-medium max-w-sm pb-2 border-l-4 md:border-l-2 border-slate-200 pl-5 md:pl-6">
        Diseñamos cada etapa para que tanto tú como tu pequeño se sientan seguros y acompañados.
      </p>
    </div>

    <div class="relative">
      <div class="absolute left-1/2 top-0 bottom-0 w-0.5 bg-slate-100 hidden md:block -translate-x-1/2">
        <div class={`h-full w-full bg-linear-to-b from-transparent via-current to-transparent opacity-20 ${colors.text}`}></div>
      </div>

      <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-slate-100 md:hidden"></div>

      <div class="space-y-12 md:space-y-0">
        {service.process.map(({step, title, desc}, index) => (
          <div class={`flex flex-col md:flex-row items-start md:items-center justify-center w-full group ${index % 2 === 0 ? 'md:flex-row-reverse' : ''} relative`}>
            
            <div class="w-full md:w-1/2 pl-12 md:pl-0 flex justify-start md:justify-center">
              <div class="bg-white p-7 md:p-10 rounded-[2.5rem] md:rounded-[3.5rem] border border-slate-100 shadow-sm group-hover:shadow-xl transition-all duration-500 relative max-w-md md:group-hover:-translate-y-2">
                
                <div class={`md:hidden absolute -left-11 top-6 w-8 h-8 ${colors.bgLight} ${colors.text} rounded-lg flex items-center justify-center text-xs font-black shadow-md border-2 border-white z-20`}>
                  {step}
                </div>
                
                <h3 class="text-xl md:text-2xl font-black text-slate-800 mb-3 md:mb-4 tracking-tight group-hover:text-slate-950 transition-colors">
                  {title}
                </h3>
                <p class="text-sm md:text-base text-slate-500 leading-relaxed font-medium">
                  {desc}
                </p>
              </div>
            </div>

            <div class="hidden md:flex w-24 h-24 shrink-0 items-center justify-center relative z-10 mx-8">
              <div class={`absolute inset-0 ${colors.bgLight} rounded-4xl rotate-45 group-hover:rotate-90 transition-transform duration-700 opacity-30`}></div>
              <div class={`w-12 h-12 ${colors.bgLight} ${colors.text} rounded-xl flex items-center justify-center text-lg font-black shadow-lg border-2 border-white relative z-20`}>
                0{step}
              </div>
            </div>

            <div class="hidden md:block md:w-1/2"></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>