---
import { company } from "../../data/company";
import { services } from "../../data/services";

// Corregimos el error de TS definiendo la interfaz
interface ColorTheme {
  [key: string]: string; // Esta es la "signatura de índice" que faltaba
}

const colorMaps: ColorTheme = {
  green: "text-emerald-600 bg-emerald-50 shadow-emerald-100 ring-emerald-100",
  blue: "text-blue-600 bg-blue-50 shadow-blue-100 ring-blue-100",
  yellow: "text-amber-600 bg-amber-50 shadow-amber-100 ring-amber-100",
  pink: "text-pink-600 bg-pink-50 shadow-pink-100 ring-pink-100",
  purple: "text-purple-600 bg-purple-50 shadow-purple-100 ring-purple-100",
  teal: "text-teal-600 bg-teal-50 shadow-teal-100 ring-teal-100",
};
---

<section class="py-24  relative">
  <div class="max-w-7xl mx-auto px-6">
    <div class="space-y-20">
      {services.map((s, index) => {
        const isReverse = index % 2 !== 0;
        const theme = colorMaps[s.color] || colorMaps.blue;

        return (
          <article class="group relative" data-aos={isReverse ? "fade-left" : "fade-right"}>
            <span class={`absolute -top-10 ${isReverse ? '-left-5' : '-right-5'} text-[12rem] font-black text-slate-50 select-none z-0 opacity-50 group-hover:text-purple-50 transition-colors duration-700`}>
              0{index + 1}
            </span>

            <div class="relative z-10 bg-white rounded-[3.5rem] border border-slate-100 shadow-[0_30px_70px_rgba(0,0,0,0.04)] hover:shadow-[0_50px_100px_rgba(0,0,0,0.1)] transition-all duration-700 overflow-hidden">
              {/* Cambiamos min-h-[500px] por min-h-125 como sugirió el linter */}
              <div class="grid lg:grid-cols-12 items-stretch min-h-125">
                
                <div class={`lg:col-span-5 relative h-72 lg:h-auto overflow-hidden ${isReverse ? "lg:order-last" : ""}`}>
                  <img
                    src={s.image}
                    alt={s.title}
                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-[4s] ease-out group-hover:scale-110"
                  />
                  <div class="absolute inset-0 bg-linear-to-tr from-slate-900/40 via-transparent to-transparent"></div>
                  
                  {/* Floating Highlight */}
                  <div class={`absolute bottom-8 ${isReverse ? 'right-8' : 'left-8'} right-8`}>
                    <div class="glass-morphism p-4 rounded-2xl bg-white/20 backdrop-blur-xl border border-white/30 text-white max-w-60 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500 delay-100">
                      <p class="text-[10px] font-black uppercase tracking-widest mb-1 opacity-80">Plus del Servicio</p>
                      <p class="text-sm font-bold leading-tight">{s.features[0]}</p>
                    </div>
                  </div>
                </div>

                <div class="lg:col-span-7 p-8 lg:p-14 flex flex-col justify-center bg-linear-to-br from-white to-slate-50/50">
                  <div class="flex items-center gap-4 mb-6">
                    <div class={`w-14 h-14 rounded-2xl flex items-center justify-center text-xl ring-4 ring-offset-4 transition-all duration-500 group-hover:scale-110 group-hover:-rotate-3 ${theme}`}>
                      <i class={s.icon}></i>
                    </div>
                    <span class="text-xs font-black uppercase tracking-[0.3em] text-slate-400">{s.category}</span>
                  </div>

                  <h3 class="text-4xl lg:text-6xl font-black text-slate-900 tracking-tighter leading-none mb-6">
                    {s.title}
                  </h3>

                  <p class="text-slate-500 text-lg leading-relaxed font-medium mb-8 max-w-xl">
                    {s.shortDesc}
                  </p>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
                    {s.features.slice(1, 5).map((feature) => (
                      <div class="flex items-center gap-3 group/item">
                        <div class="w-2 h-2 rounded-full bg-purple-400 group-hover/item:scale-150 transition-transform"></div>
                        <span class="text-sm font-bold text-slate-600 group-hover/item:text-slate-900 transition-colors">{feature}</span>
                      </div>
                    ))}
                  </div>

                  <div class="mt-auto pt-8 border-t border-slate-100 flex flex-wrap items-center justify-between gap-6">
                    <div class="flex items-center gap-6">
                       <div>
                        <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Inversión</p>
                        <p class="text-3xl font-black text-slate-900 tracking-tight">{s.price}</p>
                      </div>
                      <div class="w-px h-10 bg-slate-200"></div> {/* w-[1px] -> w-px */}
                      <div>
                        <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Atención</p>
                        <p class="text-sm font-bold text-slate-700 leading-none mt-1">{s.schedule}</p>
                      </div>
                    </div>

                    <div class="grid grid-cols-2 gap-2 sm:flex sm:items-center sm:gap-4 mt-auto w-full">
                        <a 
                            href={`/servicios/${s.slug}`} 
                            class="group/btn inline-flex items-center justify-center gap-2 px-3 sm:px-8 py-4 rounded-2xl bg-slate-900 text-white font-black text-[10px] xs:text-[11px] sm:text-sm transition-all duration-300 hover:bg-purple-600 hover:-translate-y-1 hover:shadow-[0_20px_40px_rgba(147,51,234,0.3)] active:scale-95"
                        >
                        <span class="truncate">Detalles</span>
                        <i class="fa-solid fa-arrow-right text-[10px] transition-transform duration-300 group-hover/btn:translate-x-1 hidden md:block"></i>
                        </a>

                        <a
                        href="/reserva"
                        class="inline-flex items-center justify-center gap-2 px-3 sm:px-7 py-4 rounded-2xl font-black text-[10px] xs:text-[11px] sm:text-sm text-slate-500 border-2 border-slate-100 transition-all duration-300 hover:border-green-200 hover:bg-green-50 hover:text-green-600 hover:shadow-xl hover:shadow-green-100 active:scale-95"
                        aria-label={`Agendar ${s.title} por WhatsApp`}
                        >
                            <i class="fa-brands fa-whatsapp text-sm sm:text-lg"></i>
                            <span class="truncate">Agendar</span>
                        </a>
                    </div>

                  </div>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
