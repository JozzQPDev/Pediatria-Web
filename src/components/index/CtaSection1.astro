---
import { company } from "../../data/company";
---

<section class="py-12 lg:py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    
    <div 
      class="relative bg-slate-900 rounded-[4rem] lg:rounded-[6rem] p-12 md:p-24 overflow-hidden border border-white/5"
      data-aos="zoom-in-up"
    >

      <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] background-size-[20px_20px]"></div>
      <div class="relative z-10 grid lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-8 space-y-8 text-center lg:text-left">
          <div class="inline-flex items-center gap-3 px-5 py-2 rounded-full bg-white/5 backdrop-blur-md border border-white/10 text-white/70 font-bold uppercase tracking-[0.3em] text-[9px]"> 
            <span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>
            Disponibilidad inmediata en {company.address.city || "Ayacucho"}
          </div>

          <h2 class="text-5xl md:text-7xl font-black text-white leading-[1.1] tracking-tight">
            ¿Dudas sobre el <br />
            <span class="text-transparent bg-clip-text bg-linear-to-r from-pink-400 via-orange-300 to-blue-400 italic font-serif block mt-2">
               bienestar de tu pequeño?
            </span>
          </h2>

          <p class="text-slate-400 text-lg md:text-xl font-medium leading-relaxed max-w-2xl mx-auto lg:mx-0">
            En <strong>{company.name}</strong>, entendemos que tu prioridad es su salud. Agenda una consulta de alta especialidad hoy mismo.
          </p>

          <a 
              href="/servicios" 
              class="group inline-flex items-center gap-3 text-white font-bold uppercase tracking-widest text-[11px] border-b-2 border-white/20 pb-1 hover:border-pink-500 transition-all"
            >
              Ver todas las especialidades
              <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
            </a>

        </div>

        <div class="lg:col-span-4 flex flex-col items-center lg:items-end gap-6">
          <a 
            href="/reserva"
            rel="noopener noreferrer"
            class="group relative inline-flex items-center justify-center gap-3 bg-white text-slate-900 px-10 py-5 rounded-2xl font-black text-sm uppercase tracking-widest overflow-hidden transition-all hover:scale-105 active:scale-95"
            >
            <i class="fa-brands fa-whatsapp text-xl text-green-500"></i>
            Agendar Cita
          </a>

          <div class="flex flex-col items-center lg:items-end gap-2">
            <span class="text-slate-500 font-bold text-[10px] uppercase tracking-widest group">O llámanos directamente</span>
            <a 
              href={`tel:${company.contact.phone}`} 
              class="text-white text-2xl font-black hover:text-pink-400 transition-colors flex items-center gap-3"
            >
              <i class="fa-solid fa-phone-volume text-sm text-blue-400"></i>
              {company.contact.phone}
            </a>
          </div>
        </div>

      </div>

      <div class="absolute bottom-10 left-10 opacity-10 hidden xl:block animate-float-slow">
        <i class="fa-solid fa-stethoscope text-6xl text-white"></i>
      </div>
      <div class="absolute top-10 right-20 opacity-10 hidden xl:block animate-float-slow [animation-delay:3s]">
        <i class="fa-solid fa-baby-carriage text-5xl text-white"></i>
      </div>
    </div>

  </div>
</section>

<style>
  @keyframes float-slow {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-15px) rotate(5deg); }
  }
  .animate-float-slow {
    animation: float-slow 8s ease-in-out infinite;
  }
</style>