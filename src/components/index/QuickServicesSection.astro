---
import { quickServices } from "../../data/quickServices";
---

<section id="servicios-boutique" class="py-24 lg:py-36 relative overflow-hidden  selection:bg-yellow-100">
  <div class="absolute top-0 right-0 w-150 h-150 bg-linear-to-br from-blue-50/50 via-purple-50/30 to-transparent rounded-full blur-[140px] -z-10 translate-x-1/4 opacity-60"></div>
  <div class="absolute bottom-0 left-0 w-125 h-125 bg-linear-to-tr from-orange-50/50 via-pink-50/30 to-transparent rounded-full blur-[120px] -z-10 -translate-x-1/4 opacity-60"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-20 lg:mb-28 gap-12">
      <div class="max-w-2xl space-y-6">
        <div data-aos="fade-right">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-50 text-slate-500 font-bold uppercase tracking-[0.2em] text-[10px] border border-slate-100 shadow-sm">
            <span class="flex gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-pink-400"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
            </span>
            Nuestras Especialidades
          </span>
        </div>
        <h2 
          class="text-5xl lg:text-7xl font-black text-slate-900 leading-[1.05] tracking-tight" 
          data-aos="fade-up" 
          data-aos-delay="100"
        > 
          Cuidado integral <br />
          <span class="text-transparent bg-clip-text bg-linear-to-r from-pink-500 via-orange-400 to-blue-500 italic font-serif block mt-3">de alta especialidad.</span>
        </h2>
      </div>

      <div class="flex flex-col gap-8" data-aos="fade-left" data-aos-delay="300">
        <p class="text-slate-500 max-w-sm font-medium leading-relaxed text-base lg:text-lg border-l-4 border-slate-100 pl-8">
          Abordamos la salud infantil desde un enfoque preventivo y humano, inspirados en la alegría y el bienestar de los más pequeños.
        </p>
        <a 
          href="/servicios" 
          class="group/link self-start inline-flex items-center gap-4 font-bold text-slate-900 transition-all duration-300"
        >
          <span class="relative">
            Ver todos los servicios
            <span class="absolute -bottom-1 left-0 w-full h-0.5 bg-orange-400 origin-right transition-transform duration-300 scale-x-0 group-hover/link:scale-x-100 group-hover/link:origin-left"></span>
          </span>
          <div class="w-11 h-11 rounded-full border border-slate-200 flex items-center justify-center group-hover/link:border-blue-400 group-hover/link:bg-blue-50 transition-all duration-300">
            <i class="fa-solid fa-arrow-right-long text-sm group-hover/link:translate-x-1 transition-transform" />
          </div>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10">
      {
        quickServices.map((service, index) => (
          <div
            class={`group relative overflow-hidden rounded-[50px] transition-all duration-1000 bg-slate-50 shadow-2xl shadow-slate-200/40
              ${index % 2 === 0 ? "aspect-[3/4.5]" : "aspect-[3/4.5] lg:mt-16"}
            `}
            data-aos="fade-up"
            data-aos-delay={index * 150}
          >
            <img
              src={service.image}
              alt={service.title}
              class="absolute inset-0 w-full h-full object-cover transition-all duration-[2.5s] ease-out lg:group-hover:scale-110"
              loading="lazy"
            />
            
            {/* Gradiente neutral oscuro para legibilidad de texto */}
            <div class="absolute inset-0 bg-linear-to-t from-slate-950/90 via-slate-900/40 lg:via-transparent to-transparent opacity-90 transition-opacity duration-700" />

            <div class="absolute inset-0 p-9 flex flex-col justify-end z-30">
              
              {/* Iconos Glassmorphism que cambian de color según el index (multicolor como el logo) */}
              <div
                class={`absolute top-8 right-8 w-16 h-16 backdrop-blur-xl rounded-3xl flex items-center justify-center text-white border border-white/30 transition-all duration-500 shadow-2xl animate-float-slow
                  ${index % 4 === 0 ? "bg-pink-500/80 lg:bg-white/10 lg:group-hover:bg-pink-500" : ""}
                  ${index % 4 === 1 ? "bg-orange-500/80 lg:bg-white/10 lg:group-hover:bg-orange-500" : ""}
                  ${index % 4 === 2 ? "bg-green-500/80 lg:bg-white/10 lg:group-hover:bg-green-500" : ""}
                  ${index % 4 === 3 ? "bg-blue-500/80 lg:bg-white/10 lg:group-hover:bg-blue-500" : ""}
                `}
              >
                <i class={`${service.icon} text-3xl transition-transform duration-500 lg:group-hover:scale-110`} />
              </div>

              <div class="space-y-5">
                <h3 class="text-3xl font-extrabold text-white leading-tight drop-shadow-md">
                  {service.title}
                </h3>

                <div class="grid grid-rows-[1fr] lg:grid-rows-[0fr] lg:group-hover:grid-rows-[1fr] transition-all duration-700 ease-in-out">
                  <div class="overflow-hidden">
                    <p class="text-slate-100 text-sm leading-relaxed mb-8 opacity-100 lg:opacity-0 lg:group-hover:opacity-100 transition-all duration-500 delay-100">
                      {service.desc}
                    </p>
                    
                    <a
                      href={`/servicios#${service.title.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, "-")}`}
                      class="inline-flex items-center gap-3 text-slate-900 font-black text-[10px] uppercase tracking-[0.2em] bg-white hover:bg-slate-900 hover:text-white px-7 py-4 rounded-2xl transition-all duration-500 shadow-xl"
                    >
                      Explorar
                      <i class="fa-solid fa-chevron-right text-[9px]" />
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
  
</section>

<style>
  /* El toque del logo: Gradiente de texto sutil */
  .text-gradient-multicolor {
    background: linear-gradient(to right, #ec4899, #f97316, #84cc16, #06b6d4, #3b82f6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @keyframes float-slow {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-10px) rotate(2deg); }
  }
  .animate-float-slow {
    animation: float-slow 7s ease-in-out infinite;
  }

  .font-serif {
    font-style: italic;
  }
</style>