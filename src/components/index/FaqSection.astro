---
import { company } from '../../data/company';
import { faqs } from '../../data/faqs';
---

<section class="relative py-24 md:py-32 px-4  overflow-hidden">
  <div class="absolute top-0 right-0 w-1/3 h-full bg-linear-to-l from-blue-50/40 via-purple-50/20 to-transparent -z-10"></div>
  
  <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">

    <div class="relative" data-aos="fade-right">
      <div class="space-y-6 mb-12">
        <div data-aos="fade-down">
          <span class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-slate-50 text-slate-500 font-bold uppercase tracking-[0.2em] text-[10px] border border-slate-100 shadow-sm">
            <span class="flex gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-pink-400"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
            </span>
            Centro de Soporte
          </span>
        </div>

        <h2 class="text-5xl lg:text-7xl font-black text-slate-900 leading-[1.1] tracking-tight">
          Resolvemos tus <br/>
          <span class="text-transparent bg-clip-text bg-linear-to-r from-pink-500 via-orange-400 to-blue-600 italic font-serif block mt-3">dudas.</span>
        </h2>

        <p class="text-slate-500 text-lg font-medium leading-relaxed max-w-md">
          Todo lo que necesitas saber sobre nuestra atención pediátrica especializada y procesos de consulta en un solo lugar.
        </p>
      </div>

      <div class="relative inline-block group">
        <div class="absolute -inset-4 bg-linear-to-tr from-pink-200 via-purple-100 to-blue-100 rounded-[3rem] blur-2xl opacity-30 group-hover:opacity-60 transition-opacity duration-700"></div>
        <div class="relative rounded-[2.5rem] overflow-hidden border-8 border-white shadow-2xl">
          <img
            src="/images/pediatria-faq.jpg"
            alt="Atención médica pediátrica"
            class="h-125 w-full object-cover group-hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-linear-to-t from-slate-900/40 to-transparent"></div>
        </div>
        
        <div class="absolute -bottom-6 -right-6 bg-white p-6 rounded-3xl shadow-xl border border-slate-50 flex items-center gap-4 animate-float-slow">
           <div class="w-12 h-12 rounded-2xl bg-linear-to-br from-pink-500 to-orange-400 flex items-center justify-center text-white shadow-lg shadow-pink-200">
              <i class="fa-solid fa-comment-dots text-xl"></i>
           </div>
           <div>
              <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Atención Directa</p>
              <p class="text-sm font-bold text-slate-900 text-nowrap">WhatsApp Online</p>
           </div>
        </div>
      </div>
     <div class="absolute -bottom-10 -left-10 w-48 h-48 bg-[radial-gradient(#e2e8f0_2px,transparent_2px)] bg-size-[20px_20px] -z-10 opacity-60"></div>
    </div>

    <div class="relative" data-aos="fade-left">
      <div class="space-y-4">
        {faqs.map((faq, index) => (
          <div class="faq-item bg-white rounded-3xl border border-slate-100 shadow-xs hover:shadow-lg hover:border-pink-100 transition-all duration-300 group">
            <button
              class="faq-question w-full px-8 py-7 text-left flex items-center justify-between gap-6 outline-none"
              aria-expanded="false"
              aria-controls={`faq-answer-${index}`}
            >
              <span class="text-lg font-bold text-slate-800 group-hover:text-pink-600 transition-colors tracking-tight">
                {faq.question}
              </span>

              <div class="faq-icon-wrapper w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center shrink-0 group-hover:bg-linear-to-r group-hover:from-pink-500 group-hover:to-orange-400 group-hover:text-white transition-all duration-500">
                 <i class="fa-solid fa-chevron-down faq-icon text-[12px] transition-transform duration-500"></i>
              </div>
            </button>

            <div
              id={`faq-answer-${index}`}
              class="faq-answer max-h-0 overflow-hidden transition-all duration-500 ease-in-out"
            >
              <div class="px-8 pb-8 text-slate-500 leading-relaxed font-medium pt-2 border-t border-slate-50/50 mt-2">
                {faq.answer}
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-12 flex flex-col sm:flex-row items-center gap-8">
        <a
          href="/contacto"
          class="group/btn relative inline-flex items-center justify-center gap-3 bg-slate-900 text-white px-10 py-5 rounded-2xl font-black text-sm uppercase tracking-widest overflow-hidden transition-all hover:shadow-[0_20px_40px_-10px_rgba(236,72,153,0.3)] hover:-translate-y-1"
        >
          <span class="relative z-10">Más Información</span>
          <i class="fa-solid fa-chevron-right relative z-10 group-hover/btn:translate-x-2 transition-transform"></i>
          <div class="absolute inset-0 bg-linear-to-r from-pink-500 via-orange-400 to-blue-600 opacity-0 group-hover/btn:opacity-100 transition-opacity duration-500"></div>
        </a>
        <div class="flex flex-col">
            <span class="text-slate-400 text-[10px] font-black uppercase tracking-widest">Línea Directa</span>
            <span class="text-slate-900 font-bold text-lg">{company.contact.phone}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Efecto activo para el acordeón */
  .faq-item.active {
    border-color: #fce7f3; /* pink-100 */
    background: #fff;
    box-shadow: 0 20px 40px -15px rgba(236, 72, 153, 0.1);
  }
  
  .faq-item.active .faq-icon-wrapper {
    background: linear-gradient(to right, #ec4899, #fb923c); /* pink-500 to orange-400 */
    color: white;
    transform: rotate(180deg); /* El icono de plus (+) gira 45 grados y parece una (x) */
  }

  .faq-item.active .faq-icon {
    transform: rotate(0deg) !important; /* Evitamos que el JS y el CSS peleen */
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const faqItems = document.querySelectorAll('.faq-item');

    faqItems.forEach(item => {
      const question = item.querySelector('.faq-question');
      const answer = item.querySelector('.faq-answer') as HTMLElement;

      question?.addEventListener('click', () => {
        const isOpen = item.classList.contains('active');

        // Cerrar otros para enfoque único
        faqItems.forEach(otherItem => {
          if (otherItem !== item) {
            otherItem.classList.remove('active');
            const otherAnswer = otherItem.querySelector('.faq-answer') as HTMLElement;
            otherAnswer.style.maxHeight = '0';
          }
        });

        // Toggle
        if (isOpen) {
          item.classList.remove('active');
          answer.style.maxHeight = '0';
        } else {
          item.classList.add('active');
          answer.style.maxHeight = answer.scrollHeight + 'px';
        }
      });
    });
  });
</script>