---
import { doctors } from "../../data/doctors";

// Filtramos a la Dra. Amalia como la líder y al resto como el equipo
const leadDoctor = doctors.find(d => d.name.includes("Amalia")) || doctors[0];
const staffDoctors = doctors.filter(d => d.id !== leadDoctor.id);

type DoctorColor = 'green' | 'blue' | 'yellow' | 'purple' | 'pink';

const colorStyles: Record<DoctorColor, { text: string; bg: string; fill: string }> = {
  pink: { text: "text-pink-500", bg: "bg-pink-50", fill: "bg-pink-500" },
  blue: { text: "text-blue-500", bg: "bg-blue-50", fill: "bg-blue-500" },
  yellow: { text: "text-orange-500", bg: "bg-orange-50", fill: "bg-orange-500" },
  purple: { text: "text-purple-500", bg: "bg-purple-50", fill: "bg-purple-500" },
  green: { text: "text-emerald-500", bg: "bg-emerald-50", fill: "bg-emerald-500" },
};
---

  <section class="relative py-16 md:py-24 px-4 overflow-hidden">
  
  <div class="absolute top-0 right-0 w-1/3 h-full bg-linear-to-l from-slate-50/50 to-transparent -z-10"></div>

   <div class="max-w-7xl mx-auto relative z-10">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-20 lg:mb-28 gap-8">
      <div class="max-w-3xl space-y-6">
        <div data-aos="fade-right">
          <span class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-slate-50 text-slate-500 font-bold uppercase tracking-[0.2em] text-[10px] border border-slate-100 shadow-sm">
            <span class="flex gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-pink-400"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
            </span>
            Excelencia Médica Especializada
          </span>
        </div>
        
        <h2 
          class="text-5xl lg:text-7xl font-black text-slate-900 leading-[1.05] tracking-tight" 
          data-aos="fade-up" 
          data-aos-delay="100"
        >
          Ciencia que protege, <br/>
          <span class="text-transparent bg-clip-text bg-linear-to-r from-pink-500 via-orange-400 to-blue-600 italic font-serif block mt-3">ternura que sana.</span>
        </h2>
      </div>

      <div class="flex flex-col gap-8" data-aos="fade-left" data-aos-delay="300">
        <div class="max-w-sm border-l-4 border-slate-100 pl-8">
          <p class="text-slate-600 font-semibold leading-relaxed text-lg lg:text-xl">
            Expertos comprometidos con el futuro más valioso: <span class="text-blue-600">la salud de tus hijos.</span>
          </p>
          <p class="text-slate-400 text-sm leading-relaxed">
            Combinamos alta especialización clínica con un enfoque profundamente humano, transformando cada consulta en un espacio de confianza y bienestar.
          </p>
        </div>
      </div>
    </div>

    
    <div class="grid lg:grid-cols-10 gap-16 items-start mt-15">
      
      <div class="lg:col-span-5 relative" data-aos="zoom-in" data-aos-duration="1500">
  
        <div class="relative z-10 rounded-[80px] overflow-hidden bg-slate-100 aspect-4/5 shadow-3xl shadow-slate-200/60 border-12 border-white group">
          <img 
            src={leadDoctor.image} 
            alt={leadDoctor.name} 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[3s]"
          />
          
          <div class="absolute inset-0 bg-linear-to-t from-slate-900/90 via-slate-900/20 to-transparent opacity-90"></div>
          
          <div class="absolute bottom-12 left-10 right-10 text-white">
            <div class="flex gap-2 mb-4">
                <span class="w-8 h-1.5 bg-pink-500 rounded-full"></span>
                <span class="w-4 h-1.5 bg-orange-400 rounded-full"></span>
            </div>
            
            <p class="text-[11px] font-black uppercase tracking-[0.4em] text-white mb-2">
              Directora Médica
            </p>
            
            <h3 class="text-4xl lg:text-5xl font-black mb-4 leading-tight">
              {leadDoctor.name}
            </h3>

            <p class="text-white/80 text-sm font-medium italic mb-6 leading-relaxed max-w-xs border-l-2 border-white/30 pl-4">
              "{leadDoctor.specialty}"
            </p>

            <div class="flex flex-wrap gap-2">
              {leadDoctor.tags.map(tag => (
                <span class="px-3 py-1.5 bg-white/10 backdrop-blur-md rounded-full text-white text-[9px] font-bold uppercase tracking-wider border border-white/20">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </div>

        <div class="absolute -top-6 -left-4 lg:-left-8 z-20 bg-white p-7 rounded-[40px] shadow-2xl border border-slate-50 flex items-center justify-center animate-float-slow">
          <div class="text-center">
            <div class="relative inline-block mb-2">
                <i class="fa-solid fa-medal text-orange-500 text-3xl"></i>
                <i class="fa-solid fa-heart text-pink-500 text-[10px] absolute -top-1 -right-1"></i>
            </div>
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-900 leading-tight">
              Especialista <br/> <span class="text-blue-500">Internacional</span>
            </p>
          </div>
        </div>

        <div class="absolute -bottom-10 -left-10 w-48 h-48 bg-[radial-gradient(#e2e8f0_2px,transparent_2px)] bg-size-[20px_20px] -z-10 opacity-60"></div>
      </div>

      <div class="lg:col-span-5 space-y-8">
        <div class="pb-6 border-b border-slate-100">
          <h4 class="text-xl font-bold text-slate-900">Especialistas Asociados</h4>
          <p class="text-slate-500 text-sm mt-1">Colaborando en el bienestar integral de tu hijo.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {staffDoctors.map((doc, index) => (
          <div 
            class="group flex flex-row md:flex-col items-center text-left md:text-center gap-5 p-4 md:p-2 rounded-3xl bg-slate-50 hover:bg-slate-200 transition-all duration-500 border border-transparent hover:border-slate-300 shadow-sm md:shadow-none"
            data-aos="fade-left"
            data-aos-delay={index * 100}
          >
            {/* Contenedor de la imagen: Más pequeña en móvil, 40 en desktop */}
            <div class="relative w-24 h-24 md:w-40 md:h-40 shrink-0 rounded-2xl overflow-hidden shadow-md group-hover:rotate-3 transition-transform">
              <img src={doc.image} alt={doc.name} class="w-full h-full object-cover" />
            </div>
            
            {/* Contenedor de texto: Alineado a la izquierda en móvil */}
            <div class="space-y-1 flex-1">
              <p class={`text-[10px] md:text-[9px] font-black uppercase tracking-widest ${colorStyles[doc.color as DoctorColor].text}`}>
                {doc.role}
              </p>
              <h5 class="text-lg md:text-base font-extrabold text-slate-900 leading-tight">
                {doc.name}
              </h5>
              <p class="text-[12px] md:text-[11px] text-slate-500 font-medium line-clamp-2 md:line-clamp-1">
                {doc.specialty}
              </p>
              
              {/* Opcional: Badge visible solo en móvil para darle un toque clínico */}
              <div class="md:hidden mt-2 inline-flex items-center text-[10px] font-bold text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full">
                Disponible
              </div>
            </div>
          </div>
        ))}
      </div>

      {/* Botón de directorio: Centrado en móvil para mejor alcance del pulgar */}
      <div class="pt-10 flex justify-center md:justify-start" data-aos="fade-up">
        <a 
          href="/equipo" 
          class="group/link inline-flex items-center justify-center gap-4 font-bold text-slate-900 transition-all duration-300"
        >
          <span class="relative text-sm md:text-base">
            Ver directorio completo
            <span class="absolute -bottom-1 left-0 w-full h-0.5 bg-orange-400 origin-right transition-transform duration-300 scale-x-0 group-hover/link:scale-x-100 group-hover/link:origin-left"></span>
          </span>
          <div class="w-10 h-10 md:w-11 md:h-11 rounded-full border border-slate-200 flex items-center justify-center group-hover/link:border-blue-400 group-hover/link:bg-blue-50 transition-all duration-300 shadow-sm">
            <i class="fa-solid fa-arrow-right-long text-xs md:text-sm group-hover/link:translate-x-1 transition-transform" />
          </div>
        </a>
      </div>

      </div>
    </div>
  </div>
</section>
