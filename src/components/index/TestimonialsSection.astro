---
import TestimonialsCarousel from "../../components/TestimonialsCarousel.jsx";
---

  <section class="relative py-16 md:py-24 px-4 overflow-hidden">
     <div class="text-center mb-20">
        <div data-aos="fade-right">
          <span class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-slate-50 text-slate-500 font-bold uppercase tracking-[0.2em] text-[10px] border border-slate-100 shadow-sm">
            <span class="flex gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-pink-400"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
            </span>
            Opiniones de nuestros pacientes
          </span>
        </div>
        
        <h2 
          class="text-5xl lg:text-7xl font-black text-slate-900 leading-[1.05] tracking-tight" 
          data-aos="fade-up" 
          data-aos-delay="100"
        >
          Experiencias que<br/>
         <span class="text-transparent bg-clip-text bg-linear-to-r from-pink-500 via-orange-400 to-blue-600 italic font-serif">dejan huella.</span>
        </h2>
  
     <p class="mt-8 text-slate-500 max-w-2xl mx-auto text-lg font-medium leading-relaxed" data-aos="fade-up" data-aos-delay="100">
        En Pediátrica Dharma, la salud y bienestar de tus hijos es nuestra prioridad. Descubre lo que nuestros pacientes y sus familias tienen que decir sobre su experiencia con nosotros.</p>
    </div>
    <TestimonialsCarousel />
</section>