---
interface Props {
  featuredPost: {
    image: string;
    title: string;
    excerpt: string;
    author: string;
    authorImage: string;
    date: string;
    readTime: string;
    category: string;
    slug: string;
  };
}
const { featuredPost } = Astro.props;
---

<section id="featured-section" class="py-16 md:py-24 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <div data-aos="fade-down" class="flex justify-center lg:justify-start mb-12">
      <div data-aos="fade-right">
          <span class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-slate-50 border border-slate-100 text-slate-500 font-bold uppercase tracking-[0.2em] text-[10px] shadow-sm">
            <span class="flex gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-pink-400"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
            </span>
           Artículo Destacado
          </span>
        </div>
    </div>
    
    <div class="grid lg:grid-cols-2 gap-10 md:gap-16 items-center">
      
      <div class="relative group" data-aos="zoom-in" data-aos-delay="200">
        <div class="absolute -inset-4 bg-linear-to-br from-pink-100 to-blue-100 rounded-[3rem] opacity-30 blur-2xl group-hover:opacity-50 transition-opacity duration-700"></div>
        
        <div class="relative overflow-hidden rounded-[2.5rem] border-4 border-white shadow-2xl aspect-video lg:aspect-square xl:aspect-4/3">
          <img 
            src={featuredPost.image} 
            alt={featuredPost.title}
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-[1.5s] ease-out"
          />
          <div class="absolute inset-0 bg-linear-to-t from-slate-900/40 via-transparent to-transparent opacity-60"></div>
          
          <div class="absolute top-6 left-6">
            <span class="bg-white/95 backdrop-blur-md text-slate-900 px-5 py-2.5 rounded-2xl text-[10px] font-black uppercase tracking-widest shadow-xl">
              {featuredPost.category}
            </span>
          </div>
        </div>
      </div>
      
      <div class="space-y-8" data-aos="fade-left" data-aos-delay="400">
        <div class="space-y-4">
          <div class="flex items-center gap-6 text-[11px] font-black uppercase tracking-widest text-slate-400">
            <span class="flex items-center gap-2">
              <i class="fa-regular fa-calendar"></i>
              {new Date(featuredPost.date).toLocaleDateString('es-ES', { month: 'long', day: 'numeric', year: 'numeric' })}
            </span>
            <span class="flex items-center gap-2">
              <i class="fa-regular fa-clock "></i>
              {featuredPost.readTime}
            </span>
          </div>
          
          <h2 class="text-4xl lg:text-5xl font-black text-slate-900 leading-[1.1] tracking-tighter">
            {featuredPost.title}
          </h2>
          
          <p class="text-lg text-slate-500 leading-relaxed font-medium italic border-l-4 border-slate-100 pl-6">
            "{featuredPost.excerpt}"
          </p>
        </div>
        
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-8 pt-4">
          <div class="flex items-center gap-4">
            <div class="relative">
               <img 
                src={featuredPost.authorImage} 
                alt={featuredPost.author}
                class="w-14 h-14 rounded-2xl object-cover border-2 border-white shadow-lg rotate-3 group-hover:rotate-0 transition-transform"
              />
              <div class="absolute -bottom-1 -right-1 w-5 h-5 bg-emerald-500 border-2 border-white rounded-full"></div>
            </div>
            <div>
              <p class="font-black text-slate-900 tracking-tight">{featuredPost.author}</p>
              <p class="text-[10px] font-bold text-blue-600 uppercase tracking-widest">Especialista Dharma</p>
            </div>
          </div>
          
          <a 
            href={`/blog/${featuredPost.slug}`}
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-slate-900 text-white px-10 py-5 rounded-2xl font-black text-sm hover:-translate-y-1 transition-all shadow-xl shadow-slate-200 group/btn"
          >
            Leer Artículo Completo
            <i class="fa-solid fa-arrow-right group-hover/btn:translate-x-2 transition-transform"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>