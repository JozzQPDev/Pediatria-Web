---
interface Props {
  blogPosts: {
    image: string;
    title: string;
    excerpt: string;
    author: string;
    authorImage: string;
    date: string;
    readTime: string;
    category: string;
    slug: string;
  }[];
}
const { blogPosts } = Astro.props;
---

<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-6">
    
    <div id="blog-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
      {blogPosts.map((post, index) => (
        <article 
  class="blog-post group flex flex-col bg-white rounded-[2.5rem] border border-slate-100 
         shadow-[0_10px_30px_-15px_rgba(0,0,0,0.05)] 
         hover:shadow-[0_30px_60px_-20px_rgba(59,130,246,0.15)] 
         transition-all duration-700 ease-[cubic-bezier(0.34,1.56,0.64,1)] 
         overflow-hidden hover:-translate-y-3 relative" 
  data-category={post.category}
  data-aos="fade-up"
  data-aos-delay={index * 50}
>
          <div class="relative overflow-hidden h-64">
            <img 
              src={post.image} 
              alt={post.title}
              class="w-full h-full object-cover grayscale-20 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-[2s] ease-out"
            />
            
            <div class="absolute inset-0 bg-linear-to-t from-slate-900/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
            
            <div class="absolute top-6 left-6">
              <span class="bg-white/80 backdrop-blur-md border border-white/20 text-slate-900 px-4 py-1.5 rounded-xl text-[9px] font-black uppercase tracking-[0.15em] shadow-lg">
                {post.category}
              </span>
            </div>
          </div>
          
          <div class="p-8 flex flex-col flex-1 relative bg-white">
            <div class="absolute top-0 left-8 w-0 h-1 bg-blue-500 transition-all duration-500 group-hover:w-20"></div>

            <div class="flex items-center gap-4 text-[10px] font-black uppercase tracking-widest text-slate-400 mb-5">
              <span class="flex items-center gap-2">
                <i class="fa-regular fa-calendar-check text-pink-500"></i>
                {new Date(post.date).toLocaleDateString('es-ES', { month: 'short', day: 'numeric' })}
              </span>
              <span class="flex items-center gap-2 text-blue-500/80">
                <i class="fa-regular fa-clock"></i>
                {post.readTime}
              </a>
            </div>
            
            <h3 class="text-xl font-black text-slate-900 mb-4 line-clamp-2 leading-[1.2] tracking-tight group-hover:text-blue-600 transition-colors">
              {post.title}
            </h3>
            
            <p class="text-slate-500 text-sm leading-relaxed mb-8 line-clamp-3 font-medium opacity-80 group-hover:opacity-100 transition-opacity">
              {post.excerpt}
            </p>
            
            <div class="mt-auto pt-6 border-t border-slate-50 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="relative">
                   <img 
                    src={post.authorImage} 
                    alt={post.author}
                    class="w-9 h-9 rounded-xl object-cover ring-4 ring-slate-50 group-hover:ring-blue-50 transition-all"
                  />
                  <span class="absolute -bottom-1 -right-1 w-3 h-3 bg-emerald-500 border-2 border-white rounded-full"></span>
                </div>
                <div class="flex flex-col">
                  <span class="text-[11px] font-black text-slate-800 tracking-tight leading-none mb-1">{post.author}</span>
                  <span class="text-[9px] font-bold text-slate-400 uppercase tracking-tighter">Especialista</span>
                </div>
              </div>
              
              <a 
                href={`/blog/${post.slug}`}
                class="flex items-center justify-center w-10 h-10 rounded-xl bg-slate-50 text-slate-400 group-hover:bg-blue-600 group-hover:text-white transition-all duration-300"
                aria-label="Leer más"
              >
                <i class="fa-solid fa-chevron-right text-[10px] group-hover:translate-x-0.5 transition-transform"></i>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div id="no-results" class="hidden text-center py-24" data-aos="fade-up">
      <div class="relative inline-block mb-8">
        <div class="absolute inset-0 bg-blue-100 rounded-full blur-2xl opacity-50 animate-pulse"></div>
        <div class="relative w-24 h-24 bg-white rounded-3xl shadow-xl flex items-center justify-center border border-slate-50">
          <i class="fa-solid fa-magnifying-glass text-3xl text-slate-200"></i>
        </div>
      </div>
      <h3 class="text-2xl font-black text-slate-900 mb-3 tracking-tighter italic font-serif">No encontramos artículos</h3>
      <p class="text-slate-500 mb-10 font-medium max-w-sm mx-auto">Parece que aún no tenemos contenido en esta categoría. ¡Prueba con otra!</p>
      <button id="show-all-btn" class="group relative px-10 py-4 bg-slate-900 text-white rounded-2xl text-[11px] font-black uppercase tracking-[0.2em] shadow-2xl hover:bg-blue-600 transition-all active:scale-95 cursor-pointer overflow-hidden">
        <span class="relative z-10">Ver todo el blog</span>
        <div class="absolute inset-0 bg-linear-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:animate-shimmer"></div>
      </button>
    </div>
  </div>
</section>

<style>
  @keyframes shimmer {
    100% { transform: translateX(100%); }
  }
  .animate-shimmer {
    animation: shimmer 1.5s infinite;
  }
</style>