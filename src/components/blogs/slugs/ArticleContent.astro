---
interface Props {
  post: {
    authorImage: string;
    author?: string;
    title: string;
    image: string;
    category: string;
    date: string;
    readTime: string;
    content: string;
    tags: string[];
  };
}

const { post } = Astro.props;
const authorName = post.author || "Equipo Médico Dharma"; 
---

<article class="py-20 relative">
  <div class="max-w-4xl mx-auto px-6">
    
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-8 mb-16 pb-10 border-b border-slate-100">
      <div class="flex items-center gap-5">
        <div class="relative group">
          <img
            src={post.authorImage}
            alt={authorName}
            class="w-16 h-16 rounded-2xl object-cover ring-4 ring-slate-50 shadow-xl transition-transform duration-500 group-hover:rotate-3"
          />
          <span class="absolute -bottom-1 -right-1 w-5 h-5 bg-emerald-500 border-4 border-white rounded-full"></span>
        </div>
        <div>
          <p class="font-black text-slate-900 leading-tight uppercase text-[11px] tracking-[0.15em] mb-1">{authorName}</p>
          <div class="flex items-center gap-2">
            <span class="w-2 h-px bg-blue-500"></span>
            <p class="text-[10px] font-bold text-blue-500 uppercase tracking-[0.2em]">Especialista Certificado</p>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="flex flex-col items-end">
          <span class="flex items-center gap-2 bg-slate-50 px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest text-slate-500 border border-slate-100 shadow-sm">
            <i class="fa-solid fa-calendar-day text-pink-500"></i>
            {new Date(post.date).toLocaleDateString("es-ES", { year: "numeric", month: "short", day: "numeric" })}
          </span>
        </div>
        <span class="flex items-center gap-2 bg-slate-900 px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest text-white shadow-lg shadow-slate-200">
          <i class="fa-solid fa-clock text-blue-400"></i>
          {post.readTime}
        </span>
      </div>
    </div>

    <div class="relative group mb-20">
      <div class="absolute -top-4 -left-4 z-10">
        <span class="bg-white text-slate-900 px-6 py-3 rounded-2xl text-[11px] font-black uppercase tracking-[0.2em] shadow-[0_20px_40px_-10px_rgba(0,0,0,0.2)] border border-slate-100">
          {post.category}
        </span>
      </div>
      
      <div class="relative overflow-hidden rounded-[3.5rem] shadow-[0_40px_80px_-20px_rgba(0,0,0,0.15)] bg-slate-100">
        <img
          src={post.image}
          alt={post.title}
          class="w-full h-137.5 object-cover group-hover:scale-110 transition-transform duration-[5s] ease-out opacity-90 group-hover:opacity-100"
        />
        <div class="absolute inset-0 bg-linear-to-t from-slate-900/60 via-transparent to-transparent opacity-60"></div>
      </div>
    </div>

    <div class="prose-medical max-w-none mb-24" set:html={post.content} />

    <div class="grid md:grid-cols-2 gap-16 pt-16 border-t border-slate-100">
      <div class="space-y-6">
        <h4 class="text-[11px] font-black text-slate-400 uppercase tracking-[0.4em]">Etiquetas Médicas</h4>
        <div class="flex flex-wrap gap-3">
          {post.tags.map((tag) => (
            <a
              href={`/blogs?tag=${tag}`}
              class="px-5 py-2.5 bg-slate-50 text-slate-600 rounded-2xl text-[10px] font-black uppercase tracking-widest border border-slate-100 hover:bg-slate-900 hover:text-white hover:-translate-y-1 transition-all duration-300"
            >
              #{tag}
            </a>
          ))}
        </div>
      </div>

      <div class="md:text-right space-y-6">
        <h4 class="text-[11px] font-black text-slate-400 uppercase tracking-[0.4em]">Compartir Artículo</h4>
        <div class="flex gap-4 md:justify-end">
          <a href={`https://www.facebook.com/sharer/sharer.php?u=${Astro.url}`} target="_blank" class="w-14 h-14 bg-white border border-slate-100 rounded-2xl flex items-center justify-center text-slate-400 hover:text-blue-600 hover:shadow-2xl hover:border-blue-100 hover:-translate-y-2 transition-all duration-500">
            <i class="fa-brands fa-facebook-f text-xl"></i>
          </a>
          <a href={`https://wa.me/?text=${encodeURIComponent(post.title + " " + Astro.url)}`} target="_blank" class="w-14 h-14 bg-white border border-slate-100 rounded-2xl flex items-center justify-center text-slate-400 hover:text-emerald-500 hover:shadow-2xl hover:border-emerald-100 hover:-translate-y-2 transition-all duration-500">
            <i class="fa-brands fa-whatsapp text-xl"></i>
          </a>
          <button onclick="navigator.clipboard.writeText(window.location.href); alert('Enlace copiado');" class="w-14 h-14 bg-white border border-slate-100 rounded-2xl flex items-center justify-center text-slate-400 hover:text-pink-500 hover:shadow-2xl hover:border-pink-100 hover:-translate-y-2 transition-all duration-500">
            <i class="fa-solid fa-link"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</article>

<style is:global>
  /* Referencia directa al paquete instalado */
  @reference "tailwindcss";

  .prose-medical {
    @apply text-slate-600 text-lg leading-[1.9] font-medium;
  }

  .prose-medical h2 {
    @apply text-3xl md:text-5xl font-black text-slate-900 tracking-tighter mt-20 mb-8 leading-[1.1] italic font-serif;
  }

  .prose-medical h3 {
    @apply text-xl font-black text-blue-600 uppercase tracking-[0.2em] mt-14 mb-6 flex items-center gap-3;
  }

  .prose-medical h3::before {
    content: '';
    @apply w-8 h-1 bg-blue-500/20 rounded-full;
  }

  .prose-medical p {
    @apply mb-8;
  }

  .prose-medical strong {
    @apply text-slate-900 font-black;
  }

  /* Estilo para las listas (como se ve en tu imagen) */
  .prose-medical ul {
    @apply my-12 space-y-5 pl-2;
  }

  .prose-medical li {
    @apply flex items-start gap-5 p-5 rounded-3xl bg-slate-50/50 border border-transparent transition-all duration-300 hover:bg-white hover:border-slate-100 hover:shadow-xl;
  }

  .prose-medical li::before {
    content: "\f058";
    font-family: "Font Awesome 6 Free";
    font-weight: 900;
    @apply text-emerald-500 text-2xl mt-0.5;
  }
</style>