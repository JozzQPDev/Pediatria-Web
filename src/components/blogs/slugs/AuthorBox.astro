---
interface Props {
  post: {
    authorImage: string;
    author?: string;
  };
}

const { post } = Astro.props;
const authorName = post.author || "Equipo Médico Dharma";
---

<section class="py-12">
  <div class="max-w-4xl mx-auto">
    <div class="group relative rounded-[2.5rem] p-8 md:p-12 border border-slate-100 transition-all duration-500 hover:-translate-y-1">
      
      <div class="absolute top-6 right-8 opacity-[0.03] group-hover:opacity-[0.08] transition-opacity duration-500 pointer-events-none">
        <i class="fa-solid fa-stethoscope text-8xl -rotate-12"></i>
      </div>

      <div class="flex flex-col md:flex-row items-center md:items-start gap-8 relative z-10">
        
        <div class="relative">
          <div class="w-32 h-32 rounded-4xl overflow-hidden shadow-2xl ring-8 ring-white transition-transform duration-500 group-hover:rotate-3">
            <img
              src={post.authorImage}
              alt={authorName}
              class="w-full h-full object-cover scale-110 group-hover:scale-100 transition-transform duration-700"
            />
          </div>
        </div>

        <div class="flex-1 text-center md:text-left">
           <div data-aos="fade-down">
              <span class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-white text-slate-500 font-bold uppercase tracking-[0.2em] text-[10px] border border-slate-100 shadow-sm mb-6">
                <span class="flex gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-pink-400"></span>
                  <span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span>
                  <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
                  </span>
                  Autoría Médica
              </span>
            </div>
          
          <h3 class="text-3xl font-black text-slate-900 mb-3 tracking-tighter leading-tight">
            Escrito por  <span class="text-transparent bg-clip-text bg-linear-to-r from-pink-500 via-orange-400 to-blue-600 italic font-serif">{authorName}</span>
          </h3>
          
          <p class="text-slate-500 leading-relaxed font-medium mb-8 max-w-xl text-lg">
            Especialista certificado con amplia experiencia en pediatría integral. 
            Su labor se enfoca en el desarrollo infantil y la medicina preventiva 
            con calidez humana.
          </p>

          <div class="flex flex-wrap justify-center md:justify-start gap-4">
            <a
              href="/equipo"
              class="inline-flex items-center gap-3 bg-slate-900 text-white px-8 py-3.5 rounded-2xl text-[10px] font-black uppercase tracking-widest shadow-xl shadow-slate-200 hover:bg-blue-600 hover:shadow-blue-200 transition-all duration-300"
            >
              Conoce nuestro equipo
              <i class="fa-solid fa-arrow-right-long transition-transform group-hover:translate-x-1"></i>
            </a>
            
            <div class="flex items-center gap-2 ml-2">
               <div class="w-10 h-10 rounded-xl border border-slate-200 flex items-center justify-center text-slate-400 hover:text-blue-500 hover:border-blue-200 transition-colors cursor-pointer">
                 <i class="fa-brands fa-linkedin-in"></i>
               </div>
               <div class="w-10 h-10 rounded-xl border border-slate-200 flex items-center justify-center text-slate-400 hover:text-pink-500 hover:border-pink-200 transition-colors cursor-pointer">
                 <i class="fa-brands fa-instagram"></i>
               </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Animación suave para la entrada */
  section {
    animation: slideUp 1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>