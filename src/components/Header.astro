---
import TopBar from "./header/TopBar.astro";
import DesktopNav from "./header/DesktopNav.astro";
import MobileHeader from "./header/MobileHeader.astro";
import MobileMenu from "./header/MobileMenu.astro";
import { siteConfig } from "../data/siteConfig";

---

<header id="main-header" class="bg-white sticky top-0 z-50 transition-all duration-300 shadow-sm">
  <div class="max-w-8xl mx-auto">
    <!-- Desktop -->
    <div class="hidden lg:flex items-start px-3 sm:px-4 lg:px-6 gap-8 py-4">
      <a href="/" aria-label="Ir a inicio" class="shrink-0">
        <img id="main-logo" src="/images/logo3.png"
          class="h-24 w-auto object-contain transition-all duration-300"
          alt={`${siteConfig.name} logo`} />
      </a>
      <div class="flex-1 flex flex-col gap-3">
        <TopBar />
        <DesktopNav />
      </div>
    </div>

    <!-- Mobile -->
    <div class="lg:hidden flex flex-col overflow-visible">
      <MobileHeader />
    </div>
  </div>
</header>

<MobileMenu />

<script>
  import { initHeader } from "../scripts/header.ts";
  document.addEventListener("astro:page-load", initHeader);
  initHeader();
</script>