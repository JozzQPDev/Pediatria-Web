---
// SearchFilters.astro - Filter and sort controls for search results
export interface Props {
  currentType?: string;
  currentCategory?: string;
  currentSort?: string;
  availableCategories?: string[];
  totalResults?: number;
}

const { 
  currentType = '', 
  currentCategory = '', 
  currentSort = 'relevance',
  availableCategories = [],
  totalResults = 0
} = Astro.props;

const types = [
  { value: '', label: 'Todos', icon: 'layers' },
  { value: 'service', label: 'Servicios', icon: 'stethoscope' },
  { value: 'blog', label: 'Artículos', icon: 'book-open' },
  { value: 'page', label: 'Páginas', icon: 'file-text' }
];

const sortOptions = [
  { value: 'relevance', label: 'Relevancia', icon: 'target' },
  { value: 'title', label: 'Nombre', icon: 'arrow-up-a-z' },
  { value: 'date', label: 'Fecha', icon: 'calendar' }
];
---

<div class="search-filters bg-white rounded-2xl p-4 shadow-sm border border-gray-100 mb-6">
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
    <!-- Filter by Type -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 lg:pb-0">
      <span class="text-sm text-gray-500 shrink-0 font-medium">Tipo:</span>
      <div class="flex gap-2">
        {types.map(type => (
          <a
            href={`?${new URLSearchParams({...Object.fromEntries(new URL(Astro.request.url).searchParams), type: type.value || '', page: '1'}).toString()}`}
            class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-all whitespace-nowrap flex items-center gap-1.5 ${
              currentType === type.value 
                ? 'bg-pink-100 text-pink-700 ring-2 ring-pink-200' 
                : 'bg-gray-50 text-gray-600 hover:bg-gray-100'
            }`}
          >
            <i data-lucide={type.icon} class="w-3.5 h-3.5"></i>
            {type.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Sort and Stats -->
    <div class="flex items-center justify-between lg:justify-end gap-4">
      <!-- Results count -->
      {totalResults > 0 && (
        <span class="text-sm text-gray-500">
          {totalResults} resultado{totalResults !== 1 ? 's' : ''}
        </span>
      )}
      
      <!-- Sort dropdown - Mobile friendly with click -->
      <div class="relative" id="sort-dropdown-container">
        <button 
          type="button"
          id="sort-dropdown-btn"
          class="flex items-center gap-2 px-3 py-1.5 bg-gray-50 hover:bg-gray-100 rounded-lg text-sm text-gray-600 transition-colors cursor-pointer"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <i data-lucide="arrow-up-down" class="w-3.5 h-3.5"></i>
          <span>Ordenar</span>
          <i data-lucide="chevron-down" class="w-3.5 h-3.5 transition-transform" id="sort-chevron"></i>
        </button>
        
        <div 
          id="sort-dropdown-menu"
          class="absolute right-0 top-full mt-2 w-40 bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden hidden z-20"
        >
          {sortOptions.map(option => (
            <a
              href={`?${new URLSearchParams({...Object.fromEntries(new URL(Astro.request.url).searchParams), sort: option.value, page: '1'}).toString()}`}
              class={`flex items-center gap-2 px-4 py-2.5 text-sm transition-colors ${
                currentSort === option.value
                  ? 'bg-pink-50 text-pink-700 font-medium'
                  : 'text-gray-600 hover:bg-gray-50'
              }`}
            >
              <i data-lucide={option.icon} class="w-4 h-4"></i>
              {option.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Category Filter (if categories available) -->
  {availableCategories.length > 0 && (
    <div class="mt-4 pt-4 border-t border-gray-100">
      <div class="flex items-center gap-2 overflow-x-auto pb-2">
        <span class="text-sm text-gray-500 shrink-0 font-medium">Categoría:</span>
        <div class="flex gap-2">
          <a
            href={`?${new URLSearchParams({...Object.fromEntries(new URL(Astro.request.url).searchParams), category: '', page: '1'}).toString()}`}
            class={`px-3 py-1 rounded-lg text-xs font-medium transition-all whitespace-nowrap ${
              !currentCategory
                ? 'bg-pink-100 text-pink-700 ring-1 ring-pink-200' 
                : 'bg-gray-50 text-gray-600 hover:bg-gray-100'
            }`}
          >
            Todas
          </a>
          {availableCategories.map(category => (
            <a
              href={`?${new URLSearchParams({...Object.fromEntries(new URL(Astro.request.url).searchParams), category, page: '1'}).toString()}`}
              class={`px-3 py-1 rounded-lg text-xs font-medium transition-all whitespace-nowrap ${
                currentCategory === category
                  ? 'bg-pink-100 text-pink-700 ring-1 ring-pink-200' 
                  : 'bg-gray-50 text-gray-600 hover:bg-gray-100'
              }`}
            >
              {category}
            </a>
          ))}
        </div>
      </div>
    </div>
  )}

  <!-- Active filters display -->
  {(currentType || currentCategory || currentSort !== 'relevance') && (
    <div class="mt-4 pt-4 border-t border-gray-100 flex items-center gap-2 flex-wrap">
      <span class="text-sm text-gray-500">Filtros activos:</span>
      
      {currentType && (
        <span class="inline-flex items-center gap-1 px-2 py-1 bg-pink-50 text-pink-700 text-xs rounded-lg">
          {types.find(t => t.value === currentType)?.label}
          <a 
            href={`?${new URLSearchParams({...Object.fromEntries(new URL(Astro.request.url).searchParams), type: '', page: '1'}).toString()}`}
            class="hover:text-pink-900"
            aria-label="Eliminar filtro de tipo"
          >
            <i data-lucide="x" class="w-3 h-3"></i>
          </a>
        </span>
      )}
      
      {currentCategory && (
        <span class="inline-flex items-center gap-1 px-2 py-1 bg-blue-50 text-blue-700 text-xs rounded-lg">
          {currentCategory}
          <a 
            href={`?${new URLSearchParams({...Object.fromEntries(new URL(Astro.request.url).searchParams), category: '', page: '1'}).toString()}`}
            class="hover:text-blue-900"
            aria-label="Eliminar filtro de categoría"
          >
            <i data-lucide="x" class="w-3 h-3"></i>
          </a>
        </span>
      )}
      
      {currentSort !== 'relevance' && (
        <span class="inline-flex items-center gap-1 px-2 py-1 bg-green-50 text-green-700 text-xs rounded-lg">
          {sortOptions.find(s => s.value === currentSort)?.label}
          <a 
            href={`?${new URLSearchParams({...Object.fromEntries(new URL(Astro.request.url).searchParams), sort: 'relevance', page: '1'}).toString()}`}
            class="hover:text-green-900"
            aria-label="Restablecer ordenamiento"
          >
            <i data-lucide="x" class="w-3 h-3"></i>
          </a>
        </span>
      )}
      
      <a 
        href={`?${new URLSearchParams({ q: new URL(Astro.request.url).searchParams.get('q') || '' }).toString()}`}
        class="text-xs text-gray-400 hover:text-gray-600 underline ml-2"
      >
        Limpiar todos
      </a>
    </div>
  )}
</div>

<style>
  /* Hide scrollbar for filter buttons */
  .overflow-x-auto::-webkit-scrollbar {
    display: none;
  }
  .overflow-x-auto {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script is:inline>
  // Mobile-friendly sort dropdown
  (function() {
    const sortBtn = document.getElementById('sort-dropdown-btn');
    const sortMenu = document.getElementById('sort-dropdown-menu');
    const sortChevron = document.getElementById('sort-chevron');
    const sortContainer = document.getElementById('sort-dropdown-container');
    
    if (!sortBtn || !sortMenu) return;
    
    let isOpen = false;
    
    function toggleMenu() {
      isOpen = !isOpen;
      if (isOpen) {
        sortMenu.classList.remove('hidden');
        sortBtn.setAttribute('aria-expanded', 'true');
        if (sortChevron) {
          sortChevron.style.transform = 'rotate(180deg)';
        }
      } else {
        sortMenu.classList.add('hidden');
        sortBtn.setAttribute('aria-expanded', 'false');
        if (sortChevron) {
          sortChevron.style.transform = 'rotate(0deg)';
        }
      }
    }
    
    function closeMenu() {
      isOpen = false;
      sortMenu.classList.add('hidden');
      sortBtn.setAttribute('aria-expanded', 'false');
      if (sortChevron) {
        sortChevron.style.transform = 'rotate(0deg)';
      }
    }
    
    // Toggle on click
    sortBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      toggleMenu();
    });
    
    // Close when clicking outside
    document.addEventListener('click', function(e) {
      if (sortContainer && !sortContainer.contains(e.target)) {
        closeMenu();
      }
    });
    
    // Close on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && isOpen) {
        closeMenu();
      }
    });
    
    // Close menu when a sort option is clicked
    sortMenu.querySelectorAll('a').forEach(function(link) {
      link.addEventListener('click', function() {
        closeMenu();
      });
    });
  })();
</script>
