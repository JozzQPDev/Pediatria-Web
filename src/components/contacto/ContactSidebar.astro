---
// ContactSidebar.astro
const { company } = Astro.props;
const phoneHref = String(company.contact.phone).replace(/[^\d+]/g, "");
const fullAddress = `${company.address.street}, ${company.address.district}`;
---

<div data-aos="zoom-in" class="lg:col-span-4 space-y-8">

  <div class="p-3 rounded-[2.5rem] shadow-[0_20px_50px_rgba(0,0,0,0.04)] border border-slate-50 animate-slide-in-left animation-delay-200">
    <div class="space-y-2">
      
      <div class="group hover:bg-slate-50 p-5 rounded-[1.8rem] transition-all duration-500">
        <div class="flex gap-5">
          <div class="w-12 h-12 rounded-2xl bg-pink-50 text-pink-500 flex items-center justify-center group-hover:scale-110 group-hover:bg-pink-500 group-hover:text-white transition-all duration-500 shrink-0 shadow-sm">
            <i class="fa-solid fa-location-dot text-lg"></i>
          </div>
          <div class="min-w-0">
            <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-1">Ubicación</p>
            <a href={company.address.mapLink} target="_blank" rel="noopener noreferrer" class="text-slate-900 text-sm font-bold leading-tight hover:text-pink-600 transition-colors">
              {fullAddress}
            </a>
          </div>
        </div>
      </div>

      <div class="group hover:bg-slate-50 p-5 rounded-[1.8rem] transition-all duration-500">
        <div class="flex gap-5">
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-500 flex items-center justify-center group-hover:scale-110 group-hover:bg-emerald-500 group-hover:text-white transition-all duration-500 shrink-0 shadow-sm">
            <i class="fa-solid fa-phone-volume text-lg"></i>
          </div>
          <div>
            <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-1">Central Telefónica</p>
            <a href={`tel:${phoneHref}`} class="text-slate-900 text-base font-black tracking-tight hover:text-emerald-600 transition-colors">
              {company.contact.phone}
            </a>
          </div>
        </div>
      </div>

      <div class="group hover:bg-slate-50 p-5 rounded-[1.8rem] transition-all duration-500">
        <div class="flex gap-5">
          <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-500 flex items-center justify-center group-hover:scale-110 group-hover:bg-blue-500 group-hover:text-white transition-all duration-500 shrink-0 shadow-sm">
            <i class="fa-solid fa-envelope text-lg"></i>
          </div>
          <div class="min-w-0">
            <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-1">Consultas</p>
            <a href={`mailto:${company.contact.email}`} class="text-slate-900 text-sm font-bold break-all hover:text-blue-600 transition-colors">
              {company.contact.email}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-white p-8 rounded-[2.5rem] shadow-2xl shadow-slate-200 animate-slide-in-left animation-delay-400 border border-white/5">
    <div class="flex items-center gap-4 mb-8">
      <div class="bg-white/10 text-orange-400 w-12 h-12 rounded-2xl flex items-center justify-center shadow-inner">
        <i class="fa-solid fa-clock-rotate-left text-xl"></i>
      </div>
      <h4 class="text-lg font-black text-slate-900  uppercase tracking-tighter">Horarios</h4>
    </div>
    
    <div class="space-y-4">
      <div class="flex justify-between items-center py-3 border-b border-white/5">
        <span class="text-slate-400 text-xs font-bold uppercase tracking-widest">Lun - Vie</span>
        <span class="text-slate-600 font-black text-sm">{company.hours.mondayToFriday.open} - {company.hours.mondayToFriday.close}</span>
      </div>
      <div class="flex justify-between items-center py-3">
        <span class="text-slate-400 text-xs font-bold uppercase tracking-widest">Sábados</span>
        <span class="text-slate-600 font-black text-sm">{company.hours.saturday.open} - {company.hours.saturday.close}</span>
      </div>
    </div>
  </div>

  <div class="group relative overflow-hidden rounded-[2.5rem] shadow-xl hover:shadow-2xl transition-all duration-700 animate-slide-in-left">
    <div class="absolute inset-0 bg-linear-to-t from-slate-900/60 via-transparent to-transparent z-10 opacity-60 group-hover:opacity-40 transition-opacity"></div>
    <img 
      src="/images/contact-building.jpg" 
      alt="Sede Dharma Ayacucho" 
      class="w-full h-72 object-cover group-hover:scale-110 transition-transform duration-1000" 
    />
    <div class="absolute bottom-6 left-6 z-20">
        <span class="px-4 py-2 bg-white/10 backdrop-blur-md border border-white/20 rounded-xl text-white text-[9px] font-black uppercase tracking-widest">
            Sede Huamanga
        </span>
    </div>
  </div>

</div>

<style>
  @keyframes slide-in-left {
    from { opacity: 0; transform: translateX(-30px); }
    to { opacity: 1; transform: translateX(0); }
  }
  .animate-slide-in-left { animation: slide-in-left 0.8s cubic-bezier(0.16, 1, 0.3, 1) both; }
  .animation-delay-200 { animation-delay: 0.2s; }
  .animation-delay-400 { animation-delay: 0.4s; }
</style>