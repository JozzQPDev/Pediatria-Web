---
import { company } from "../../data/company";
---

<div id="top-bar" class="flex bg-[linear-gradient(to_right,transparent_0%,#F9A8D4_40%,#FEF08A_75%,#BAE6FD_100%)]
  rounded-r-full ml-10 mr-0 p-1.5 pr-8 text-gray-700 justify-end items-center
  gap-6 text-[11px] font-bold uppercase tracking-wider transition-all duration-300 overflow-hidden">
  <div class="flex gap-4">
    <a href={`tel:${company.contact.phone.replace(/\s/g, "")}`}
      class="flex items-center gap-1.5 hover:text-pink-600 transition-colors duration-300 group">
      <i class="fas fa-phone w-3.5 h-3.5 group-hover:rotate-12 transition-transform"></i>
      <span>{company.contact.phone}</span>
    </a>
    <a href={company.address.mapLink} target="_blank" rel="noopener noreferrer"
      class="flex items-center gap-1.5 hover:text-blue-600 transition-colors duration-300 group">
      <i class="fas fa-location-dot w-3.5 h-3.5 group-hover:-translate-y-0.5 transition-transform"></i>
      <span>{company.address.city}, {company.address.district}</span>
    </a>
  </div>
  <div class="flex items-center gap-3 border-l border-white/30 pl-4">
    <a href={company.social.facebook} target="_blank" class="hover:text-pink-600 transition-all hover:scale-110">
      <i class="fab fa-facebook-f w-4 h-4"></i>
    </a>
    <a href={company.social.instagram} target="_blank" class="hover:text-pink-600 transition-all hover:scale-110">
      <i class="fab fa-instagram w-4 h-4"></i>
    </a>
    <a href={`mailto:${company.contact.email}`} class="hover:text-blue-600 transition-all hover:scale-110">
      <i class="fas fa-envelope w-4 h-4"></i>
    </a>
  </div>
</div>