---
import { siteConfig } from "../../data/siteConfig";
import Search from "../Search.astro";
---

<div id="top-bar-mobile" class="flex bg-[linear-gradient(to_right,#F9A8D4,#FEF08A,#BAE6FD)]
  px-4 py-1.5 text-gray-700 justify-between items-center
  gap-4 text-[10px] font-bold uppercase tracking-wider transition-all duration-300">
  <a href={`tel:${siteConfig.contact.phone.replace(/\s/g, "")}`}
    class="flex items-center gap-1 hover:text-pink-600 transition-colors">
    <i class="fas fa-phone w-3 h-3"></i>
    <span class="truncate">{siteConfig.contact.phone}</span>
  </a>
  <div class="flex items-center gap-2 border-l border-gray-400/30">
    <a href={siteConfig.socials.facebook} target="_blank" class="hover:text-pink-600 transition-all hover:scale-110">
      <i class="fab fa-facebook-f w-3.5 h-3.5"></i>
    </a>
    <a href={siteConfig.socials.instagram} target="_blank" class="hover:text-pink-600 transition-all hover:scale-110">
      <i class="fab fa-instagram w-3.5 h-3.5"></i>
    </a>
  </div>
</div>

<div class="flex items-center justify-between h-18 pb-2 px-3 sm:px-4">
  <a href="/" aria-label="Ir a inicio">
    <img src="/images/logo3.png" alt={`${siteConfig.name} logo`} class="h-16 w-auto object-contain" />
  </a>
  <div class="flex items-center gap-2 relative z-50">

    <a href="/busqueda">
    <Search />
    </a>
     <button id="menu-btn" class="lg:hidden p-2 text-[#BAE6FD] hover:bg-blue-50 rounded-xl transition-all
      focus:outline-none focus:ring-2 focus:ring-[#BAE6FD]" aria-label="Abrir menú móvil">
      <div class="w-5 h-5 flex flex-col justify-around items-center">
        <span class="w-5 h-0.5 bg-current rounded-full"></span>
        <span class="w-5 h-0.5 bg-current rounded-full"></span>
        <span class="w-5 h-0.5 bg-current rounded-full"></span>
      </div>
    </button>
  </div>
</div>