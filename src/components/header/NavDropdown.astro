---
import { services } from "../../data/services";
---

<div class="relative group">
  <a href="/servicios" class="nav-link flex items-center gap-1">
    Servicios
    <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </a>

  <div class="absolute left-1/2 -translate-x-1/2 top-full mt-2 w-175 bg-white rounded-2xl shadow-2xl
    border border-gray-100 opacity-0 invisible translate-y-4
    group-hover:opacity-100 group-hover:visible group-hover:translate-y-0
    transition-all duration-300 z-50">
    <div class="grid grid-cols-3 gap-6 p-6">
      <div>
        <h3 class="font-bold text-gray-900 mb-4">Pediatría</h3>
        <div class="space-y-3">
          {services.slice(0, 3).map((s) => (
            <a href={`/servicios/${s.slug}`} class="block text-gray-600 hover:text-[#F9A8D4] transition">
              {s.title}
            </a>
          ))}
        </div>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-4">Tratamientos</h3>
        <div class="space-y-3">
          {services.slice(3, 6).map((s) => (
            <a href={`/servicios/${s.slug}`} class="block text-gray-600 hover:text-[#F9A8D4] transition">
              {s.title}
            </a>
          ))}
        </div>
      </div>
      <div>
        <div class="bg-pink-50 rounded-xl p-5">
          <h4 class="font-bold text-gray-900 mb-2">Consulta médica</h4>
          <p class="text-sm text-gray-500 mb-4">Agenda tu cita con nuestros especialistas.</p>
          <a href="/contacto" class="inline-flex items-center gap-2 bg-[#F9A8D4] text-white px-4 py-2 rounded-lg text-sm font-semibold hover:scale-105 transition">
            Pedir cita
          </a>
        </div>
      </div>
    </div>
    <div class="border-t border-gray-100 p-4 text-center">
      <a href="/servicios" class="text-sm font-semibold text-[#F9A8D4] hover:underline">
        Ver todos los servicios →
      </a>
    </div>
  </div>
</div>