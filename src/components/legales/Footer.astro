---
// Footer simplificado y responsivo para páginas legales
import { siteConfig } from "../../data/siteConfig";
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-50 border-t border-gray-200 py-8 md:py-12">
  <div class="max-w-7xl mx-auto px-4">
    
    <!-- Contenedor principal - Grid responsivo -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-8">
      
      <!-- Columna 1: Logo e información -->
      <div class="flex flex-col items-center md:items-start gap-4">
        <div class="flex items-center gap-3">
          <div class="bg-white p-3 rounded-3xl inline-block w-fit shadow-lg transform -rotate-2 hover:rotate-0 transition-transform duration-300">
                    <img src="/images/logo3.png" alt="Logo Clínica" class="h-28 object-contain">
          </div>
        </div>
        <p class="text-sm text-gray-600 text-center md:text-left">
          {siteConfig.name} - {siteConfig.tagline}
        </p>
        <p class="text-xs text-gray-500 text-center md:text-left">
          {siteConfig.location.city}, {siteConfig.location.country}
        </p>
      </div>

      <!-- Columna 2: Enlaces rápidos -->
      <div class="flex flex-col items-center md:items-start gap-4">
        <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wide">Enlaces</h3>
        <div class="flex flex-col gap-2 text-center md:text-left">
          <a href="/" class="text-sm text-gray-500 hover:text-[#5086c1] transition-colors">
            Inicio
          </a>
          <a href="/nosotros" class="text-sm text-gray-500 hover:text-[#5086c1] transition-colors">
            Nosotros
          </a>
          <a href="/servicios" class="text-sm text-gray-500 hover:text-[#5086c1] transition-colors">
            Servicios
          </a>
          <a href="/contacto" class="text-sm text-gray-500 hover:text-[#5086c1] transition-colors">
            Contacto
          </a>
        </div>
      </div>

      <!-- Columna 3: Legal -->
      <div class="flex flex-col items-center md:items-start gap-4">
        <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wide">Legal</h3>
        <div class="flex flex-col gap-2 text-center md:text-left">
          <a href="/legales/aviso-legal" class="text-sm text-gray-500 hover:text-[#5086c1] transition-colors font-medium">
            Aviso Legal
          </a>
          <a href="/legales/privacidad" class="text-sm text-gray-500 hover:text-[#5086c1] transition-colors font-medium">
            Política de Privacidad
          </a>
          <a href="/legales/terminos" class="text-sm text-gray-500 hover:text-[#5086c1] transition-colors font-medium">
            Términos de Uso
          </a>
          <a href="/legales/cookies" class="text-sm text-gray-500 hover:text-[#5086c1] transition-colors font-medium">
            Política de Cookies
          </a>
        </div>
      </div>

    </div>

    <!-- Información de contacto -->
    <div class="flex flex-wrap justify-center items-center gap-3 md:gap-6 py-6 border-t border-b border-gray-200 mb-6">
      <a 
        href={`tel:${siteConfig.contact.phone}`} 
        class="flex items-center gap-2 text-xs md:text-sm text-gray-600 hover:text-[#5086c1] transition-colors"
      >
        <i data-lucide="phone" class="w-4 h-4"></i>
        <span class="hidden sm:inline">{siteConfig.contact.phone}</span>
        <span class="sm:hidden">Llamar</span>
      </a>
      <span class="hidden md:inline text-gray-300">|</span>
      <a 
        href={siteConfig.contact.whatsappUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center gap-2 text-xs md:text-sm text-gray-600 hover:text-[#5086c1] transition-colors"
      >
        <i class="bi bi-whatsapp text-lg"></i>
        <span>WhatsApp</span>
      </a>
      <span class="hidden md:inline text-gray-300">|</span>
      <a 
        href={`mailto:${siteConfig.contact.email}`} 
        class="flex items-center gap-2 text-xs md:text-sm text-gray-600 hover:text-[#5086c1] transition-colors"
      >
        <i data-lucide="mail" class="w-4 h-4"></i>
        <span class="hidden lg:inline">{siteConfig.contact.email}</span>
        <span class="lg:hidden">Email</span>
      </a>
    </div>

    <!-- Copyright y dirección -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-center md:text-left">
      <p class="text-xs text-gray-500">
        © {currentYear} {siteConfig.name}. Todos los derechos reservados. Propiedad de {siteConfig.owner}.
      </p>
      <p class="text-xs text-gray-400 flex items-center gap-1">
        <i data-lucide="map-pin" class="w-3 h-3"></i>
        <span class="hidden sm:inline">{siteConfig.location.fullAddress}</span>
        <span class="sm:hidden">{siteConfig.location.address}</span>
      </p>
    </div>

  </div>
</footer>

<script is:inline>
  // Inicializar iconos
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
</script>

