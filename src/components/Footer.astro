---
// Tu código de importaciones permanece igual
import { siteConfig } from "../data/siteConfig";
const currentYear = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-gray-900 text-gray-300 pt-20 md:pt-32 pb-10">
  <!-- SVG para borde ondulado como olas -->
  <svg viewBox="0 0 1200 120" preserveAspectRatio="none" class="absolute top-0 left-0 w-full h-16 md:h-32 z-10" fill="#ffffff">
    <path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,52.47V0Z" opacity=".25"></path>
    <path d="M0,0V15.81C13,36.92,27.64,56.86,47.69,72.05,99.41,111.27,165,111,224.58,91.58c31.15-10.15,60.09-26.07,89.67-39.8,40.92-19,84.73-46,130.83-49.67,36.26-2.85,70.9,9.42,98.6,31.56,31.77,25.39,62.32,62,103.63,73,40.44,10.79,81.35-6.69,119.13-24.28s75.16-39,116.92-43.05c59.73-5.85,113.28,22.88,168.9,38.84,30.2,8.66,59,6.17,87.09-7.5,22.43-10.89,48-26.93,60.65-49.24V0Z" opacity=".5"></path>
    <path d="M0,0V5.63C149.93,59,314.09,71.32,475.83,42.57c43-7.64,84.23-20.12,127.61-26.46,59-8.63,112.48,12.24,165.56,35.4C827.93,77.22,886,95.24,951.2,90c86.53-7,172.46-45.71,248.8-84.81V0Z"></path>
  </svg>
  
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      
      <div class="space-y-6 text-center md:text-left">
        <a href="/" class="flex items-center justify-center md:justify-start gap-2 group" aria-label="Ir a inicio">
          <!-- Logo con gradiente sutil y animación bounce -->
          <div class="bg-linear-to-br from-blue-500 to-green-400 p-2 rounded-xl text-white group-hover:bg-green-500 group-hover:animate-bounce transition-all duration-300">
            <i data-lucide="baby" class="w-6 h-6" aria-hidden="true"></i>
          </div>
          <div class="flex flex-col  md:items-start">
            <span class="text-xl md:text-2xl font-black tracking-tighter text-white italic leading-none flex items-center gap-1.5">
              {siteConfig.name.split(" ")[0]}
              <span class="text-green-400 not-italic tracking-tight">{siteConfig.name.split(" ").slice(1).join(" ")}</span>
            </span>
            <span class="text-[10px] font-bold tracking-[0.2em] text-gray-400 uppercase mt-1 leading-none">
              {siteConfig.location.city} · {siteConfig.location.district}
            </span>
          </div>
        </a>
        <p class="text-sm leading-relaxed text-gray-400 text-balance">
          {siteConfig.tagline}. Innovación médica con calidez humana para los más pequeños de casa en {siteConfig.location.district}.
        </p>
        <div class="flex justify-center md:justify-start gap-4">
          <a href={siteConfig.socials.facebook} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-gray-800 rounded-xl flex items-center justify-center hover:bg-blue-500 hover:text-white transition-all hover:-translate-y-1 hover:scale-110" aria-label="Facebook">
            <i data-lucide="facebook" class="w-5 h-5" aria-hidden="true"></i>
          </a>
          <a href={siteConfig.socials.instagram} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-gray-800 rounded-xl flex items-center justify-center hover:bg-pink-500 hover:text-white transition-all hover:-translate-y-1 hover:scale-110" aria-label="Instagram">
            <i data-lucide="instagram" class="w-5 h-5" aria-hidden="true"></i>
          </a>
          <a href={siteConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-gray-800 rounded-xl flex items-center justify-center hover:bg-green-500 hover:text-white transition-all hover:-translate-y-1 hover:scale-110" aria-label="WhatsApp">
            <i class="bi bi-whatsapp text-lg" aria-hidden="true"></i>
          </a>
          <a href={siteConfig.socials.linkedin} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-gray-800 rounded-xl flex items-center justify-center hover:bg-blue-400 hover:text-white transition-all hover:-translate-y-1 hover:scale-110" aria-label="LinkedIn">
            <i data-lucide="linkedin" class="w-5 h-5" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="text-left">
        <h4 class="text-white font-bold uppercase tracking-wide mb-8 text-sm italic">Navegación</h4>
        <ul class="space-y-4 text-sm font-medium">
          <li><a href="/" class="hover:text-green-400 transition-colors flex items-center gap-2 group" aria-label="Ir a inicio"><i data-lucide="chevron-right" class="w-3 h-3 text-green-500 group-hover:scale-110 transition-transform" aria-hidden="true"></i> Inicio</a></li>
          <li><a href="/nosotros" class="hover:text-green-400 transition-colors flex items-center gap-2 group" aria-label="Sobre nosotros"><i data-lucide="chevron-right" class="w-3 h-3 text-green-500 group-hover:scale-110 transition-transform" aria-hidden="true"></i> Sobre Nosotros</a></li>
          <li><a href="/servicios" class="hover:text-green-400 transition-colors flex items-center gap-2 group" aria-label="Servicios"><i data-lucide="chevron-right" class="w-3 h-3 text-green-500 group-hover:scale-110 transition-transform" aria-hidden="true"></i> Servicios</a></li>
          <li><a href="/equipo" class="hover:text-green-400 transition-colors flex items-center gap-2 group" aria-label="Staff médico"><i data-lucide="chevron-right" class="w-3 h-3 text-green-500 group-hover:scale-110 transition-transform" aria-hidden="true"></i> Staff Médico</a></li>
          <li><a href="/contacto" class="hover:text-green-400 transition-colors flex items-center gap-2 group" aria-label="Contacto"><i data-lucide="chevron-right" class="w-3 h-3 text-green-500 group-hover:scale-110 transition-transform" aria-hidden="true"></i> Contacto</a></li>
        </ul>
      </div>

      <div class="text-left">
        <h4 class="text-white font-bold uppercase tracking-wide mb-8 text-sm italic">Especialidades</h4>
        <ul class="space-y-4 text-sm text-gray-400">
          <li class="flex items-center gap-2 hover:text-yellow-300 transition-colors cursor-default group">
            <div class="w-1.5 h-1.5 bg-green-500 rounded-full group-hover:animate-pulse"></div>
            Control de Crecimiento
          </li>
          <li class="flex items-center gap-2 hover:text-yellow-300 transition-colors cursor-default group">
            <div class="w-1.5 h-1.5 bg-green-500 rounded-full group-hover:animate-pulse"></div>
            Vacunación Integral
          </li>
          <li class="flex items-center gap-2 hover:text-yellow-300 transition-colors cursor-default group">
            <div class="w-1.5 h-1.5 bg-green-500 rounded-full group-hover:animate-pulse"></div>
            Psicología Infantil
          </li>
          <li class="flex items-center gap-2 hover:text-yellow-300 transition-colors cursor-default group">
            <div class="w-1.5 h-1.5 bg-green-500 rounded-full group-hover:animate-pulse"></div>
            Atención Recién Nacido
          </li>
        </ul>
      </div>

      <div class="text-left">
        <h4 class="text-white font-bold uppercase tracking-wide mb-8 text-sm italic">Ubicación</h4>
        <div class="space-y-5 text-sm text-gray-400">
          <div class="flex items-start gap-3 group">
            <i data-lucide="map-pin" class="w-5 h-5 text-green-500 group-hover:scale-110 group-hover:animate-bounce transition-all duration-300" aria-hidden="true"></i>
            <span class="leading-relaxed">{siteConfig.location.fullAddress}</span>
          </div>
          <div class="flex items-center gap-3 group">
            <i data-lucide="phone" class="w-5 h-5 text-green-500 group-hover:scale-110 group-hover:animate-bounce transition-all duration-300" aria-hidden="true"></i>
            <span>{siteConfig.contact.phone}</span>
          </div>
          <div class="flex items-center gap-3 group">
            <i data-lucide="mail" class="w-5 h-5 text-green-500 group-hover:scale-110 group-hover:animate-bounce transition-all duration-300" aria-hidden="true"></i>
            <span class="break-all">{siteConfig.contact.email}</span>
          </div>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-800 pt-10 flex flex-col md:flex-row justify-between items-center gap-6">
      <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-gray-500 text-center md:text-left">
        © {currentYear} {siteConfig.name}. <br class="md:hidden"/>
        <span class="text-gray-600 italic ml-0 md:ml-2">Protegiendo el futuro de los más pequeños.</span>
      </p>
      <div class="flex gap-8 text-[11px] font-black uppercase tracking-widest text-gray-500">
        <a href="/privacidad" class="hover:text-green-400 transition-colors" aria-label="Política de privacidad">Privacidad</a>
        <a href="/terminos" class="hover:text-green-400 transition-colors" aria-label="Términos y condiciones">Términos</a>
      </div>
    </div>
  </div>
</footer>

<style>
  @reference "../styles/global.css";
  
  /* Animación bounce para íconos (opcional, añade diversión) */
  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-10px); }
    60% { transform: translateY(-5px); }
  }
  .animate-bounce {
    animation: bounce 1s infinite;
  }

  /* Pulse para puntos en especialidades */
  .animate-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>