---
// Tu código de importaciones permanece igual
import { siteConfig } from "../data/siteConfig";
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#5086c1] text-white pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      <div class="flex flex-col gap-6">
        <div
  class="bg-white p-3 rounded-3xl inline-block w-fit shadow-lg transform -rotate-2 hover:rotate-0 transition-transform duration-300 mx-auto md:mx-0"
>
  <img
    src="/images/logo3.png"
    alt="Logo Clínica"
    class="h-28 object-contain"
  />
</div>
        <p class="text-sm leading-relaxed">
          Dedicados a brinda salud integral y bienestar a los más pequeños de la
          casa, con la calidez y el profesionalismo que tu familia merece.
        </p>
        <div class="flex justify-center md:justify-start gap-4">
          <a
            href={siteConfig.socials.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-purple-300 rounded-xl flex items-center justify-center hover:bg-blue-300 hover:text-white transition-all hover:-translate-y-1 hover:scale-110"
            aria-label="Facebook"
          >
            <i data-lucide="facebook" class="w-5 h-5" aria-hidden="true"></i>
          </a>
          <a
            href={siteConfig.socials.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-pink-200 rounded-xl flex items-center justify-center hover:bg-pink-300 hover:text-white transition-all hover:-translate-y-1 hover:scale-110"
            aria-label="Instagram"
          >
            <i data-lucide="instagram" class="w-5 h-5" aria-hidden="true"></i>
          </a>
          <a
            href={siteConfig.contact.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-green-200 rounded-xl flex items-center justify-center hover:bg-green-300 hover:text-white transition-all hover:-translate-y-1 hover:scale-110"
            aria-label="WhatsApp"
          >
            <i class="bi bi-whatsapp text-lg" aria-hidden="true"></i>
          </a>
          <a
            href={siteConfig.socials.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-blue-200 rounded-xl flex items-center justify-center hover:bg-blue-300 hover:text-white transition-all hover:-translate-y-1 hover:scale-110"
            aria-label="LinkedIn"
          >
            <i data-lucide="linkedin" class="w-5 h-5" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div>
        <h4 class="text-lg font-bold mb-6 border-l-4 border-[#98D8AA] pl-3">
          Navegación
        </h4>
        <ul class="space-y-4 text-sm">
          <li class="flex items-center gap-2">
            <!-- Icono de casa -->
            <svg
              class="w-4 h-4 text-[#98D8AA]"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 9.75L12 3l9 6.75V21a.75.75 0 01-.75.75H3.75A.75.75 0 013 21V9.75z"
              ></path>
            </svg>
            <a href="/" class="hover:text-gray-700 transition-colors">Inicio</a>
          </li>

          <li class="flex items-center gap-2">
            <!-- Icono de información -->
            <svg
              class="w-4 h-4 text-[#98D8AA]"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13 16h-1v-4h-1m1-4h.01M12 21c4.97 0 9-4.03 9-9s-4.03-9-9-9-9 4.03-9 9 4.03 9 9 9z"
              ></path>
            </svg>
            <a href="/nosotros" class="hover:text-gray-700 transition-colors"
              >Sobre Nosotros</a
            >
          </li>

          <li class="flex items-center gap-2">
            <!-- Icono de corazón/servicios -->
            <svg
              class="w-4 h-4 text-[#98D8AA]"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"
              ></path>
            </svg>
            <a href="/servicios" class="hover:text-gray-700 transition-colors"
              >Servicios Médicos</a
            >
          </li>

          <li class="flex items-center gap-2">
            <!-- Icono de usuarios/equipo -->
            <svg
              class="w-4 h-4 text-[#98D8AA]"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 20h5v-1a4 4 0 00-3-3.87M9 20h5v-1a4 4 0 00-3-3.87M12 12a4 4 0 100-8 4 4 0 000 8z"
              ></path>
            </svg>
            <a href="/equipo" class="hover:text-gray-700 transition-colors"
              >Nuestro Equipo</a
            >
          </li>

          <!-- NUEVO: Blogs -->
          <li class="flex items-center gap-2">
            <!-- Icono de blog (documento) -->
            <svg
              class="w-4 h-4 text-[#98D8AA]"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12h6M9 16h6M14 2H7a2 2 0 00-2 2v16a2 2 0 002 2h10a2 2 0 002-2V8l-5-6z"
              ></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 2v6h6"
              ></path>
            </svg>
            <a href="/blogs" class="hover:text-gray-700 transition-colors"
              >Blogs</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h4 class="text-lg font-bold mb-6 border-l-4 border-[#A8D8EA] pl-3">
          Contacto
        </h4>
        <ul class="space-y-4 text-sm">
          <li class="flex items-start gap-3">
            <i data-lucide="map-pin" class="w-5 h-5 text-[#A8D8EA] shrink-0"
            ></i>
            <span
              >{siteConfig.location.address}, {
                siteConfig.location.district
              }</span
            >
          </li>
          <li class="flex items-center gap-3">
            <i data-lucide="phone" class="w-5 h-5 text-[#A8D8EA] shrink-0"></i>
            <span>{siteConfig.contact.phone}</span>
          </li>
          <li class="flex items-center gap-3">
            <i data-lucide="mail" class="w-5 h-5 text-[#A8D8EA] shrink-0"></i>
            <span>{siteConfig.contact.email}</span>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="text-lg font-bold mb-6 border-l-4 border-[#FFB7C5] pl-3">
          Horario
        </h4>
        <div
          class="bg-purple-300/30 p-4 rounded-2xl border border-purple-300/50"
        >
          <div class="flex justify-between text-sm mb-2">
            <span>Lun - Vie:</span>
            <span>8:00 - 20:00</span>
          </div>
          <div class="flex justify-between text-sm mb-2">
            <span>Sábados:</span>
            <span>9:00 - 14:00</span>
          </div>
          <div class="flex justify-between text-sm text-gray-700 font-bold">
            <span>Domingos:</span>
            <span>Cerrado</span>
          </div>
        </div>
      </div>
    </div>

    <div
      class="border-t border-gray-300 pt-8 flex flex-col md:flex-row justify-between items-center gap-4"
    >
      <p class="text-xs">
        © {new Date().getFullYear()}
        {siteConfig.name}. Todos los derechos reservados. Propiedad de {
          siteConfig.owner
        }.
      </p>
      <div class="flex gap-6 text-xs">
        <a
          href="/legales/aviso-legal"
          class="hover:text-gray-700 transition-colors">Aviso Legal</a
        >
        <a
          href="/legales/privacidad"
          class="hover:text-gray-700 transition-colors"
          >Política de Privacidad</a
        >
        <a
          href="/legales/terminos"
          class="hover:text-gray-700 transition-colors">Términos de Servicio</a
        >
        <a href="/legales/cookies" class="hover:text-gray-700 transition-colors"
          >Política de Cookies</a
        >
      </div>
    </div>
  </div>

  <div
    class="h-1.5 w-full bg-[linear-gradient(to_right,#FFB7C5,#FFEAA7,#A8D8EA)] mt-8"
  >
  </div>
</footer>

<style>
  @reference "../styles/global.css";

  /* Animación bounce para íconos (opcional, añade diversión) */
  @keyframes bounce {
    0%,
    20%,
    50%,
    80%,
    100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(-10px);
    }
    60% {
      transform: translateY(-5px);
    }
  }
  .animate-bounce {
    animation: bounce 1s infinite;
  }

  /* Pulse para puntos en especialidades */
  .animate-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>
