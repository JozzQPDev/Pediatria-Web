---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { siteConfig } from '../data/siteConfig';
---

<Layout title={`Contacto | ${siteConfig.name}`}>
  <Hero 
    title="Estamos para ayudarte" 
    subtitle={`¿Tienes alguna duda sobre la salud de tu pequeño? Contáctanos por cualquier medio o visítanos en nuestra sede en ${siteConfig.location.district}.`} 
    backgroundImage="/img/hero-contacto.jpg"
  >
    <div class="mt-10 flex flex-wrap gap-4 justify-center md:justify-start">
      <a href="#contact-section" class="bg-white text-green-600 px-8 py-4 rounded-2xl font-bold shadow-xl hover:bg-green-50 hover:-translate-y-1 transition-all duration-300">
        Ver Ubicación
      </a>
      <a href={siteConfig.contact.whatsappUrl} target="_blank" class="bg-emerald-500 text-white px-8 py-4 rounded-2xl font-bold shadow-xl shadow-emerald-200 hover:bg-emerald-600 hover:-translate-y-1 transition-all duration-300 flex items-center gap-2">
        <i data-lucide="message-circle" class="w-5 h-5"></i>
        WhatsApp Directo
      </a>
    </div>
  </Hero>

  <section id="contact-section" class="py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4">
      
      <div class="mb-20 text-center">
        <span class="inline-block text-emerald-600 font-black uppercase tracking-[0.25em] text-[11px] bg-emerald-100/50 px-5 py-2.5 rounded-full mb-6">
          Central de Atención
        </span>
        <h2 class="text-4xl md:text-6xl font-black text-slate-900 tracking-tight leading-tight">
          Canales Oficiales <br/>
          <span class="bg-clip-text text-transparent bg-linear-to-r from-emerald-500 to-blue-600">
            en {siteConfig.location.city}
          </span>
        </h2>
      </div>

      <div class="grid lg:grid-cols-12 gap-10 items-start">
        
        <div class="lg:col-span-4 space-y-8">
          
          <div class="relative overflow-hidden rounded-4xl shadow-2xl group ring-4 ring-white" role="complementary">
            <img src="/images/contact-emergency.jpg" alt="Emergencias" class="w-full h-72 object-cover group-hover:scale-110 transition-transform duration-700" />
            <div class="absolute inset-0 bg-linear-to-br from-red-600/95 via-red-600/80 to-transparent"></div>
            <div class="absolute inset-0 p-8 flex flex-col justify-end text-white">
              <div class="flex items-center gap-3 mb-3">
                <div class="bg-white/20 p-2 rounded-xl backdrop-blur-md animate-pulse">
                   <i data-lucide="ambulance" class="w-7 h-7"></i>
                </div>
                <span class="font-black text-2xl uppercase tracking-tighter italic">Emergencias 24h</span>
              </div>
              <p class="text-red-50 mb-6 text-sm leading-relaxed">Atención inmediata sin previa cita para casos críticos pediátricos.</p>
              <a href={`tel:${siteConfig.contact.phone}`} class="bg-white text-red-600 py-4 rounded-2xl font-black text-center shadow-lg hover:bg-red-50 transition-all active:scale-95 flex items-center justify-center gap-2">
                <i data-lucide="phone-call" class="w-5 h-5"></i> LLAMAR AHORA
              </a>
            </div>
          </div>

          <div class="bg-white p-8 rounded-4xl shadow-sm border border-slate-100 space-y-6">
            <div class="flex items-start gap-4 p-4 rounded-2xl hover:bg-slate-50 transition-colors group">
              <div class="bg-blue-50 text-blue-500 p-3 rounded-xl group-hover:scale-110 transition-transform">
                <i data-lucide="phone" class="w-6 h-6"></i>
              </div>
              <div>
                <p class="text-[10px] font-black uppercase text-slate-400 tracking-widest">Central Telefónica</p>
                <p class="text-slate-900 font-bold text-lg">{siteConfig.contact.phone}</p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-4 rounded-2xl hover:bg-slate-50 transition-colors group">
              <div class="bg-emerald-50 text-emerald-500 p-3 rounded-xl group-hover:scale-110 transition-transform">
                <i data-lucide="mail" class="w-6 h-6"></i>
              </div>
              <div>
                <p class="text-[10px] font-black uppercase text-slate-400 tracking-widest">Consultas Online</p>
                <p class="text-slate-900 font-bold text-sm break-all">{siteConfig.contact.email}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-8 space-y-8">
          
          <div class="relative rounded-4xl shadow-xl overflow-hidden border-8 border-white group">
            <iframe 
              src={siteConfig.location.iframeUrl} 
              class="w-full h-112.5 grayscale group-hover:grayscale-0 transition-all duration-1000"
              style="border:0;" 
              allowfullscreen="" 
              loading="lazy"
              title="Ubicación de la Clínica">
            </iframe>
            <div class="absolute bottom-6 left-1/2 -translate-x-1/2">
              <a href={siteConfig.location.googleMapsLink} target="_blank" class="bg-white/90 backdrop-blur-md text-slate-900 px-8 py-3 rounded-2xl font-bold shadow-2xl flex items-center gap-2 hover:bg-white transition-all">
                <i data-lucide="map-pin" class="w-5 h-5 text-emerald-500"></i>
                Ver en Google Maps
              </a>
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-8">
            <div class="bg-white p-8 rounded-4xl border border-slate-100 shadow-xs group">
              <div class="bg-amber-50 text-amber-600 w-12 h-12 rounded-xl flex items-center justify-center mb-6">
                <i data-lucide="clock" class="w-6 h-6"></i>
              </div>
              <h4 class="text-xl font-black text-slate-900 mb-4">Horarios</h4>
              <div class="space-y-3 text-slate-600 font-medium">
                <div class="flex justify-between border-b border-slate-50 pb-2">
                  <span>Lunes a Viernes</span>
                  <span class="text-slate-900 font-bold">08:00 - 20:00</span>
                </div>
                <div class="flex justify-between border-b border-slate-50 pb-2">
                  <span>Sábados</span>
                  <span class="text-slate-900 font-bold">09:00 - 14:00</span>
                </div>
                <p class="text-xs text-emerald-600 font-bold italic mt-4 uppercase tracking-tighter">
                  * {siteConfig.schedule.emergencies}
                </p>
              </div>
            </div>

            <div class="bg-slate-900 p-8 rounded-4xl text-white shadow-xl relative overflow-hidden group">
              <div class="absolute -right-10 -top-10 w-40 h-40 bg-emerald-500/20 rounded-full blur-3xl group-hover:bg-emerald-500/40 transition-all"></div>
              <div class="relative z-10">
                <div class="bg-white/10 text-emerald-400 w-12 h-12 rounded-xl flex items-center justify-center mb-6">
                  <i data-lucide="sparkles" class="w-6 h-6"></i>
                </div>
                <h4 class="text-xl font-black mb-4">Comodidades</h4>
                <ul class="space-y-3">
                  {['Estacionamiento gratuito', 'Zona de lactancia', 'Wi-Fi alta velocidad', 'Acceso para coches'].map((item) => (
                    <li class="flex items-center gap-3 text-slate-300 text-sm">
                      <i data-lucide="check" class="w-4 h-4 text-emerald-400"></i>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>
 <!-- Sede Principal con imagen mejorada -->
          <div class="group relative overflow-hidden rounded-3xl shadow-lg hover:shadow-2xl transition-all duration-500 cursor-pointer focus-within:ring-2 focus-within:ring-green-500" role="article" aria-label="Información de sede principal">
            <img src="/images/contact-building.jpg" alt="Vista exterior de la sede principal de la clínica pediátrica" class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            <div class="absolute inset-0 bg-linear-to-t from-green-600/90 to-transparent opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-500 flex flex-col justify-end p-6">
              <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-green-600 mb-4 group-hover:animate-bounce">
                <i data-lucide="building-2" class="w-7 h-7" aria-hidden="true"></i>
              </div>
              <h3 class="text-xl font-bold text-white mb-2">Sede Principal</h3>
              <p class="text-green-100 text-sm">{siteConfig.location.fullAddress}</p>
            </div>
          </div>
 
      </div>
    </div>
  </section>
</Layout>