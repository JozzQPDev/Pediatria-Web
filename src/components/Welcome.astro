---
// Welcome.astro
// Componente modal de bienvenida con estilo inspirado en Clínica Ricardo Palma
import { siteConfig } from "../data/siteConfig";
---

<div id="myModal" class="fixed inset-0 bg-black/60 justify-center items-center z-50 hidden animate-fadeIn overflow-y-auto" role="dialog" aria-modal="true">
  
  <div class="relative z-10 bg-[#00A89E] p-6 md:p-10 rounded-[2.5rem] max-w-2xl w-full mx-4 shadow-2xl border-2 border-white/20 animate-slideIn flex flex-col md:flex-row items-center">
    
    <button 
      id="closeModal" 
      class="absolute -top-5 -right-5 w-12 h-12 bg-[#FF4B5C] hover:bg-[#ff3548] text-white rounded-full flex items-center justify-center text-3xl font-bold shadow-xl transition-all hover:scale-110 z-50 border-4 border-white focus:outline-none"
      aria-label="Cerrar modal"
    >
      &times;
    </button>

    <div class="shrink-0 mb-4 md:mr-6 md:mb-0">
      <img src="/images/welcome.png" alt="Imagen de bienvenida" class="w-auto h-48 md:h-72 rounded-2xl object-cover" loading="lazy" />
    </div>
    
    <div class="text-center flex-1 mb-4 md:mb-0">
      <h2 id="modal-title" class="text-2xl md:text-3xl font-bold text-white mb-4 font-sans drop-shadow-lg leading-tight">
        ¡Bienvenido a <br/>
        <span class="text-blue-200">{siteConfig.name.split(" ")[0]}</span>
        <span class="text-white">{siteConfig.name.split(" ").slice(1).join(" ")}</span>
      </h2>
      
      <p class="text-sm md:text-base text-white/90 leading-relaxed mb-6 md:mb-8 drop-shadow-md">
        Estamos aquí para cuidar la salud de tus hijos con amor y profesionalismo.
      </p>

      <button id="closeBtn" class="bg-[#003B63] hover:bg-[#002a47] text-white px-8 py-3 md:px-10 md:py-4 rounded-full text-base md:text-lg font-bold transition-all duration-300 shadow-lg transform active:scale-95 border border-white/10">
        ¡Empezar!
      </button>
    </div>

    <div class="ml-4 animate-bounce hidden md:block">
      <i data-lucide="heart" class="w-12 h-12 text-white/40 fill-current"></i>
    </div>
  </div>
</div>

<style>
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes slideIn { 
    from { transform: scale(0.9) translateY(20px); opacity: 0; } 
    to { transform: scale(1) translateY(0); opacity: 1; } 
  }
  @keyframes fadeOut { from { opacity: 1; } to { opacity: 0; } }

  .animate-fadeIn { animation: fadeIn 0.3s ease-out forwards; }
  .animate-slideIn { animation: slideIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
  .animate-fadeOut { animation: fadeOut 0.3s ease-in forwards; }
</style>

<script is:inline>
  // Renderiza íconos de Lucide si no se hace automáticamente
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }

  const modal = document.getElementById('myModal');
  const closeBtn = document.getElementById('closeBtn');
  const closeX = document.getElementById('closeModal');

  if (modal && closeBtn && closeX) {
    const closeModal = () => {
      modal.classList.add('animate-fadeOut');
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }, 300);
    };

    // Muestra el modal en cada recarga de la página
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    closeBtn.focus();

    // Cierre automático en 5 segundos
    const autoCloseTimeout = setTimeout(() => {
      closeModal();
    }, 5000);

    // Agrega event listeners para cerrar el modal
    const handleClose = () => {
      clearTimeout(autoCloseTimeout); // Cancela el cierre automático si el usuario cierra manualmente
      closeModal();
    };

    closeBtn.addEventListener('click', handleClose);
    closeX.addEventListener('click', handleClose);

    // Cierra con Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        handleClose();
      }
    });
  }
</script>