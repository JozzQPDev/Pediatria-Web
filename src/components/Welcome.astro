---
// Welcome.astro
// Componente modal de bienvenida mejorado
import { siteConfig } from "../data/siteConfig";
---

<div id="myModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm justify-center items-center z-50 hidden animate-fadeIn overflow-y-auto" role="dialog" aria-modal="true">
  
  <!-- Elementos decorativos de fondo -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-20 -left-20 w-64 h-64 bg-teal-400/20 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute -bottom-20 -right-20 w-80 h-80 bg-blue-400/20 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
  </div>

  <div class="relative z-10 bg-gradient-to-br from-[#00A89E] via-[#00B5A7] to-[#00A89E] p-6 md:p-8 lg:p-10 rounded-[2rem] max-w-3xl w-full mx-4 shadow-2xl border border-white/20 animate-slideIn">
    
    <!-- Botón de cierre mejorado -->
    <button 
      id="closeModal" 
      class="absolute -top-4 -right-4 w-10 h-10 md:w-12 md:h-12 bg-white/20 hover:bg-[#FF4B5C] hover:scale-110 text-white rounded-full flex items-center justify-center text-2xl md:text-3xl font-bold shadow-xl transition-all duration-300 z-50 border-2 border-white/30 backdrop-blur-sm focus:outline-none group"
      aria-label="Cerrar modal"
    >
      <span class="group-hover:rotate-90 transition-transform duration-300">&times;</span>
    </button>

    <!-- Contenido principal -->
    <div class="flex flex-col lg:flex-row items-center gap-6 lg:gap-8">
      
      <!-- Imagen con marco decorativo -->
      <div class="shrink-0 relative">
        <div class="absolute inset-0 bg-white/30 rounded-3xl transform rotate-3 scale-105"></div>
        <div class="relative bg-white/10 rounded-3xl p-2 backdrop-blur-sm">
          <img 
            src="/images/welcome.png" 
            alt="Imagen de bienvenida" 
            class="w-40 h-40 md:w-48 md:h-48 lg:h-56 rounded-2xl object-cover shadow-lg" 
            loading="lazy" 
          />
        </div>
        <!-- Badge decorativo -->
        <div class="absolute -bottom-3 -right-3 bg-white text-[#00A89E] px-3 py-1 rounded-full text-xs font-bold shadow-lg flex items-center gap-1">
          <span>❤️</span> #1 en Pediátrica
        </div>
      </div>
      
      <!-- Texto y CTA -->
      <div class="text-center flex-1">
        <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-sm px-4 py-1.5 rounded-full mb-4">
          <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
          <span class="text-white/90 text-sm font-medium">Atención disponible</span>
        </div>
        
        <h2 id="modal-title" class="text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-3 md:mb-4 leading-tight">
          ¡Bienvenido a <br/>
          <span class="text-white drop-shadow-lg">{siteConfig.name}</span>
        </h2>
        
        <p class="text-white/90 md:text-lg leading-relaxed mb-6 max-w-md mx-auto">
          {siteConfig.tagline}
        </p>

        <!-- Features highlights -->
        <div class="flex flex-wrap justify-center gap-3 mb-6 md:mb-8">
          <div class="flex items-center gap-1.5 bg-white/15 backdrop-blur-sm px-3 py-1.5 rounded-full text-white/90 text-xs md:text-sm">
            <span class="text-lg">👶</span> Cuidado infantil
          </div>
          <div class="flex items-center gap-1.5 bg-white/15 backdrop-blur-sm px-3 py-1.5 rounded-full text-white/90 text-xs md:text-sm">
            <span class="text-lg">🏥</span> Especialistas
          </div>
          <div class="flex items-center gap-1.5 bg-white/15 backdrop-blur-sm px-3 py-1.5 rounded-full text-white/90 text-xs md:text-sm">
            <span class="text-lg">💚</span> Amor + Profesionalismo
          </div>
        </div>

        <button id="closeBtn" class="group relative bg-white text-[#00A89E] px-8 py-3 md:px-10 md:py-4 rounded-full text-base md:text-lg font-bold transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-1 active:scale-95 overflow-hidden">
          <span class="relative z-10 flex items-center gap-2">
            ¡Empezar!
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </span>
          <div class="absolute inset-0 bg-gradient-to-r from-teal-50 to-white opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </button>
      </div>

      <!-- Elementos decorativos del lado -->
      <div class="hidden lg:flex flex-col items-center gap-4 animate-float">
        <div class="text-4xl opacity-30 hover:opacity-60 transition-opacity cursor-default">⭐</div>
        <div class="text-3xl opacity-20 hover:opacity-50 transition-opacity cursor-default" style="animation-delay: 0.5s;">💝</div>
        <div class="text-2xl opacity-15 hover:opacity-40 transition-opacity cursor-default" style="animation-delay: 1s;">✨</div>
      </div>
    </div>

    <!-- Barra inferior con info de contacto -->
    <div class="mt-6 md:mt-8 pt-4 md:pt-6 border-t border-white/20">
      <div class="flex flex-wrap justify-center items-center gap-4 md:gap-6 text-white/80 text-xs md:text-sm">
        <a href={siteConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Contáctanos
        </a>
        <span class="hidden md:inline text-white/40">|</span>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {siteConfig.schedule.weekdays}
        </span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes fadeIn { 
    from { opacity: 0; } 
    to { opacity: 1; } 
  }
  @keyframes slideIn { 
    from { transform: scale(0.95) translateY(20px); opacity: 0; } 
    to { transform: scale(1) translateY(0); opacity: 1; } 
  }
  @keyframes fadeOut { 
    from { opacity: 1; } 
    to { opacity: 0; } 
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .animate-fadeIn { animation: fadeIn 0.3s ease-out forwards; }
  .animate-slideIn { animation: slideIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
  .animate-fadeOut { animation: fadeOut 0.3s ease-in forwards; }
  .animate-float { animation: float 3s ease-in-out infinite; }
</style>

<script is:inline>
  // Renderiza íconos de Lucide si no se hace automáticamente
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }

  const modal = document.getElementById('myModal');
  const closeBtn = document.getElementById('closeBtn');
  const closeX = document.getElementById('closeModal');

  if (modal && closeBtn && closeX) {
    const closeModal = () => {
      modal.classList.add('animate-fadeOut');
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }, 300);
    };

    // Muestra el modal en cada recarga de la página
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    closeBtn.focus();

    // Cierre automático en 8 segundos (dar más tiempo para ver el diseño mejorado)
    const autoCloseTimeout = setTimeout(() => {
      closeModal();
    }, 8000);

    // Agrega event listeners para cerrar el modal
    const handleClose = () => {
      clearTimeout(autoCloseTimeout); // Cancela el cierre automático si el usuario cierra manualmente
      closeModal();
    };

    closeBtn.addEventListener('click', handleClose);
    closeX.addEventListener('click', handleClose);

    // Cierra con Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        handleClose();
      }
    });
    
    // Cerrar al hacer clic fuera del modal
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        handleClose();
      }
    });
  }
</script>
