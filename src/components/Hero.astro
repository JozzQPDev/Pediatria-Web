---
// Importaciones necesarias
import { siteConfig } from "../data/siteConfig";

interface Props {
  title: string;
  subtitle: string;
  backgroundImage?: string; // Prop opcional para imagen de fondo sutil
  sideImage?: string; // Prop opcional para imagen al costado
  showButtons?: boolean; // Prop opcional para botones
  ctaText?: string; // Prop opcional para texto personalizado del CTA principal
  secondaryCtaText?: string; // Prop opcional para texto del CTA secundario
}

const { 
  title, 
  subtitle, 
  backgroundImage, 
  sideImage, 
  showButtons = false, 
  ctaText = "RESERVAR CITA", 
  secondaryCtaText = "Ver Especialidades" 
} = Astro.props;

const words = title.split(' ');
const lastWord = words.pop();
const mainTitle = words.join(' ');
---

<section 
  class={`relative overflow-hidden py-20 lg:py-28 bg-linear-to-br from-teal-50 via-white to-teal-50/30 border-b border-gray-100 transition-all duration-700 ${
    backgroundImage ? 'bg-cover bg-center bg-fixed' : ''
  }`}
  style={backgroundImage ? `background-image: url(${backgroundImage});` : ''}
  role="banner"
  aria-labelledby="hero-title"
>
  <!-- Overlay sutil para fondo si hay imagen -->
  {backgroundImage && <div class="absolute inset-0 bg-white/80 backdrop-blur-sm z-0"></div>}
  
  <!-- Elementos decorativos sutiles mejorados -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-24 -right-12 w-96 h-96 bg-green-100/40 rounded-full blur-3xl animate-pulse-soft"></div>
    <div class="absolute -bottom-24 -left-12 w-80 h-80 bg-blue-100/30 rounded-full blur-3xl animate-pulse-soft delay-1000"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle, #10b981 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class={`grid lg:items-center gap-16 ${sideImage ? 'lg:grid-cols-2' : 'max-w-5xl mx-auto text-center'}`}>
      
      <div class="animate-fade-in-up space-y-6">
        <h1 id="hero-title" class="font-bold text-gray-900 leading-[1.05] mb-6 tracking-tight italic text-4xl md:text-5xl lg:text-6xl">
          {mainTitle} <span class="text-rose-400 not-italic inline-block hover:scale-110 hover:text-amber-300 transition-all duration-300 ease-out">{lastWord}</span>
        </h1>

        <p class="text-gray-600 mb-8 leading-relaxed font-medium text-balance text-lg md:text-xl max-w-2xl">
          {subtitle}
        </p>

        {showButtons && (
          <div class="flex flex-col sm:flex-row gap-4 items-center justify-center lg:justify-start">
            <a 
              href={siteConfig.contact.whatsappUrl} 
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto flex items-center justify-center gap-3 px-8 py-4 bg-linear-to-r from-teal-200 to-purple-200 text-gray-800 font-bold rounded-2xl hover:from-teal-300 hover:to-purple-300 hover:-translate-y-1 hover:scale-105 hover:shadow-xl transition-all duration-300 shadow-lg shadow-teal-200 active:scale-95 text-base group focus:outline-none focus:ring-4 focus:ring-teal-300" 
              aria-label={`Reservar cita por WhatsApp - ${ctaText}`}
            >
              <i class="bi bi-whatsapp text-lg"></i>
              {ctaText}
              <i data-lucide="arrow-right" class="w-5 h-5 group-hover:translate-x-1 transition-transform duration-200"></i>
            </a>
            
            <a 
              href="/servicios" 
              class="w-full sm:w-auto flex items-center justify-center gap-3 px-8 py-4 bg-white text-gray-700 font-bold rounded-2xl border-2 border-gray-200 hover:border-teal-300 hover:bg-teal-50 hover:scale-105 hover:shadow-lg transition-all duration-300 text-base shadow-sm focus:outline-none focus:ring-4 focus:ring-teal-200" 
              aria-label={`Ver especialidades - ${secondaryCtaText}`}
            >
              {secondaryCtaText}
            </a>
          </div>
        )}
      </div>

      {sideImage && (
        <div class="relative animate-fade-in-right">
          <div class="relative z-10 rounded-3xl overflow-hidden shadow-2xl rotate-2 hover:rotate-0 transition-transform duration-700 border-4 border-white group">
            <img 
              src={sideImage} 
              alt="Imagen representativa de nuestros servicios médicos" 
              class="w-full h-80 md:h-96 lg:h-112 object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              decoding="async"
            />
            <!-- Overlay on hover para mejor interacción -->
            <div class="absolute inset-0 bg-linear-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            
            <!-- Iconos decorativos movidos dentro del contenedor de la imagen para asegurar que estén encima -->
            <div class="absolute top-10 right-10 z-20 animate-bounce-soft">
              <i data-lucide="heart" class="w-8 h-8 text-rose-300 drop-shadow-lg"></i>
            </div>
            <div class="absolute bottom-10 left-10 z-20 animate-bounce-soft delay-500">
              <i data-lucide="star" class="w-6 h-6 text-sky-300 drop-shadow-lg"></i>
            </div>
          </div>

          <!-- Elementos decorativos mejorados -->
          <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-teal-400 rounded-3xl -z-10 opacity-25 blur-xl animate-pulse-soft"></div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes fade-in-right {
    from { opacity: 0; transform: translateX(30px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes bounce-soft {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-5px); }
    60% { transform: translateY(-2px); }
  }

  @keyframes pulse-soft {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.8; transform: scale(1.05); }
  }

  .animate-fade-in-up {
    animation: fade-in-up 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .animate-fade-in-right {
    animation: fade-in-right 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .animate-bounce-soft {
    animation: bounce-soft 2.5s infinite;
  }

  .animate-pulse-soft {
    animation: pulse-soft 5s infinite;
  }

  .delay-1000 {
    animation-delay: 1s;
  }

  .delay-500 {
    animation-delay: 0.5s;
  }

  /* Mejoras para alto contraste y accesibilidad */
  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in-up,
    .animate-fade-in-right,
    .animate-bounce-soft,
    .animate-pulse-soft {
      animation: none;
    }
    .transition-all,
    .transition-transform,
    .transition-opacity {
      transition: none;
    }
  }

  /* Mejoras para impresión */
  @media print {
    .animate-fade-in-up,
    .animate-fade-in-right,
    .animate-bounce-soft,
    .animate-pulse-soft {
      animation: none;
    }
    .hover\:scale-105,
    .hover\:scale-110,
    .hover\:-translate-y-1 {
      transform: none;
    }
  }
</style>
