---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import { blogPosts, getAllCategories, getAllTags } from "../data/blogPosts";

const categories = getAllCategories();
const tags = getAllTags();
const recentPosts = blogPosts.slice(0, 3);
---

<Layout 
  title="Blog | Consejos y Artículos de Salud Infantil"
  description="Descubre artículos informativos sobre salud infantil, desarrollo, nutrición y cuidados para tus hijos."
>
  <Hero
    title="Blog de Salud Infantil"
    subtitle="Artículos informativos, consejos prácticos y las últimas novedades en cuidado pediátrico para tu familia."
    backgroundImage="/img/hero-nosotros.jpg"
    sideImage="/img/hero-nosotros.jpg"
  />
 <main class="main-section">
    <span class="cloud cloud--1" aria-hidden="true"></span>
    <span class="cloud cloud--2" aria-hidden="true"></span>
    <span class="cloud cloud--3" aria-hidden="true"></span>
    <span class="cloud cloud--4" aria-hidden="true"></span>
    <span class="cloud cloud--5" aria-hidden="true"></span>
    <span class="cloud cloud--6" aria-hidden="true"></span>
    <span class="cloud cloud--7" aria-hidden="true"></span>
    <span class="cloud cloud--8" aria-hidden="true"></span>
    <span class="cloud cloud--9" aria-hidden="true"></span>
    <span class="cloud cloud--10" aria-hidden="true"></span>
    <span class="cloud cloud--11" aria-hidden="true"></span>
    <span class="cloud cloud--12" aria-hidden="true"></span>
  <!-- Featured Post Section - Solo se muestra cuando no hay filtro -->
  <section id="featured-section" class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12 reveal">
        <span class="inline-block text-pink-400 font-bold uppercase tracking-[0.3em] text-[11px] bg-pink-50 px-4 py-2 rounded-lg mb-4 animate-bounce-soft">
          Artículo Destacado
        </span>
      </div>
      
      {recentPosts.length > 0 && (
        <div class="grid lg:grid-cols-2 gap-12 items-center reveal ">
          <div class="relative overflow-hidden rounded-3xl  group">
            <img 
              src={recentPosts[0].image} 
              alt={recentPosts[0].title}
              class="w-full h-80 lg:h-96 object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute top-4 left-4">
              <span class="bg-white/90 backdrop-blur-sm text-pink-400 px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider">
                {recentPosts[0].category}
              </span>
            </div>
          </div>
          
          <div class="space-y-6">
            <div class="flex items-center gap-4 text-sm text-gray-500">
              <span class="flex items-center gap-2">
                <i data-lucide="calendar" class="w-4 h-4"></i>
                {new Date(recentPosts[0].date).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
              </span>
              <span class="flex items-center gap-2">
                <i data-lucide="clock" class="w-4 h-4"></i>
                {recentPosts[0].readTime} de lectura
              </span>
            </div>
            
            <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 leading-tight">
              {recentPosts[0].title}
            </h2>
            
            <p class="text-lg text-gray-600 leading-relaxed">
              {recentPosts[0].excerpt}
            </p>
            
            <div class="flex items-center gap-4">
              <img 
                src={recentPosts[0].authorImage} 
                alt={recentPosts[0].author}
                class="w-12 h-12 rounded-full object-cover"
              />
              <div>
                <p class="font-bold text-gray-900">{recentPosts[0].author}</p>
                <p class="text-sm text-gray-500">Especialista Médico</p>
              </div>
            </div>
            
            <a 
              href={`/blog/${recentPosts[0].slug}`}
              class="inline-flex items-center gap-3 bg-pink-300 text-white px-8 py-4 rounded-2xl font-bold hover:bg-pink-400 hover:scale-105 transition-all shadow-lg group"
            >
              Leer Artículo
              <i data-lucide="arrow-right" class="w-5 h-5 group-hover:translate-x-1 transition-transform"></i>
            </a>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Categories Filter - Sin refresh de página -->
  <section class="py-8 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex flex-wrap items-center justify-center gap-4 reveal">
        <span class="text-gray-600 font-medium">Filtrar por categoría:</span>
        <button 
          class="filter-btn px-4 py-2 bg-pink-300 text-white rounded-full text-sm font-bold hover:bg-pink-400 transition-colors"
          data-category="all"
        >
          Todos
        </button>
        {categories.map(category => (
          <button 
            class="filter-btn px-4 py-2 bg-white text-gray-600 border border-gray-200 rounded-full text-sm font-medium hover:bg-pink-50 hover:text-pink-400 hover:border-pink-200 transition-all"
            data-category={category}
          >
            {category}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Blog Grid -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12 reveal">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          Todos los Artículos
        </h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Explora nuestra colección de artículos escritos por nuestros especialistas médicos.
        </p>
      </div>

      <div id="blog-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {blogPosts.map((post, index) => (
          <article 
            class="blog-post group bg-white rounded-3xl shadow-lg hover:shadow-2xl transition-all duration-500 overflow-hidden reveal hover-lift card-shine" 
            data-category={post.category}
            style={`animation-delay: ${(index % 6) * 0.1}s`}
          >
            <div class="relative overflow-hidden h-56">
              <img 
                src={post.image} 
                alt={post.title}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
              />
              <div class="absolute top-4 left-4">
                <span class="bg-white/90 backdrop-blur-sm text-pink-400 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">
                  {post.category}
                </span>
              </div>
            </div>
            
            <div class="p-6">
              <div class="flex items-center gap-3 text-xs text-gray-500 mb-3">
                <span class="flex items-center gap-1">
                  <i data-lucide="calendar" class="w-3 h-3"></i>
                  {new Date(post.date).toLocaleDateString('es-ES', { month: 'short', day: 'numeric' })}
                </span>
                <span class="flex items-center gap-1">
                  <i data-lucide="clock" class="w-3 h-3"></i>
                  {post.readTime}
                </span>
              </div>
              
              <h3 class="text-xl font-bold text-gray-900 mb-3 line-clamp-2 group-hover:text-pink-400 transition-colors">
                {post.title}
              </h3>
              
              <p class="text-gray-600 text-sm leading-relaxed mb-4 line-clamp-3">
                {post.excerpt}
              </p>
              
              <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                <div class="flex items-center gap-2">
                  <img 
                    src={post.authorImage} 
                    alt={post.author}
                    class="w-8 h-8 rounded-full object-cover"
                  />
                  <span class="text-sm font-medium text-gray-700">{post.author}</span>
                </div>
                
                <a 
                  href={`/blog/${post.slug}`}
                  class="text-pink-400 font-bold text-sm hover:text-pink-500 transition-colors flex items-center gap-1 group/link"
                >
                  Leer más
                  <i data-lucide="arrow-right" class="w-4 h-4 group-hover/link:translate-x-1 transition-transform"></i>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- No results message -->
      <div id="no-results" class="hidden text-center py-12">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-gray-100 rounded-full mb-6">
          <i data-lucide="search" class="w-10 h-10 text-gray-400"></i>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">No se encontraron artículos</h3>
        <p class="text-gray-600 mb-6">No hay artículos en esta categoría todavía.</p>
        <button id="show-all-btn" class="inline-flex items-center gap-2 text-pink-400 font-bold hover:text-pink-500">
          <i data-lucide="arrow-left" class="w-4 h-4"></i>
          Ver todos los artículos
        </button>
      </div>
    </div>
  </section>

  <!-- Newsletter Section -->
  <section class="py-16 bg-linear-to-br from-pink-300 to-purple-400 text-white">

    <div class="max-w-4xl mx-auto px-4 text-center reveal">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-white/20 rounded-2xl mb-6 animate-float">
        <i data-lucide="mail" class="w-8 h-8"></i>
      </div>
      
      <h2 class="text-3xl lg:text-4xl font-bold mb-4">
        Suscríbete a Nuestro Newsletter
      </h2>
      
      <p class="text-white/90 text-lg mb-8 max-w-2xl mx-auto">
        Recibe los mejores consejos de salud infantil directamente en tu correo electrónico.
      </p>
      
      <form class="flex flex-col sm:flex-row gap-4 max-w-lg mx-auto" onsubmit="event.preventDefault(); alert('¡Gracias por suscribirte!');">
<input 
  type="email"
  placeholder="Tu correo electrónico"
  required
  class="flex-1 px-6 py-4 rounded-2xl text-white placeholder-white/70
         border border-white/30 bg-white/10
         outline-none! ring-0! shadow-none!
         focus:outline-none! focus:ring-0! focus:shadow-none! focus:border-white/80 focus:bg-white/20
         transition-all duration-200"
/>



        <button 
          type="submit"
          class="px-8 py-4 bg-white text-pink-400 font-bold rounded-2xl hover:bg-gray-100 hover:scale-105 transition-all shadow-lg"
        >
          Suscribirme
        </button>
      </form>
    </div>
  </section>

  <!-- Tags Cloud -->
  <section class="py-12 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-8 reveal">
        <h3 class="text-xl font-bold text-gray-900 mb-2">Temas Populares</h3>
        <p class="text-gray-600">Explora artículos por tema</p>
      </div>
      
      <div class="flex flex-wrap justify-center gap-3 reveal">
        {tags.map(tag => (
          <button 
            class="tag-btn px-4 py-2 bg-white text-gray-600 rounded-full text-sm font-medium hover:bg-pink-300 hover:text-white transition-all shadow-sm hover:shadow-md"
            data-tag={tag}
          >
            #{tag}
          </button>
        ))}
      </div>
    </div>
  </section>
 </main>
</Layout>

<script>
  // Intersection Observer for scroll-triggered animations
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.1
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('active');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  // Observe all elements with reveal classes
  document.addEventListener('DOMContentLoaded', () => {
    const revealElements = document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale');
    revealElements.forEach(el => observer.observe(el));

    // Initialize filter functionality
    initFilter();
  });

  function initFilter() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const tagBtns = document.querySelectorAll('.tag-btn');
    const blogPosts = document.querySelectorAll('.blog-post');
    const featuredSection = document.getElementById('featured-section');
    const noResults = document.getElementById('no-results');
    const blogGrid = document.getElementById('blog-grid');
    const showAllBtn = document.getElementById('show-all-btn');
    
    let currentFilter = 'all';

    // Filter button click handlers
    filterBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const category = btn.getAttribute('data-category');
        currentFilter = category || 'all';
        
        // Update active state
        filterBtns.forEach(b => {
          b.classList.remove('bg-pink-300', 'text-white', 'hover:bg-pink-400');
          b.classList.add('bg-white', 'text-gray-600', 'border-gray-200', 'hover:bg-pink-50', 'hover:text-pink-400', 'hover:border-pink-200');
        });
        btn.classList.remove('bg-white', 'text-gray-600', 'border-gray-200', 'hover:bg-pink-50', 'hover:text-pink-400', 'hover:border-pink-200');
        btn.classList.add('bg-pink-300', 'text-white', 'hover:bg-pink-400');

        // Filter posts
        filterPosts(category || 'all');
      });
    });

    // Tag button click handlers
    tagBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const tag = btn.getAttribute('data-tag');
        
        // Update active state
        tagBtns.forEach(b => {
          b.classList.remove('bg-pink-300', 'text-white');
          b.classList.add('bg-white', 'text-gray-600');
        });
        btn.classList.remove('bg-white', 'text-gray-600');
        btn.classList.add('bg-pink-300', 'text-white');

        // Filter by tag
        filterByTag(tag || '');
      });
    });

    // Show all button
    if (showAllBtn) {
      showAllBtn.addEventListener('click', (e) => {
        e.preventDefault();
        currentFilter = 'all';
        
        // Reset filter buttons
        filterBtns.forEach(b => {
          const cat = b.getAttribute('data-category');
          if (cat === 'all') {
            b.classList.remove('bg-white', 'text-gray-600', 'border-gray-200', 'hover:bg-pink-50', 'hover:text-pink-400', 'hover:border-pink-200');
            b.classList.add('bg-pink-300', 'text-white', 'hover:bg-pink-400');
          } else {
            b.classList.remove('bg-pink-300', 'text-white', 'hover:bg-pink-400');
            b.classList.add('bg-white', 'text-gray-600', 'border-gray-200', 'hover:bg-pink-50', 'hover:text-pink-400', 'hover:border-pink-200');
          }
        });

        // Reset tag buttons
        tagBtns.forEach(b => {
          b.classList.remove('bg-pink-300', 'text-white');
          b.classList.add('bg-white', 'text-gray-600');
        });

        // Show all posts
        filterPosts('all');
      });
    }

    function filterPosts(category: string) {
      let visibleCount = 0;
      
      blogPosts.forEach((post) => {
        const postCategory = post.getAttribute('data-category');
        
        if (category === 'all' || postCategory === category) {
          (post as HTMLElement).style.display = 'block';
          visibleCount++;
          // Re-apply reveal animation
          post.classList.remove('active');
          observer.observe(post);
        } else {
          (post as HTMLElement).style.display = 'none';
        }
      });

      // Show/hide featured section
      if (featuredSection) {
        featuredSection.style.display = category === 'all' ? 'block' : 'none';
      }

      // Show/hide no results
      if (noResults && blogGrid) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
          blogGrid.classList.add('hidden');
        } else {
          noResults.classList.add('hidden');
          blogGrid.classList.remove('hidden');
        }
      }
    }

    function filterByTag(tag: string) {
      let visibleCount = 0;
      
      blogPosts.forEach((post) => {
        const postElement = post as HTMLElement;
        // Get the title and excerpt to check for tag
        const title = postElement.querySelector('h3')?.textContent?.toLowerCase() || '';
        const excerpt = postElement.querySelector('p')?.textContent?.toLowerCase() || '';
        
        if (tag === '' || title.includes(tag.toLowerCase()) || excerpt.includes(tag.toLowerCase())) {
          postElement.style.display = 'block';
          visibleCount++;
          post.classList.remove('active');
          observer.observe(post);
        } else {
          postElement.style.display = 'none';
        }
      });

      // Hide featured section when filtering by tag
      if (featuredSection) {
        featuredSection.style.display = 'none';
      }

      // Show/hide no results
      if (noResults && blogGrid) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
          blogGrid.classList.add('hidden');
        } else {
          noResults.classList.add('hidden');
          blogGrid.classList.remove('hidden');
        }
      }
    }
  }
</script>

<style>
  @keyframes bounce-soft {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-5px); }
    60% { transform: translateY(-2px); }
  }
  .animate-bounce-soft {
    animation: bounce-soft 2s infinite;
  }
</style>
